#!/usr/bin/env bash
# Refuses every push to main. GitHub Free cannot protect a branch of a private repository, so
# this hook and the pipeline's needs: are the gate (roadmap.md, "How we work"). Then the content
# firewall scans what each pushed ref publishes: its commits' diffs, messages, paths and
# identities, the ref's own name, and an annotated tag's message and tagger (security.md,
# "Local parity").
#
# Enabled once per clone:  git config core.hooksPath .githooks
set -euo pipefail
root="$(git rev-parse --show-toplevel)"

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = refs/heads/main ]; then
    echo "pre-push: pushes to main are refused. Push a branch and open a pull request." >&2
    exit 1
  fi
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac # a deletion: nothing to scan
  case "$remote_sha" in
    *[!0]*) base="$remote_sha" ;;
    *) base="$(git merge-base "$local_sha" refs/remotes/origin/main 2>/dev/null || true)" ;; # a new ref
  esac
  if [ -z "$base" ]; then
    echo "pre-push: cannot tell where $local_ref starts. Run git fetch origin, then push again." >&2
    exit 2
  fi
  s=0
  "$root/scripts/firewall/check.sh" --range "$base" "$local_sha" "$remote_ref" </dev/null || s=$?
  [ "$s" -le "$status" ] || status=$s
done

if [ "$status" -ne 0 ]; then
  echo "pre-push: push refused (exit $status: 1 is a finding, 2 is cannot prove clean)" >&2
fi
exit "$status"
