{
  "name": "ihaveasegway-website",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.6",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "e2e": "pnpm --filter web e2e",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "firewall:test": "scripts/firewall/test.sh",
    "postinstall": "sh scripts/check-hooks.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "catalog:",
    "typescript-eslint": "^8.72.0"
  }
}
