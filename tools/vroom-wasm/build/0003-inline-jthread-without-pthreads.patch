diff -ruN a/src/utils/thread_compat.h b/src/utils/thread_compat.h
--- a/src/utils/thread_compat.h
+++ b/src/utils/thread_compat.h
@@ -0,0 +1,59 @@
+#ifndef THREAD_COMPAT_H
+#define THREAD_COMPAT_H
+
+/*
+
+Not part of upstream VROOM: added for the single-threaded
+WebAssembly build.
+
+An Emscripten build without -pthread has no threads: pthread_create
+returns EAGAIN, so constructing a std::jthread throws
+std::system_error. VROOM starts one std::jthread per search, per
+matrix profile and per TSP look-up range, even when nb_threads is 1.
+
+In that build only, compat::jthread runs the callable to completion
+inside its constructor, on the calling thread, in spawn order, and
+join() does nothing. The arguments are decay-copied first, as
+std::thread does. Every other build gets std::jthread unchanged.
+
+*/
+
+#include <thread>
+
+#if defined(__EMSCRIPTEN__) && !defined(__EMSCRIPTEN_PTHREADS__)
+#include <functional>
+#include <type_traits>
+#include <utility>
+#endif
+
+namespace vroom::compat {
+
+#if defined(__EMSCRIPTEN__) && !defined(__EMSCRIPTEN_PTHREADS__)
+class jthread {
+public:
+  template <class F, class... Args>
+  explicit jthread(F&& f, Args&&... args) {
+    std::invoke(std::decay_t<F>(std::forward<F>(f)),
+                std::decay_t<Args>(std::forward<Args>(args))...);
+  }
+
+  jthread(jthread&&) noexcept = default;
+  jthread& operator=(jthread&&) noexcept = default;
+  jthread(const jthread&) = delete;
+  jthread& operator=(const jthread&) = delete;
+  ~jthread() = default;
+
+  [[nodiscard]] bool joinable() const noexcept {
+    return false;
+  }
+
+  void join() noexcept {
+  }
+};
+#else
+using jthread = std::jthread;
+#endif
+
+} // namespace vroom::compat
+
+#endif
