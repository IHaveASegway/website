+// Iterator type for the std::array<Index, 1> instantiations below.
+// Under libc++ ABI v2 (used by Emscripten), std::array<Index,
+// 1>::const_iterator is the same type as
+// std::vector<Index>::const_iterator, which is also instantiated, and
+// a duplicate explicit instantiation is ill-formed. In that case a
+// plain pointer stands in: valid, distinct and never called.
+using ArrayJobIterator =
+  std::conditional_t<std::is_same_v<std::array<Index, 1>::const_iterator,
+                                    std::vector<Index>::const_iterator>,
+                     const Index*,
+                     std::array<Index, 1>::const_iterator>;
+
