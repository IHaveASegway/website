# Dependencies and build output, including the test-only fixture builds (apps/web/scripts/build-fixtures.mjs)
node_modules/
dist/
dist-preview/
.fixtures/
.astro/
.wrangler/

# The solver's build output (tools/vroom-wasm/build/build.sh). The one committed copy is the
# site's, apps/web/public/lab/routes/solver/, which tools/vroom-wasm/install.mjs writes (ADR 0016)
tools/vroom-wasm/vroom.mjs
tools/vroom-wasm/vroom.wasm

# Test output
playwright-report/
playwright-report-writing/
test-results/
test-results-writing/
blob-report/
coverage/

# Local configuration and secrets: never committed (security.md, "Secrets inventory")
.env
.env.*
.dev.vars
*.local

# Firewall rules live outside the repository, but refuse a stray copy too (ADR 0007)
firewall.toml

# Editors and operating systems
.DS_Store
*.log
.vscode/*
!.vscode/extensions.json
.idea/
