{
  // Astro's base supplies what .astro files need; the repository's base supplies the strictness.
  "extends": ["astro/tsconfigs/base", "../../tsconfig.base.json"],
  "compilerOptions": {
    "types": ["node"]
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": [
    "dist",
    "dist-preview",
    ".fixtures",
    "node_modules",
    "playwright-report",
    "playwright-report-writing",
    "test-results",
    "test-results-writing"
  ]
}
