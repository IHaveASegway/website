      "bytes": 140292,
      "provenance": "B612 Mono Regular 1.008, by Intactile DESIGN for Airbus, OFL 1.1, no Reserved Font Name. A static instance: code only. google/fonts at commit 0b58fb37, git blob 32bbdeee."
    },
    "b612-mono-ofl": {
