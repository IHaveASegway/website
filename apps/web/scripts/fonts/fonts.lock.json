{
  "about": "What scripts/fonts/build.sh reads and writes. Sources are pinned by URL, sha256 and size: the shipped fonts and their licenses, and fonts measured only to fit the fallback faces. Outputs are recorded by build.sh --write, and test/fonts.test.ts fails when a committed file differs from its line here.",
  "sources": {
    "archivo-ttf": {
      "url": "https://raw.githubusercontent.com/google/fonts/0b58fb370093f9a9f4ff785d94405710b79de67c/ofl/archivo/Archivo%5Bwdth%2Cwght%5D.ttf",
      "sha256": "0e094a7d3c7c4c25cf1310c4b30014f1dae9332220b1c2c88f4fa996f0b05053",
      "bytes": 658596,
      "provenance": "Archivo 2.001, by Omnibus-Type (Héctor Gatti and team), OFL 1.1, no Reserved Font Name. The variable font, widths 62 to 125 and weights 100 to 900: cut.py instances four static faces from it, Expanded SemiBold, Expanded Medium, Condensed SemiBold, Regular and SemiBold (ADR 0029). google/fonts at commit 0b58fb37."
    },
    "archivo-ofl": {
      "url": "https://raw.githubusercontent.com/google/fonts/0b58fb370093f9a9f4ff785d94405710b79de67c/ofl/archivo/OFL.txt",
