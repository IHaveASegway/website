---
import PostList from '../../components/PostList.astro';
import WorkCard from '../../components/WorkCard.astro';
import Base from '../../layouts/Base.astro';
import { ABOUT_PATH, aboutParts, LAB_NAMES, withLinks } from '../../lib/about';
import {
  loadAbout,
  loadLabArea,
  loadProfile,
  loadSelectedWork,
  loadWritingArea,
} from '../../lib/content';
import { profilePageGraph, serialize } from '../../lib/jsonld';
import { labPath } from '../../lib/lab';
import { labelOf, navAll } from '../../lib/nav';
import { aboutCard } from '../../lib/og';
import { areaRoutes, SECTION_LABELS } from '../../lib/posts';
import { checkedProfiles, locationLine } from '../../lib/profile';
import { addressText, evidencePages, roleYears, shownSkills } from '../../lib/resume';
import { CONTACT_EMAIL, ORIGIN } from '../../lib/site';
import { writingRow } from '../../lib/work';
import '../../styles/about.css';

// /about/ (ADR 0029): who Joseph is, what he has worked with and how to reach him, one column on
// every screen, since 2026-10-28 in /resume/'s place (public/_redirects). The head is the name, the
// role and the addresses; then the bio, his background and his skills. On screen the labs and the
// writing stay on Home and their indexes, and on paper they print, since a sheet has no links.
//
// The bio is src/content/about.md, his words, laid out here and never changed: its opening, then
// each of its sections under its own heading, and the labs it names linked where they stand, as
// Home links them. Everything after it is generated from profile.json and from what this
// build already renders; nothing is copied from a résumé file, which names the employer and is
// never committed. A section renders only when its source exists (lib/resume.ts): the bio where its
// entry is (the fixture builds hold none), the roles once Joseph adds them (Q8), a skill once every
// page it names is built, and Selected work and Writing as Home has them. On paper it is one US
// Letter page (about.css, "The résumé on paper"; e2e/about-print.spec.ts), and the Print button
// saves it as a PDF in the visitor's own browser: the site hosts no PDF (content.md, Q9).
const profile = await loadProfile();
const { name, label } = profile.basics;
const bioEntry = await loadAbout();
const bio = bioEntry?.body === undefined ? undefined : aboutParts(bioEntry.body);
const area = await loadWritingArea();
const lab = await loadLabArea();
const cards = await loadSelectedWork();
const latest = writingRow(area.published, cards);
// A card that opens a lab draws in that lab's line (ADR 0025): found by the page it opens, so the
// colour cannot drift from the page's own. The card's edge stays the page's (ADR 0027).
const lines = new Map(lab.entries.map((entry) => [labPath(entry), entry.slug]));
// The labs the bio names, linked at their first mention, once the build writes their pages.
const demo = new Map(lab.entries.map((entry) => [entry.slug, entry]));
const names = LAB_NAMES.flatMap(({ slug, name: words }) => {
  const entry = demo.get(slug);
  return entry ? [{ name: words, href: labPath(entry) }] : [];
});
const profiles = checkedProfiles(profile);
const linkedIn = profiles.find((p) => p.network === 'LinkedIn');
// The pages a skill may name: Selected work's, the listed posts, and the other pages this build
// writes, the manifest's and the section indexes, each by its own title.
const pages = [
  ...navAll(areaRoutes(area)),
  ...area.sections.map((s) => ({ href: `/${s}/`, label: SECTION_LABELS[s] })),
];
const skills = shownSkills(profile.skills, evidencePages(cards, area.published, pages));
const title = labelOf('about');
// The address may break after its "@" when a larger text size leaves it no room on one line, as
// the footer's does, and inside a part only when that part alone is wider than the screen.
const [mailbox, domain] = CONTACT_EMAIL.split('@');
---

<Base
  title={`${title} · ${name}`}
  description={`${name}, senior software engineer: what he builds, how he works and his skills. ${locationLine(profile)}.`}
  path={ABOUT_PATH}
  og={aboutCard(profile, title)}
  jsonLd={serialize(profilePageGraph(profile, ABOUT_PATH))}
  print
>
  <article class="resume" aria-labelledby="name">
    <header class="about-head">
      <div class="about-who">
        <h1 id="name" class="about-name">
          {name}
        </h1>
        <p class="about-role">{label}</p>
        <p class="about-where">{locationLine(profile)}</p>
      </div>
      <dl class="kv resume-contact">
        <dt>Email</dt>
        <dd>
          <a href={`mailto:${CONTACT_EMAIL}`}>
            {mailbox}@<wbr />
            {domain}
          </a>
        </dd>
        <dt>Web</dt>
        <dd>
          <a href="/">{addressText(ORIGIN)}</a>
        </dd>
        {profiles.map((p) => (
          <>
            <dt>{p.network}</dt>
            <dd>
              <a href={p.url}>{addressText(p.url)}</a>
            </dd>
          </>
        ))}
      </dl>
      {/* Pressed by the command menu's Print row too; src/scripts/palette.js binds it and shows
          it, so without the script it is not there, and on paper it never is. */}
      <button class="btn print-item" type="button" data-print>
        Print or save as PDF
      </button>
    </header>

    <div class="about-body">
      {bio && (
        <section class="bio" id="now" aria-label="About me">
          {bio.lede.length > 0 && (
            <div class="bio-block bio-now">
              {bio.lede.map((paragraph) => (
                <p class="bio-lede">{paragraph}</p>
              ))}
            </div>
          )}
          {bio.sections.map((section) => (
            <div class="bio-block">
              <h2 class="block-label">{section.heading}</h2>
              {section.principles.length > 0 && (
                <ul class="bio-items" role="list">
                  {section.principles.map((principle) => (
                    <li>
                      <h3 class="bio-item-lead">{principle.lead}</h3>
                      <p class="bio-item-text">
                        {withLinks(principle.text, names).map((run) =>
                          typeof run === 'string' ? run : <a href={run.href}>{run.text}</a>,
                        )}
                      </p>
                    </li>
                  ))}
                </ul>
              )}
              {section.paragraphs.map((paragraph) => (
                <p class="bio-text">
                  {withLinks(paragraph, names).map((run) =>
                    typeof run === 'string' ? run : <a href={run.href}>{run.text}</a>,
                  )}
                </p>
              ))}
            </div>
          ))}
        </section>
      )}

      {/* The offer of the full résumé is the screen's: on paper the page is the résumé, and a sheet
          that tells its reader to ask for the résumé sends them round in a circle. So the offer
          never prints, and on paper the section holds the roles and where the history is, and is
          left off the sheet when it has neither (content.md, Q8). */}
      <section
        class:list={['about-section', { 'screen-only': profile.work.length === 0 && !linkedIn }]}
        id="experience"
        aria-labelledby="experience-title"
      >
        <h2 id="experience-title" class="block-label">
          Background
        </h2>
        {profile.work.length > 0 && (
          <ol class="roles" role="list">
            {profile.work.map((role) => (
              <li>
                <p class="role-years">{roleYears(role)}</p>
                <h3 class="role-title">{role.position}</h3>
              </li>
            ))}
          </ol>
        )}
        <div class="resume-notes">
          {profile.basics.summary && <p>{profile.basics.summary}</p>}
          {linkedIn && (
            <p>
              My full work history is on <a href={linkedIn.url}>LinkedIn</a>.
            </p>
          )}
          <p class="screen-only">
            I'll send a résumé if you email me:{' '}
            <span class="resume-email">
              <a href={`mailto:${CONTACT_EMAIL}`}>
                {mailbox}@<wbr />
                {domain}
              </a>
              .
            </span>
          </p>
        </div>
      </section>

      {skills.length > 0 && (
        <section class="about-section" id="skills" aria-labelledby="skills-title">
          <h2 id="skills-title" class="block-label">
            Skills
          </h2>
          {profile.tools && <p class="skills-tools">{profile.tools}</p>}
          <p class="skills-note">What you can see working here:</p>
          <dl class="skills">
            {skills.map((skill) => (
              <div>
                <dt>{skill.name}</dt>
                <dd>
                  {skill.evidence.map((page, i) => (
                    <>
                      {i > 0 && ', '}
                      <a href={page.href}>{page.title}</a>
                    </>
                  ))}
                </dd>
              </div>
            ))}
          </dl>
        </section>
      )}

      {cards.length > 0 && (
        <section class="about-section print-only" id="work" aria-labelledby="work-title">
          <h2 id="work-title" class="block-label">
            Selected work
          </h2>
          <div class="cards">
            {cards.map((card) => (
              <WorkCard
                title={card.title}
                text={card.text}
                facts={card.facts}
                link={card.link}
                line={lines.get(card.link.href)}
              />
            ))}
          </div>
        </section>
      )}

      {latest.length > 0 && (
        <section class="about-section print-only" id="writing" aria-labelledby="writing-title">
          <h2 id="writing-title" class="block-label">
            Writing
          </h2>
          <PostList posts={latest} level={3} />
          <ul class="post-links">
            <li>
              <a href="/writing/">All writing</a>
            </li>
          </ul>
        </section>
      )}
    </div>
  </article>
</Base>
