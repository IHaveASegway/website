---
import Contact from '../../components/home/Contact.astro';
import LabLine from '../../components/LabLine.astro';
import PostList from '../../components/PostList.astro';
import WorkCard from '../../components/WorkCard.astro';
import Base from '../../layouts/Base.astro';
import { ABOUT_HEADINGS, ABOUT_PATH, aboutParts, sectionOf, withLinks } from '../../lib/about';
import {
  loadAbout,
  loadLabArea,
  loadProfile,
  loadSelectedWork,
  loadWritingArea,
} from '../../lib/content';
import { profilePageGraph, serialize } from '../../lib/jsonld';
import { labNamedIn, labPath } from '../../lib/lab';
import { labelOf } from '../../lib/nav';
import { aboutCard } from '../../lib/og';
import { postPath } from '../../lib/posts';
import { checkedProfiles, locationLine } from '../../lib/profile';
import { addressText, roleYears } from '../../lib/resume';
import { CONTACT_EMAIL, ORIGIN } from '../../lib/site';
import { writingRow } from '../../lib/work';
import '../../styles/about.css';

// /about/ (ADR 0031): what Joseph builds and has built, one column on every screen, since 2026-10-28
// in /resume/'s place (public/_redirects). On screen: the head (name, role, where, Print), the opening
// in plain words, how they got here, the biggest thing, the labs and the open source as rows, the last
// thing, what came from them, the tools, and the close, every word from src/content/about.md, laid out
// here and never changed. On paper it is the résumé, one US Letter page (about.css, "The résumé on
// paper"; e2e/about-print.spec.ts): the head with the addresses, the opening as the summary, the
// biggest thing, Background, the tools, the agents line over Selected work, and Writing. Each part
// renders only when its source exists (lib/resume.ts): the bio where its entry is (the fixture builds
// hold none), the roles once Joseph adds them (Q8), and Selected work and Writing as Home has them.
// Nothing is copied from a résumé file, which names the employer and is never committed. The Print
// button saves it as a PDF in the visitor's own browser: the site hosts no PDF (content.md, Q9).
const profile = await loadProfile();
const { name, label } = profile.basics;
const bioEntry = await loadAbout();
const bio = bioEntry?.body === undefined ? undefined : aboutParts(bioEntry.body);
const part = (heading: string) => (bio ? sectionOf(bio, heading) : undefined);
const story = part(ABOUT_HEADINGS.story);
const biggest = part(ABOUT_HEADINGS.biggest);
const tryIt = part(ABOUT_HEADINGS.tryIt);
const source = part(ABOUT_HEADINGS.source);
const last = part(ABOUT_HEADINGS.last);
const mine = part(ABOUT_HEADINGS.mine);
const idea = part(ABOUT_HEADINGS.idea);
// The opening's first sentence is Home's statement; here it leads the same paragraph.
const opening = bio?.lede[0];
const first = opening?.match(/^.+?[.!?](?=\s)/)?.[0];
const area = await loadWritingArea();
const lab = await loadLabArea();
const cards = await loadSelectedWork();
const latest = writingRow(area.published, cards);
// A card that opens a lab draws in that lab's line (ADR 0025): found by the page it opens, so the
// colour cannot drift from the page's own. The card's edge stays the page's (ADR 0027).
const lines = new Map(lab.entries.map((entry) => [labPath(entry), entry.slug]));
const demo = new Map(lab.entries.map((entry) => [entry.slug, entry]));
// The labs' rows: each item the bio lists, with the lab its words name. The whole row is its link.
const rows = (tryIt?.principles ?? []).map((item) => {
  const named = labNamedIn(item.text, demo);
  const entry = named && demo.get(named.slug);
  return { item, slug: named?.slug, href: entry && labPath(entry) };
});
// The open source row. The bio's words are plain text (lib/about.ts), so the link comes from the
// record's own check (lib/profile.ts, projectCards, through Selected work): "name: what it is", the
// name a link once its repository may be linked.
const sources = (source?.paragraphs ?? []).map((paragraph) => {
  const at = paragraph.indexOf(': ');
  const project = paragraph.slice(0, at);
  return {
    project,
    words: paragraph.slice(at + 2),
    href: cards.find((card) => card.title === project)?.link.href,
  };
});
// What the prose names, linked where it stands: the essay, as Home links it, and the Lab, each once
// this build writes its page.
const essay = area.published.find((post) => post.slug === 'coding-by-hand');
const named = [
  ...(lab.entries.length > 0 ? [{ name: 'The Lab', href: '/lab/' }] : []),
  ...(essay ? [{ name: 'essay', href: postPath(essay) }] : []),
];
const profiles = checkedProfiles(profile);
const linkedIn = profiles.find((p) => p.network === 'LinkedIn');
const title = labelOf('about');
// The address may break after its "@" when a larger text size leaves it no room on one line, as
// the footer's does, and inside a part only when that part alone is wider than the screen.
const [mailbox, domain] = CONTACT_EMAIL.split('@');
---

<Base
  title={`${name} · ${title}`}
  description="What Joseph Peterson has built, what you can break, and where to reach out."
  path={ABOUT_PATH}
  og={aboutCard(profile, title)}
  jsonLd={serialize(profilePageGraph(profile, ABOUT_PATH))}
  print
>
  <article class="resume" aria-labelledby="name">
    <header class="about-head">
      <div class="about-who">
        <h1 id="name" class="about-name">
          {name}
        </h1>
        <p class="about-role">{label}</p>
        <p class="about-where">{locationLine(profile)}</p>
      </div>
      {/* The addresses are paper's: a sheet has no links to press, and on screen the page closes on
          where to reach out. */}
      <dl class="kv resume-contact">
        <dt>Email</dt>
        <dd>
          <a href={`mailto:${CONTACT_EMAIL}`}>
            {mailbox}@<wbr />
            {domain}
          </a>
        </dd>
        <dt>Web</dt>
        <dd>
          <a href="/">{addressText(ORIGIN)}</a>
        </dd>
        {profiles.map((p) => (
          <>
            <dt>{p.network}</dt>
            <dd>
              <a href={p.url}>{addressText(p.url)}</a>
            </dd>
          </>
        ))}
      </dl>
      {/* Pressed by the command menu's Print row too; src/scripts/palette.js binds it and shows
          it, so without the script it is not there, and on paper it never is. */}
      <button class="btn print-item" type="button" data-print>
        Print or save as PDF
      </button>
    </header>

    <div class="about-body">
      {bio && (
        <section class="bio" id="now" aria-label="About me">
          {opening && (
            <div class="bio-block bio-now">
              <p class="bio-lede">
                {first ? (
                  <>
                    <span class="bio-first">{first}</span> {opening.slice(first.length).trim()}
                  </>
                ) : (
                  opening
                )}
              </p>
            </div>
          )}
          {story && (
            <div class="section bio-block">
              <h2 class="block-label">{story.heading}</h2>
              {story.paragraphs.map((paragraph) => (
                <p class="bio-text">{paragraph}</p>
              ))}
            </div>
          )}
          {biggest && (
            <div class="section bio-block bio-biggest">
              <h2 class="block-label">{biggest.heading}</h2>
              {biggest.paragraphs.map((paragraph) => (
                <p class="bio-text">{paragraph}</p>
              ))}
            </div>
          )}
          {tryIt && (
            <div class="section bio-block">
              <h2 class="block-label">{tryIt.heading}</h2>
              <ul class="post-list bio-rows" role="list">
                {rows.map(({ item, slug, href }) => (
                  <li class="bio-row" data-line={slug}>
                    <h3 class="post-title bio-item-lead">
                      {href ? <a href={href}>{item.lead}</a> : item.lead}
                    </h3>
                    <p class="bio-item-text">{item.text}</p>
                    {slug && <LabLine slug={slug} />}
                  </li>
                ))}
              </ul>
              {tryIt.paragraphs.map((paragraph) => (
                <p class="bio-text">{paragraph}</p>
              ))}
            </div>
          )}
          {source && (
            <div class="section bio-block">
              <h2 class="block-label">{source.heading}</h2>
              <ul class="post-list bio-rows" role="list">
                {sources.map(({ project, words, href }) => (
                  <li class="bio-row">
                    <h3 class="post-title bio-item-lead">
                      {href ? <a href={href}>{project}</a> : project}:
                    </h3>
                    <p class="bio-item-text">{words}</p>
                  </li>
                ))}
              </ul>
            </div>
          )}
          {last && (
            <div class="section bio-block bio-last">
              <h2 class="block-label">{last.heading}</h2>
              {last.paragraphs.map((paragraph) => (
                <p class="bio-text">{paragraph}</p>
              ))}
            </div>
          )}
          {mine && (
            <div class="section bio-block">
              <h2 class="block-label">{mine.heading}</h2>
              {mine.paragraphs.map((paragraph) => (
                <p class="bio-text">
                  {withLinks(paragraph, named).map((run) =>
                    typeof run === 'string' ? run : <a href={run.href}>{run.text}</a>,
                  )}
                </p>
              ))}
            </div>
          )}
        </section>
      )}

      {/* Paper's alone (content.md, "Résumé"): where the history is, since the screen tells it in the
          bio's own words. A section renders only with something to print. */}
      {(profile.work.length > 0 || profile.basics.summary || linkedIn) && (
        <section
          class="section about-section print-only"
          id="experience"
          aria-labelledby="experience-title"
        >
          <h2 id="experience-title" class="block-label">
            Background
          </h2>
          {profile.work.length > 0 && (
            <ol class="roles" role="list">
              {profile.work.map((role) => (
                <li>
                  <p class="role-years">{roleYears(role)}</p>
                  <h3 class="role-title">{role.position}</h3>
                </li>
              ))}
            </ol>
          )}
          <div class="resume-notes">
            {profile.basics.summary && <p>{profile.basics.summary}</p>}
            {linkedIn && (
              <p>
                My full work history is on <a href={linkedIn.url}>LinkedIn</a>.
              </p>
            )}
          </div>
        </section>
      )}

      {profile.tools && (
        <section class="section about-section" id="tools" aria-labelledby="tools-title">
          <h2 id="tools-title" class="block-label">
            {ABOUT_HEADINGS.tools}
          </h2>
          <p class="skills-tools">{profile.tools}</p>
        </section>
      )}

      {cards.length > 0 && (
        <section class="section about-section print-only" id="work" aria-labelledby="work-title">
          <h2 id="work-title" class="block-label">
            Selected work
          </h2>
          {/* Paper names who wrote what before it lists it, so nobody reads built as typed. */}
          {story?.paragraphs[1] && <p class="work-note">{story.paragraphs[1]}</p>}
          <div class="cards">
            {cards.map((card) => (
              <WorkCard
                title={card.title}
                text={card.text}
                facts={card.facts}
                link={card.link}
                line={lines.get(card.link.href)}
              />
            ))}
          </div>
        </section>
      )}

      {latest.length > 0 && (
        <section
          class="section about-section print-only"
          id="writing"
          aria-labelledby="writing-title"
        >
          <h2 id="writing-title" class="block-label">
            Writing
          </h2>
          <PostList posts={latest} level={3} />
          <ul class="post-links">
            <li>
              <a href="/writing/">All writing</a>
            </li>
          </ul>
        </section>
      )}
    </div>
  </article>
  {idea && <Contact heading={idea.heading} words={idea.paragraphs} linkedIn={linkedIn} />}
</Base>
