---
import { render } from 'astro:content';
import PostList from '../../components/PostList.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import WorkCard from '../../components/WorkCard.astro';
import Base from '../../layouts/Base.astro';
import { ABOUT_PATH } from '../../lib/about';
import { loadAbout, loadProfile, loadSelectedWork, loadWritingArea } from '../../lib/content';
import { profilePageGraph, serialize } from '../../lib/jsonld';
import { labelOf, navAll } from '../../lib/nav';
import { aboutCard } from '../../lib/og';
import { areaRoutes, SECTION_LABELS } from '../../lib/posts';
import { checkedProfiles, locationLine } from '../../lib/profile';
import { addressText, evidencePages, roleYears, shownSkills } from '../../lib/resume';
import { CONTACT_EMAIL, ORIGIN } from '../../lib/site';
import { writingRow } from '../../lib/work';

// /about/ (content.md, "About" and "Résumé"): who Joseph is, then his résumé, on one page since
// 2026-10-28, when it took /resume/'s place (public/_redirects). The bio is src/content/about.md,
// his words; everything after it is generated from profile.json and from what this build already
// renders, and nothing is copied from a résumé file, which names the employer and is never
// committed. A section renders only when its source exists (lib/resume.ts): the bio where its entry
// is (the fixture builds hold none), the roles once Joseph adds them (Q8), a skill once every page
// it names is built, and Selected work and Writing exactly as Home has them. On paper it is one US
// Letter page (global.css, "The résumé on paper"; e2e/about-print.spec.ts), and the Print button
// saves it as a PDF in the visitor's own browser: the site hosts no PDF (content.md, Q9). On screen
// the name is a title's size, not the hero's, with the title, the location and the addresses under
// it in the label face (ADR 0025).
const profile = await loadProfile();
const { name, label } = profile.basics;
const bio = await loadAbout();
const Bio = bio ? (await render(bio)).Content : null;
const area = await loadWritingArea();
const cards = await loadSelectedWork();
const latest = writingRow(area.published, cards);
const profiles = checkedProfiles(profile);
const linkedIn = profiles.find((p) => p.network === 'LinkedIn');
// The pages a skill may name: Selected work's, the listed posts, and the other pages this build
// writes, the manifest's and the section indexes, each by its own title.
const pages = [
  ...navAll(areaRoutes(area)),
  ...area.sections.map((s) => ({ href: `/${s}/`, label: SECTION_LABELS[s] })),
];
const skills = shownSkills(profile.skills, evidencePages(cards, area.published, pages));
const title = labelOf('about');
// The address may break after its "@" when a larger text size leaves it no room on one line, as
// the footer's does, and inside a part only when that part alone is wider than the screen.
const [mailbox, domain] = CONTACT_EMAIL.split('@');
---

<Base
  title={`${title} · ${name}`}
  description={`Who ${name} is, how he works, and his résumé. ${label}. ${locationLine(profile)}.`}
  path={ABOUT_PATH}
  og={aboutCard(profile, title)}
  jsonLd={serialize(profilePageGraph(profile, ABOUT_PATH))}
  print
>
  <article class="resume" aria-labelledby="name">
    <header class="hero">
      <h1 id="name" class="hero-name">
        {name}
      </h1>
      <div class="hero-side">
        <div class="hero-who">
          <p class="hero-title">{label}</p>
          <p class="where">{locationLine(profile)}</p>
        </div>
        <dl class="kv resume-contact">
          <dt>Email</dt>
          <dd>
            <a href={`mailto:${CONTACT_EMAIL}`}>
              {mailbox}@<wbr />
              {domain}
            </a>
          </dd>
          <dt>Web</dt>
          <dd>
            <a href="/">{addressText(ORIGIN)}</a>
          </dd>
          {profiles.map((p) => (
            <>
              <dt>{p.network}</dt>
              <dd>
                <a href={p.url}>{addressText(p.url)}</a>
              </dd>
            </>
          ))}
        </dl>
        {/* Pressed by the command menu's Print row too; src/scripts/palette.js binds it and shows
            it, so without the script it is not there, and on paper it never is. */}
        <button class="btn print-item" type="button" data-print>
          Print or save as PDF
        </button>
      </div>
    </header>

    {Bio && (
      <section class="section bio" aria-labelledby="bio-title">
        <SectionTitle id="bio-title" title="About me" />
        <div class="prose">
          <Bio />
        </div>
      </section>
    )}

    <section class="section" aria-labelledby="experience-title">
      <SectionTitle id="experience-title" title="Experience" />
      {profile.work.length > 0 && (
        <ol class="roles" role="list">
          {profile.work.map((role) => (
            <li>
              <p class="role-years">{roleYears(role)}</p>
              <h3 class="role-title">{role.position}</h3>
            </li>
          ))}
        </ol>
      )}
      <div class="resume-notes">
        {linkedIn && (
          <p>
            Full history on <a href={linkedIn.url}>LinkedIn</a>.
          </p>
        )}
        <p>
          Full résumé on request:{' '}
          <span class="resume-email">
            <a href={`mailto:${CONTACT_EMAIL}`}>
              {mailbox}@<wbr />
              {domain}
            </a>
            .
          </span>
        </p>
      </div>
    </section>

    {skills.length > 0 && (
      <section class="section" aria-labelledby="skills-title">
        <SectionTitle id="skills-title" title="Skills" />
        <dl class="skills">
          {skills.map((skill) => (
            <div>
              <dt>{skill.name}</dt>
              <dd>
                {skill.evidence.map((page, i) => (
                  <>
                    {i > 0 && ', '}
                    <a href={page.href}>{page.title}</a>
                  </>
                ))}
              </dd>
            </div>
          ))}
        </dl>
      </section>
    )}

    {cards.length > 0 && (
      <section class="section" aria-labelledby="work-title">
        <SectionTitle id="work-title" title="Selected work" />
        <div class="cards">
          {cards.map((card) => (
            <WorkCard title={card.title} text={card.text} facts={card.facts} link={card.link} />
          ))}
        </div>
      </section>
    )}

    {latest.length > 0 && (
      <section class="section" aria-labelledby="writing-title">
        <SectionTitle id="writing-title" title="Writing" />
        <PostList posts={latest} level={3} />
        <ul class="post-links">
          <li>
            <a href="/writing/">All writing</a>
          </li>
        </ul>
      </section>
    )}
  </article>
</Base>
