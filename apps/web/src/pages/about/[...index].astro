---
import { render } from 'astro:content';
import Prose from '../../layouts/Prose.astro';
import { loadAbout, loadProfile } from '../../lib/content';
import { labelOf } from '../../lib/nav';
import { aboutCard } from '../../lib/og';
import { checkedProfiles, locationLine } from '../../lib/profile';
import { CONTACT_EMAIL } from '../../lib/site';

// /about/, the bio (lib/about.ts). A rest parameter, so the page builds only when its entry says:
// in production once Joseph turns `draft` off, and in a preview from the first draft, marked
// noindex. Its body is his words; after it, the ways to the rest: the résumé, which leaves the
// header once this page exists, the profiles whose readiness check is recorded, and the address.
export async function getStaticPaths() {
  const about = await loadAbout();
  return about.built ? [{ params: { index: undefined } }] : [];
}

const profile = await loadProfile();
const about = await loadAbout();
if (!about.entry || !about.data) throw new Error('about.md did not load');
const { Content } = await render(about.entry);
const links = checkedProfiles(profile);
---

<Prose
  title={`${about.data.title} · ${profile.basics.name}`}
  description={about.data.description}
  path="/about/"
  label={`${about.data.draft ? 'Draft · ' : ''}${profile.basics.label} · ${locationLine(profile)}`}
  heading={about.data.title}
  lead={about.data.lead}
  noindex={about.data.draft}
  og={aboutCard(profile)}
>
  <Content />
  <ul class="post-links" slot="after">
    <li>
      <a href="/resume/">{labelOf('resume')}</a>
    </li>
    {links.map((p) => (
      <li>
        <a href={p.url} rel="me">
          {p.network}
        </a>
      </li>
    ))}
    <li>
      <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
    </li>
  </ul>
</Prose>
