---
import { render } from 'astro:content';
import Prose from '../../layouts/Prose.astro';
import { loadProfile, loadWritingArea, postEntry } from '../../lib/content';
import { postingGraph, serialize } from '../../lib/jsonld';
import { postCard } from '../../lib/og';
import { isoDay, postLabel, postPath, tagWords, wordDay, type PostPage } from '../../lib/posts';

// One post: /writing/<slug>/ for an essay, /notes/<slug>/ for a field note. A listed page is a
// published post, and Writing renders from the first one. Where drafts are included (pull request
// previews and astro dev), drafts build too: noindex, with no link preview or structured data, and
// nothing lists them (lib/posts.ts).
export async function getStaticPaths() {
  const area = await loadWritingArea();
  return area.pages.map((page) => ({
    params: { section: page.post.section, slug: page.post.slug },
    props: { page },
  }));
}

interface Props {
  page: PostPage;
}

const { page } = Astro.props;
const { post } = page;
const listed = page.exposure === 'listed';
const profile = await loadProfile();
const { Content } = await render(await postEntry(post));
const path = postPath(post);
const card = postCard(post);
const image = new URL('og.png', new URL(path, profile.basics.url)).href;
const source = post.source ? new URL(post.source) : null;
// The register beside the title (layouts/Prose.astro, ADR 0025): the post's kind, Draft first on a
// draft, its day and any update in words, and its tags as plain words. After the body: the note's
// source, and the way back to the index while one exists, each a link in words with no arrow.
const links = [
  ...(source ? [{ href: source.href, text: `Source: ${source.hostname}` }] : []),
  ...(listed
    ? [
        {
          href: `/${post.section}/`,
          text: post.section === 'notes' ? 'All field notes' : 'All writing',
        },
      ]
    : []),
];
---

<Prose
  title={`${post.title} · ${profile.basics.name}`}
  description={post.summary}
  path={path}
  heading={post.title}
  lead={post.summary}
  noindex={!listed}
  ogType="article"
  {...(listed ? { og: card, jsonLd: serialize(postingGraph(post, profile, image)) } : {})}
>
  <ul slot="register" class="register" role="list">
    <li class="register-kind">{postLabel(page)}</li>
    <li>
      <time datetime={isoDay(post.published)}>{wordDay(post.published)}</time>
    </li>
    {post.updated && (
      <li>
        Updated <time datetime={isoDay(post.updated)}>{wordDay(post.updated)}</time>
      </li>
    )}
    {post.tags.length > 0 && <li>{tagWords(post.tags)}</li>}
  </ul>
  <Content />
  <Fragment slot="after">
    {links.length > 0 && (
      <ul class="post-links">
        {links.map((link) => (
          <li>
            <a href={link.href}>{link.text}</a>
          </li>
        ))}
      </ul>
    )}
  </Fragment>
</Prose>
