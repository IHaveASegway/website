---
import { render } from 'astro:content';
import PostList from '../../components/PostList.astro';
import Prose from '../../layouts/Prose.astro';
import { loadProfile, loadWritingArea, postEntry } from '../../lib/content';
import { postingGraph, serialize } from '../../lib/jsonld';
import { aboutParts, openingSentence } from '../../lib/about';
import { checkedProfiles } from '../../lib/profile';
import { CONTACT_EMAIL } from '../../lib/site';
import { loadAbout } from '../../lib/content';
import { postCard } from '../../lib/og';
import { isoDay, minutesWords, postLabel, postPath, wordDay, type PostPage } from '../../lib/posts';

// One post: /writing/<slug>/ for an essay, /notes/<slug>/ for a field note. A listed page is a
// published post, and Writing renders from the first one. Where drafts are included (pull request
// previews and astro dev), drafts build too: noindex, with no link preview or structured data, and
// nothing lists them (lib/posts.ts).
export async function getStaticPaths() {
  const area = await loadWritingArea();
  return area.pages.map((page) => ({
    params: { section: page.post.section, slug: page.post.slug },
    props: { page },
  }));
}

interface Props {
  page: PostPage;
}

const { page } = Astro.props;
const { post } = page;
const listed = page.exposure === 'listed';
const profile = await loadProfile();
const { Content } = await render(await postEntry(post));
const path = postPath(post);
const card = postCard(post, profile.basics.name);
const image = new URL('og.png', new URL(path, profile.basics.url)).href;
const source = post.source ? new URL(post.source) : null;
// The register under the lead (layouts/Prose.astro, ADR 0025): the post's day, its kind (Draft
// first on a draft), its reading time and any update in words, and its tags as plain words. After
// the body, a note's source, then More writing: up to three other posts, newest first, as the
// index lists them, and the way back to the index, a link in words with no arrow. A draft lists
// nothing, since nothing lists a draft either way.
const area = await loadWritingArea();
// The close (ADR 0029): this reader arrives cold from a shared link, so the post says who wrote it
// and how to reach him, in words the bio and the profile already own. It renders on a listed post
// where the bio's entry exists; the fixture builds hold none.
const bioEntry = await loadAbout();
const opening = bioEntry?.body === undefined ? undefined : aboutParts(bioEntry.body).lede[0];
const whoWrote = opening === undefined ? undefined : openingSentence(opening);
const linkedIn = checkedProfiles(profile).find((p) => p.network === 'LinkedIn');
const others = listed ? area.published.filter((p) => postPath(p) !== path).slice(0, 3) : [];
const links = [
  ...(listed
    ? [
        {
          href: `/${post.section}/`,
          text: post.section === 'notes' ? 'All field notes' : 'All writing',
        },
      ]
    : []),
];
---

<Prose
  title={`${post.title} · ${profile.basics.name}`}
  description={post.summary}
  path={path}
  heading={post.title}
  lead={post.summary}
  noindex={!listed}
  ogType="article"
  published={isoDay(post.published)}
  {...(listed ? { og: card, jsonLd: serialize(postingGraph(post, profile, image)) } : {})}
>
  <ul slot="register" class="register" role="list">
    <li class="register-by">{profile.basics.name}</li>
    <li>
      <time datetime={isoDay(post.published)}>{wordDay(post.published)}</time>
    </li>
    <li class="register-kind">{postLabel(page)}</li>
    <li>{minutesWords(post.minutes)}</li>
    {post.updated && (
      <li>
        Updated <time datetime={isoDay(post.updated)}>{wordDay(post.updated)}</time>
      </li>
    )}
  </ul>
  <Content />
  <Fragment slot="after">
    {listed && whoWrote && (
      <aside class="post-close" aria-label="About the author">
        <p class="post-close-name">{profile.basics.name}</p>
        <p class="post-close-text">{whoWrote}</p>
        <div class="post-close-actions">
          <a class="btn btn-primary" href={`mailto:${CONTACT_EMAIL}`}>
            Email me
          </a>
          {linkedIn && (
            <a class="btn" href={linkedIn.url} rel="me">
              LinkedIn
            </a>
          )}
        </div>
        <p class="post-close-more">
          <a href="/lab/">Try the labs: small systems you can break</a>
          <a href="/about/">About me</a>
        </p>
      </aside>
    )}
    {source && (
      <ul class="post-links">
        <li>
          <a href={source.href}>Source: {source.hostname}</a>
        </li>
      </ul>
    )}
    {(others.length > 0 || links.length > 0) && (
      <section class="section more-writing" aria-labelledby="more-title">
        <h2 id="more-title" class="section-title">
          More writing
        </h2>
        {others.length > 0 && <PostList posts={others} level={3} />}
        {links.length > 0 && (
          <ul class="post-links">
            {links.map((link) => (
              <li>
                <a href={link.href}>{link.text}</a>
              </li>
            ))}
          </ul>
        )}
      </section>
    )}
  </Fragment>
</Prose>
