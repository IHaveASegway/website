---
import Contact from '../components/home/Contact.astro';
import Orbit from '../components/home/Orbit.astro';
import Motion from '../components/Motion.astro';
import PostList from '../components/PostList.astro';
import WorkCard from '../components/WorkCard.astro';
import Base from '../layouts/Base.astro';
import { ABOUT_HEADINGS, aboutParts, openingSentence, sectionOf, withLinks } from '../lib/about';
import { SEEDS_IN_CI as BACKFILL_SEEDS } from '../lib/backfill/view';
import { SEEDS_IN_CI as CACHE_SEEDS } from '../lib/cache/view';
import {
  loadAbout,
  loadLabArea,
  loadProfile,
  loadSelectedWork,
  loadWritingArea,
} from '../lib/content';
import { figure } from '../lib/home';
import { countTests, readDecisions } from '../lib/home-sources';
import { homeGraph, serialize } from '../lib/jsonld';
import { LAB_NAMES, labNamedIn, labPath } from '../lib/lab';
import { factSource, labFact } from '../lib/lab-facts';
import { homeCard } from '../lib/og';
import { checkedProfiles, homeDescription, roleLine } from '../lib/profile';
import { SEEDS_IN_CI as QUEUE_SEEDS } from '../lib/queue/view';
import { openingServers } from '../lib/orbit';
import { SEEDS_IN_CI as RAFT_SEEDS } from '../lib/raft/view';
import { writingRow } from '../lib/work';
import '../styles/home.css';

// Home (docs/design/home.md; ADR 0028, ADR 0031). Who Joseph is, in their words and at the size of a
// statement: the bio's opening. Beside it, or under it on a phone, the one live thing on the page: the
// Raft Lab's cluster as its page opens. Then the things they built that a visitor can try, a row for
// each with the lab where it breaks and one fact from that lab's own build; the latest writing; the
// last thing they built, closed by the record the repository keeps; and where to reach out. Every
// figure is worked out at build from its system of record, none typed. A part renders only when its
// source exists: the fixture builds hold no bio and no lab, and there Home is the name, the writing
// and where to reach out.
const profile = await loadProfile();
const { name } = profile.basics;
const area = await loadWritingArea();
const lab = await loadLabArea();
const external = checkedProfiles(profile);
const linkedIn = external.find((p) => p.network === 'LinkedIn');

// The bio (src/content/about.md) is the one owner of Joseph's words about themself: Home lays out its
// opening, the things they built that a visitor can try and the last thing they built, and /about/
// renders it whole.
const bioEntry = await loadAbout();
const bio = bioEntry?.body === undefined ? undefined : aboutParts(bioEntry.body);
const build = bio && sectionOf(bio, ABOUT_HEADINGS.tryIt);
const last = bio && sectionOf(bio, ABOUT_HEADINGS.last);
const idea = bio && sectionOf(bio, ABOUT_HEADINGS.idea);

// The opening's first sentence is said as the statement, with one sentence of Home's own that says
// what the page is for; the rest of the opening follows it at a lead's size, word for word.
const opening = bio?.lede ?? [];
const statement = opening[0] === undefined ? undefined : openingSentence(opening[0]);
const rest = [
  ...(opening[0] && statement ? [opening[0].slice(statement.length).trim()] : []),
  ...opening.slice(1),
].filter(Boolean);

// The labs this build writes, by slug. The bio's names for them link to them.
const demo = new Map(lab.entries.map((entry) => [entry.slug, entry]));
const names = LAB_NAMES.flatMap(({ slug, name: words }) => {
  const entry = demo.get(slug);
  return entry ? [{ name: words, href: labPath(entry) }] : [];
});

// The things a visitor can try: each the bio lists, with the lab its words name and that lab's fact
// (lib/lab-facts.ts, the sentences the Lab index's cards read too).
const builds = await Promise.all(
  (build?.principles ?? []).map(async (principle) => {
    const named = labNamedIn(principle.text, demo);
    const entry = named && demo.get(named.slug);
    return {
      principle,
      lab:
        entry && named
          ? {
              slug: entry.slug,
              name: named.name,
              href: labPath(entry),
              fact: await labFact(entry.slug),
            }
          : undefined,
    };
  }),
);

// The live picture: the Raft Lab's opening run, as its page plays it before anyone presses anything.
const servers = demo.has('raft') ? openingServers() : undefined;
const raftEntry = demo.get('raft');

// Selected work (content.md, "Owned work"; lib/work.ts) beyond the labs, which its rows carry:
// each project whose check is recorded and whose hold is lifted, and each featured post.
const work = await loadSelectedWork();
const demoPages = new Set(lab.entries.map(labPath));
const others = work.filter((card) => !demoPages.has(card.link.href));

// The record the repository keeps (lib/home-sources.ts), each count from its source: the decision
// records in docs/adr/, the tests in test/ and e2e/, and the seeded runs the simulated labs' sweeps
// play on every pull request (each lab's SEEDS_IN_CI). A count whose source cannot be read is left
// out, never guessed. This is the one place the site names the term a tech lead looks for (content.md,
// "The site's language"). It counts tests as written, once each, however many times a loop runs one:
// CI's total is about nine times this.
const SEEDS: Record<string, number> = {
  raft: RAFT_SEEDS,
  queue: QUEUE_SEEDS,
  cache: CACHE_SEEDS,
  backfill: BACKFILL_SEEDS,
};
const decisions = readDecisions().length;
const tests = countTests();
const seeded = lab.entries.reduce((n, entry) => n + (SEEDS[entry.slug] ?? 0), 0);
const record = [
  decisions > 0 ? `${figure(decisions)} decision records (ADRs)` : '',
  tests > 0 ? `${figure(tests)} tests written` : '',
  seeded > 0 ? `${figure(seeded)} simulated runs on every pull request` : '',
].filter(Boolean);
const recordLine =
  record.length > 1 ? `${record.slice(0, -1).join(', ')} and ${record.at(-1)}` : (record[0] ?? '');

// The latest writing, in the dated list /writing/ shows (components/PostList.astro): one list, so
// a post's day and reading time (lib/posts.ts, Post.minutes) read the same on both pages.
const latest = writingRow(area.published, work);
---

<Base
  title={`${name} · ${profile.basics.label}`}
  description={homeDescription(profile)}
  path="/"
  og={homeCard(profile)}
  jsonLd={serialize(homeGraph(profile))}
>
  <section class={servers ? 'hero' : 'hero hero-plain'} aria-labelledby="name" data-row="1">
    <div class="hero-words">
      <p class="hero-role">{roleLine(profile)}</p>
      <h1 id="name" class="hero-name">
        {name}
      </h1>
      {statement && <p class="hero-statement">{statement} Here are a few things you can break.</p>}
      {rest.map((paragraph) => (
        <p class="hero-more">{paragraph}</p>
      ))}
      {/* LinkedIn is how people reach Joseph, so it's the button that leads (ADR 0031). */}
      <div class="hero-actions">
        {external.map((p) => (
          <a class:list={['btn', { 'btn-primary': p === linkedIn }]} href={p.url} rel="me">
            {p.network}
          </a>
        ))}
      </div>
    </div>
    {servers && raftEntry && <Orbit servers={servers} href={labPath(raftEntry)} />}
  </section>

  {builds.length > 0 && (
    <section class="section builds" id="build" aria-labelledby="build-title">
      <h2 class="section-title" id="build-title">
        {build?.heading}
      </h2>
      <ul class="build-list" role="list">
        {builds.map(({ principle, lab: where }) => (
          <li class="build" data-line={where?.slug}>
            <h3 class="build-lead">{principle.lead}</h3>
            <p class="build-text">
              {withLinks(principle.text, names).map((run) =>
                typeof run === 'string' ? run : <a href={run.href}>{run.text}</a>,
              )}
            </p>
            {where?.fact && (
              <div class="build-evidence">
                <p class="build-lab">
                  {factSource(where.slug, where.name)
                    .split('made-up')
                    .map((part, i) =>
                      i === 0 ? (
                        part
                      ) : (
                        <>
                          <span class="build-word">made-up</span>
                          {part}
                        </>
                      ),
                    )}
                </p>
                <p class="build-fact">{where.fact}</p>
              </div>
            )}
          </li>
        ))}
      </ul>
      {lab.visible && (
        <p class="build-more">
          <a href="/lab/">Try all the labs</a>
        </p>
      )}
    </section>
  )}

  {others.length > 0 && (
    <section class="section" id="work" aria-labelledby="work-title">
      <h2 class="section-title" id="work-title">
        Selected work
      </h2>
      <div class="cards">
        {others.map((card) => (
          <WorkCard title={card.title} text={card.text} facts={card.facts} link={card.link} />
        ))}
      </div>
    </section>
  )}

  {area.visible && (
    <section class="section" id="writing" aria-labelledby="writing-title">
      <div class="section-head">
        <h2 class="section-title" id="writing-title">
          Writing
        </h2>
        <a class="section-more" href="/writing/">
          All writing
        </a>
      </div>
      {latest.length > 0 && <PostList posts={latest} level={3} />}
      <ul class="post-links">
        <li>
          <a href="/rss.xml">RSS feed</a>
        </li>
      </ul>
    </section>
  )}

  {last && (
    <section class="section last" id="last" aria-labelledby="last-title">
      <h2 class="section-title" id="last-title">
        {last.heading}
      </h2>
      {last.paragraphs.map((paragraph) => (
        <p class="last-text">{paragraph}</p>
      ))}
      {recordLine && <p class="record">This site so far: {recordLine}.</p>}
    </section>
  )}

  <Contact heading={idea?.heading} words={idea?.paragraphs} linkedIn={linkedIn} />
  <Motion />
</Base>
