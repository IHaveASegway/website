---
import Contact from '../components/home/Contact.astro';
import Orbit from '../components/home/Orbit.astro';
import Motion from '../components/Motion.astro';
import PostList from '../components/PostList.astro';
import WorkCard from '../components/WorkCard.astro';
import Base from '../layouts/Base.astro';
import {
  ABOUT_HEADINGS,
  aboutParts,
  LAB_NAMES,
  openingSentence,
  sectionOf,
  withLinks,
} from '../lib/about';
import { SEEDS_IN_CI as BACKFILL_SEEDS } from '../lib/backfill/view';
import { SEEDS_IN_CI as CACHE_SEEDS } from '../lib/cache/view';
import {
  loadAbout,
  loadLabArea,
  loadProfile,
  loadSelectedWork,
  loadWritingArea,
} from '../lib/content';
import { figure } from '../lib/home';
import { countTests, readCommitDays, readDecisions } from '../lib/home-sources';
import { homeGraph, serialize } from '../lib/jsonld';
import { labPath } from '../lib/lab';
import { labFact } from '../lib/lab-facts';
import { inWords } from '../lib/lines';
import { homeCard } from '../lib/og';
import { postPath } from '../lib/posts';
import { checkedProfiles, homeDescription, roleLine } from '../lib/profile';
import { SEEDS_IN_CI as QUEUE_SEEDS } from '../lib/queue/view';
import { leaderOf } from '../lib/raft/sim';
import { SEEDS_IN_CI as RAFT_SEEDS, openingRun as raftRun } from '../lib/raft/view';
import { CONTACT_EMAIL } from '../lib/site';
import { writingRow } from '../lib/work';
import '../styles/home.css';

// Home (docs/design/home.md; ADR 0028). Who Joseph is, in his words and at the size of a statement:
// the bio's opening, each kind of system it names a link to the lab that runs one. Beside it, or
// under it on a phone, the one live thing on the page: the Raft Lab's cluster as its page opens.
// Then What I build, a row for each thing he builds with the lab where a visitor can break it and
// one fact from that lab's own build; the latest writing; How I work, closed by the record the
// repository keeps; and the address, which a visitor can copy when no mail app opens. Every figure
// is worked out at build from its system of record, none typed. A part renders only when its source
// exists: the fixture builds hold no bio and no lab, and there Home is the name, the writing and the
// address.
const profile = await loadProfile();
const { name } = profile.basics;
const area = await loadWritingArea();
const lab = await loadLabArea();
const external = checkedProfiles(profile);
const linkedIn = external.find((p) => p.network === 'LinkedIn');

// The bio (src/content/about.md) is the one owner of Joseph's words about himself: Home lays out its
// opening, What I build and How I work, and /about/ renders it whole.
const bioEntry = await loadAbout();
const bio = bioEntry?.body === undefined ? undefined : aboutParts(bioEntry.body);
const build = bio && sectionOf(bio, ABOUT_HEADINGS.build);
const how = bio && sectionOf(bio, ABOUT_HEADINGS.how);

// The opening's first sentence is said as the statement; the rest of the opening follows it at a
// lead's size, word for word.
const opening = bio?.lede ?? [];
const statement = opening[0] === undefined ? undefined : openingSentence(opening[0]);
const rest = [
  ...(opening[0] && statement ? [opening[0].slice(statement.length).trim()] : []),
  ...opening.slice(1),
].filter(Boolean);

// The labs this build writes, by slug. The bio's names for them link to them; in the opening, the
// kinds of system it names do, each underlined in its lab's colour.
const demo = new Map(lab.entries.map((entry) => [entry.slug, entry]));
const names = LAB_NAMES.flatMap(({ slug, name: words }) => {
  const entry = demo.get(slug);
  return entry ? [{ name: words, href: labPath(entry) }] : [];
});
const KINDS = [
  { words: 'queues', slug: 'queue' },
  { words: 'data pipelines', slug: 'backfill' },
  { words: 'caches', slug: 'cache' },
  { words: 'clusters', slug: 'raft' },
] as const;
const kinds = KINDS.flatMap(({ words, slug }) => {
  const entry = demo.get(slug);
  return entry ? [{ name: words, href: labPath(entry) }] : [];
});
const lineOf = new Map(lab.entries.map((entry) => [labPath(entry), entry.slug]));

// The essay the bio's last thing he builds points to, linked where this build lists it.
const essay = area.published.find((post) => post.slug === 'the-road-closed');
const reads = essay ? [{ name: 'essay on the road that closed', href: postPath(essay) }] : [];

// What I build: each of the bio's five, with the lab its words name and that lab's fact (lib/lab-facts.ts,
// the sentences the Lab index's cards read too).
const builds = await Promise.all(
  (build?.principles ?? []).map(async (principle) => {
    const named = LAB_NAMES.find(
      ({ name: words, slug }) => principle.text.includes(words) && demo.has(slug),
    );
    const entry = named && demo.get(named.slug);
    return {
      principle,
      lab:
        entry && named
          ? {
              slug: entry.slug,
              name: named.name,
              href: labPath(entry),
              fact: await labFact(entry.slug, 'home'),
            }
          : undefined,
    };
  }),
);

// The live picture: the Raft Lab's opening run, as its page plays it before anyone presses anything.
const raft = demo.has('raft') ? raftRun() : undefined;
const leader = raft ? leaderOf(raft) : null;
const servers = raft?.servers.map((server) => ({
  id: server.id,
  leader: server.id === leader?.id,
  entries: server.log.length,
}));
const raftEntry = demo.get('raft');

// Selected work (content.md, "Owned work"; lib/work.ts) beyond the labs, which What I build carries:
// each project whose check is recorded and whose hold is lifted, and each featured post.
const work = await loadSelectedWork();
const demoPages = new Set(lab.entries.map(labPath));
const others = work.filter((card) => !demoPages.has(card.link.href));

// The record the repository keeps (lib/home-sources.ts), each count from its source: the commits in
// its history, the decision records in docs/adr/, the tests in test/ and e2e/, and the seeded runs
// the simulated labs' sweeps play on every pull request (each lab's SEEDS_IN_CI). A count whose
// source cannot be read is left out, never guessed.
const SEEDS: Record<string, number> = {
  raft: RAFT_SEEDS,
  queue: QUEUE_SEEDS,
  cache: CACHE_SEEDS,
  backfill: BACKFILL_SEEDS,
};
const commits = readCommitDays().length;
const decisions = readDecisions().length;
const tests = countTests();
const seeded = lab.entries.reduce((n, entry) => n + (SEEDS[entry.slug] ?? 0), 0);
const record = [
  commits > 0 ? `${figure(commits)} commits` : '',
  decisions > 0 ? `${figure(decisions)} decision records` : '',
  tests > 0 ? `${figure(tests)} tests` : '',
  seeded > 0 ? `${figure(seeded)} seeded runs on every pull request` : '',
].filter(Boolean);
const recordLine =
  record.length > 1 ? `${record.slice(0, -1).join(', ')} and ${record.at(-1)}` : (record[0] ?? '');

// The latest writing, in the dated list /writing/ shows (components/PostList.astro): one list, so
// a post's day and reading time (lib/posts.ts, Post.minutes) read the same on both pages.
const latest = writingRow(area.published, work);
---

<Base
  title={`${name} · ${profile.basics.label}`}
  description={homeDescription(profile)}
  path="/"
  og={homeCard(profile)}
  jsonLd={serialize(homeGraph(profile))}
>
  <section class={servers ? 'hero' : 'hero hero-plain'} aria-labelledby="name" data-row="1">
    <div class="hero-words">
      <p class="hero-role">{roleLine(profile)}</p>
      <h1 id="name" class="hero-name">
        {name}
      </h1>
      {statement && (
        <p class="hero-statement">
          {withLinks(statement, kinds).map((run) =>
            typeof run === 'string' ? (
              run
            ) : (
              <a href={run.href} data-line={lineOf.get(run.href)}>
                {run.text}
              </a>
            ),
          )}
        </p>
      )}
      {rest.map((paragraph) => (
        <p class="hero-more">{paragraph}</p>
      ))}
      <div class="hero-actions">
        <a class="btn btn-primary btn-email" href={`mailto:${CONTACT_EMAIL}`}>
          Email {CONTACT_EMAIL}
        </a>
        {external.map((p) => (
          <a class="btn" href={p.url} rel="me">
            {p.network}
          </a>
        ))}
      </div>
    </div>
    {servers && raft && raftEntry && (
      <Orbit servers={servers} term={leader?.term ?? 0} href={labPath(raftEntry)} />
    )}
  </section>

  {builds.length > 0 && (
    <section class="section builds" id="build" aria-labelledby="build-title">
      <h2 class="section-title" id="build-title">
        {build?.heading}
      </h2>
      <ul class="build-list" role="list">
        {builds.map(({ principle, lab: where }) => (
          <li class="build" data-line={where?.slug}>
            <h3 class="build-lead">{principle.lead}</h3>
            <p class="build-text">
              {withLinks(principle.text, [...names, ...reads]).map((run) =>
                typeof run === 'string' ? run : <a href={run.href}>{run.text}</a>,
              )}
            </p>
            {where?.fact && (
              <div class="build-evidence">
                <p class="build-lab">{where.name}</p>
                <p class="build-fact">{where.fact}</p>
              </div>
            )}
          </li>
        ))}
      </ul>
      {lab.visible && (
        <p class="build-more">
          <a href="/lab/">All {inWords(lab.entries.length)} labs</a>
        </p>
      )}
    </section>
  )}

  {others.length > 0 && (
    <section class="section" id="work" aria-labelledby="work-title">
      <h2 class="section-title" id="work-title">
        Selected work
      </h2>
      <div class="cards">
        {others.map((card) => (
          <WorkCard title={card.title} text={card.text} facts={card.facts} link={card.link} />
        ))}
      </div>
    </section>
  )}

  {area.visible && (
    <section class="section" id="writing" aria-labelledby="writing-title">
      <div class="section-head">
        <h2 class="section-title" id="writing-title">
          Writing
        </h2>
        <a class="section-more" href="/writing/">
          All writing
        </a>
      </div>
      {latest.length > 0 && <PostList posts={latest} level={3} />}
      <ul class="post-links">
        <li>
          <a href="/rss.xml">RSS feed</a>
        </li>
      </ul>
    </section>
  )}

  {how && (
    <section class="section principles" id="how" aria-labelledby="how-title">
      <h2 class="section-title" id="how-title">
        {how.heading}
      </h2>
      <ul class="principles-list" role="list">
        {how.principles.map((principle) => (
          <li class="principle">
            <h3 class="principle-lead">{principle.lead}</h3>
            <p class="principle-text">
              {withLinks(principle.text, names).map((run) =>
                typeof run === 'string' ? run : <a href={run.href}>{run.text}</a>,
              )}
            </p>
          </li>
        ))}
      </ul>
      {recordLine && <p class="record">The repository's record so far: {recordLine}.</p>}
    </section>
  )}

  <Contact linkedIn={linkedIn} />
  <Motion />
</Base>
