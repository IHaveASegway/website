---
import Activity from '../components/home/Activity.astro';
import LabCards from '../components/home/LabCards.astro';
import Stats from '../components/home/Stats.astro';
import System from '../components/iso/System.astro';
import Motion from '../components/Motion.astro';
import PostList from '../components/PostList.astro';
import WorkCard from '../components/WorkCard.astro';
import Base from '../layouts/Base.astro';
import { ABOUT_HEADINGS, aboutParts, LAB_NAMES, sectionOf, withLinks } from '../lib/about';
import { SEEDS_IN_CI as BACKFILL_SEEDS, openingRun as backfillRun } from '../lib/backfill/view';
import { SEEDS_IN_CI as CACHE_SEEDS, openingRun as cacheRun } from '../lib/cache/view';
import {
  loadAbout,
  loadLabArea,
  loadProfile,
  loadSelectedWork,
  loadWritingArea,
} from '../lib/content';
import { activity as activityOf } from '../lib/home';
import { countTests, readCommitDays, readDecisions } from '../lib/home-sources';
import { system, type Counts, type Lab, type Part } from '../lib/iso/system';
import { homeGraph, serialize } from '../lib/jsonld';
import { labPath } from '../lib/lab';
import { labFact } from '../lib/lab-facts';
import { homeCard } from '../lib/og';
import { checkedProfiles, homeDescription, roleLine } from '../lib/profile';
import { SEEDS_IN_CI as QUEUE_SEEDS, openingRun as queueRun } from '../lib/queue/view';
import { leaderOf } from '../lib/raft/sim';
import { SEEDS_IN_CI as RAFT_SEEDS, openingRun as raftRun } from '../lib/raft/view';
import { routeLabPicture } from '../lib/route-lab/picture';
import { CONTACT_EMAIL } from '../lib/site';
import { writingRow } from '../lib/work';
import '../styles/home.css';

// Home (docs/design/overhaul.md, "Home"; ADR 0027), after the pages Joseph named: who he is, then
// what he builds, drawn. First the name across the top in capitals, the one thing set that way, and
// the role under it; then the bio's blocks beside the drawing of his five labs as one system, each
// part a link to the lab that runs it (below 64rem the drawing comes first, under the name); the
// ways to reach him under the blocks. Then the figures his records give, the activity calendar of the
// site's own repository, the labs as cards, the latest writing in a dated list, how he works, and
// the address again. Every figure and count is worked out at build from its system of record,
// none typed (lib/home.ts). A part renders only when its source exists: the fixture builds hold
// no bio and no lab, and there Home is the name, the writing and the address.
const profile = await loadProfile();
const { name } = profile.basics;
const area = await loadWritingArea();
const lab = await loadLabArea();
const external = checkedProfiles(profile);
const linkedIn = external.find((p) => p.network === 'LinkedIn');

// The bio (src/content/about.md) is the one owner of Joseph's words about himself: Home lays out
// its parts as syntaqx's named blocks, and /about/ renders it whole. "Now" is its opening, "What I
// build" its five bold leads, "Working toward" its closing section; How I work comes further down.
const bioEntry = await loadAbout();
const bio = bioEntry?.body === undefined ? undefined : aboutParts(bioEntry.body);
const build = bio && sectionOf(bio, ABOUT_HEADINGS.build);
const how = bio && sectionOf(bio, ABOUT_HEADINGS.how);
const toward = bio && sectionOf(bio, ABOUT_HEADINGS.toward);
const blocks = [
  bio?.lede.length ? { name: 'Now', paragraphs: bio.lede, items: [] } : undefined,
  build?.principles.length
    ? { name: 'What I build', paragraphs: [], items: build.principles.map((p) => p.lead) }
    : undefined,
  toward?.paragraphs.length
    ? { name: 'Working toward', paragraphs: toward.paragraphs, items: [] }
    : undefined,
].filter((block) => block !== undefined);

// The labs this build writes, by slug; the bio's names for them link to them in How I work.
const demo = new Map(lab.entries.map((entry) => [entry.slug, entry]));
const names = LAB_NAMES.flatMap(({ slug, name: words }) => {
  const entry = demo.get(slug);
  return entry ? [{ name: words, href: labPath(entry) }] : [];
});

// Each lab's opening run, as its own page plays it before anyone presses anything: the drawing
// counts its parts from them, and each card's fact is worked out from them, as the Lab index's is.
const runs = lab.visible
  ? (() => {
      const queue = queueRun();
      const cache = cacheRun();
      const raft = raftRun();
      const backfill = backfillRun();
      return { queue, cache, raft, backfill };
    })()
  : undefined;
const picture = demo.has('routes') ? await routeLabPicture(process.cwd()) : undefined;
const leader = runs ? leaderOf(runs.raft) : null;
const counts: Counts = {
  workers: runs?.queue.size ?? 3,
  nodes: runs?.cache.nodes.length ?? 4,
  servers: runs?.raft.servers.length ?? 5,
  leader: leader?.id ?? 0,
  vans: picture?.day.vans ?? 3,
  days: runs?.backfill.report.length ?? 7,
};
const model = lab.visible ? system(counts) : undefined;
const links: Partial<Record<Lab, { href: string; title: string }>> = Object.fromEntries(
  lab.entries.map((entry) => [entry.slug, { href: labPath(entry), title: entry.title }]),
);
const parts = new Map<string, Part>(model?.parts.map((part) => [part.lab, part]) ?? []);

// Each card's fact (lib/lab-facts.ts, Home's sentences): the module the Lab index's cards read too.
const facts = new Map<string, string>(
  (
    await Promise.all(
      lab.entries.map(async (entry) => [entry.slug, await labFact(entry.slug, 'home')] as const),
    )
  ).flatMap(([slug, fact]) => (fact ? [[slug, fact] as [string, string]] : [])),
);

// Selected work (content.md, "Owned work"; lib/work.ts): one list feeds Home and /about/, item for
// item. Each lab is a card with its glyph, in the lab's order; then a card for each project whose
// check is recorded and whose hold is lifted, and each featured post this build lists.
const work = await loadSelectedWork();
const demoPages = new Set(lab.entries.map(labPath));
const others = work.filter((card) => !demoPages.has(card.link.href));

// The figures (lib/home.ts), each from its record: the labs this build writes; the seeded runs
// the four simulated labs' sweeps play on every pull request (each lab's SEEDS_IN_CI, the count
// its own page states); the decision records in docs/adr/; the tests written in test/ and e2e/.
const decisions = readDecisions();
const SEEDS: Record<string, number> = {
  raft: RAFT_SEEDS,
  queue: QUEUE_SEEDS,
  cache: CACHE_SEEDS,
  backfill: BACKFILL_SEEDS,
};
const seeded = lab.entries.reduce((n, entry) => n + (SEEDS[entry.slug] ?? 0), 0);
const stats = [
  { value: lab.entries.length, caption: 'live labs to break' },
  { value: seeded, caption: 'seeded runs on every pull request' },
  { value: decisions.length, caption: 'decision records' },
  { value: countTests(), caption: 'tests written' },
];
const activity = activityOf(readCommitDays(), decisions);

// The latest writing, in the dated list /writing/ shows (components/PostList.astro): one list, so
// a post's day and reading time (lib/posts.ts, Post.minutes) read the same on both pages.
const latest = writingRow(area.published, work);

// The closing address may break after its "@", and only there.
const [mailbox, domain] = CONTACT_EMAIL.split('@');
---

<Base
  title={`${name} · ${profile.basics.label}`}
  description={homeDescription(profile)}
  path="/"
  og={homeCard(profile)}
  jsonLd={serialize(homeGraph(profile))}
>
  <section class={model ? 'intro' : 'intro intro-plain'} aria-labelledby="name" data-row="1">
    <div class="intro-who">
      <h1 id="name" class="nameplate">
        {name}
      </h1>
      <p class="intro-role">{roleLine(profile)}</p>
      <div class="intro-actions">
        <a class="btn btn-primary btn-email" href={`mailto:${CONTACT_EMAIL}`}>
          Email {CONTACT_EMAIL}
        </a>
        {external.map((p) => (
          <a class="btn" href={p.url} rel="me">
            {p.network}
          </a>
        ))}
      </div>
    </div>
    {model && <System counts={counts} labs={links} />}
    {blocks.length > 0 && (
      <div class="bio-blocks">
        {blocks.map((block) => (
          <section class="bio-block">
            <h2 class="block-label">{block.name}</h2>
            {block.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
            {block.items.length > 0 && (
              <ul class="bio-list" role="list">
                {block.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            )}
          </section>
        ))}
      </div>
    )}
  </section>

  <section class="band" aria-label="In figures">
    <Stats stats={stats} />
  </section>

  {activity && (
    <section class="section" id="activity" aria-labelledby="activity-title">
      <Activity activity={activity} title="Activity" id="activity-title" />
    </section>
  )}

  {(lab.entries.length > 0 || others.length > 0) && (
    <section class="section" id="work" aria-labelledby="work-title">
      <div class="section-head">
        <h2 class="section-title" id="work-title">
          Selected work
        </h2>
        {lab.visible && (
          <a class="section-more" href="/lab/">
            All labs
          </a>
        )}
      </div>
      {lab.entries.length > 0 && <LabCards labs={lab.entries} parts={parts} facts={facts} />}
      {others.length > 0 && (
        <div class="cards">
          {others.map((card) => (
            <WorkCard title={card.title} text={card.text} facts={card.facts} link={card.link} />
          ))}
        </div>
      )}
    </section>
  )}

  {area.visible && (
    <section class="section" id="writing" aria-labelledby="writing-title">
      <div class="section-head">
        <h2 class="section-title" id="writing-title">
          Writing
        </h2>
        <a class="section-more" href="/writing/">
          All writing
        </a>
      </div>
      {latest.length > 0 && <PostList posts={latest} level={3} />}
      <ul class="post-links">
        <li>
          <a href="/rss.xml">RSS feed</a>
        </li>
      </ul>
    </section>
  )}

  {how && (
    <section class="section principles" id="how" aria-labelledby="how-title">
      <h2 class="section-title" id="how-title">
        {how.heading}
      </h2>
      <ul class="principles-list" role="list">
        {how.principles.map((principle) => (
          <li class="principle">
            <h3 class="principle-lead">{principle.lead}</h3>
            <p class="principle-text">
              {withLinks(principle.text, names).map((run) =>
                typeof run === 'string' ? run : <a href={run.href}>{run.text}</a>,
              )}
            </p>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="section closing" id="contact" aria-labelledby="contact-title">
    <h2 class="section-title" id="contact-title">
      Contact
    </h2>
    {/* A phone breaks the address after its @, never inside a word (a <wbr>, unseen and unread). */}
    <a class="closing-mail" href={`mailto:${CONTACT_EMAIL}`}>
      {mailbox}@<wbr />
      {domain}
    </a>
    {linkedIn && (
      <div class="closing-actions">
        <a class="btn" href={linkedIn.url}>
          {linkedIn.network}
        </a>
      </div>
    )}
  </section>
  <Motion />
</Base>
