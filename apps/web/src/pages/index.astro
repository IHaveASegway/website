---
import Hero from '../components/Hero.astro';
import PostList from '../components/PostList.astro';
import SectionTitle from '../components/SectionTitle.astro';
import WorkCard from '../components/WorkCard.astro';
import Base from '../layouts/Base.astro';
import { loadProfile, loadSelectedWork, loadWritingArea } from '../lib/content';
import { homeGraph, serialize } from '../lib/jsonld';
import { homeCard } from '../lib/og';
import { homeDescription } from '../lib/profile';
import { writingRow } from '../lib/work';

// Home (content.md, "Home page"): who Joseph is, his work, his writing and how to reach him. An
// element renders only when its source and its link target exist; until then it is left out,
// never filled with a placeholder.
const profile = await loadProfile();
const { name, label } = profile.basics;
const area = await loadWritingArea();
// Selected work: a card per live demo in the lab, then a card per project whose check is recorded
// and whose hold is lifted, then a card per featured post once it is published (lib/work.ts). The
// résumé reads the same list.
const cards = await loadSelectedWork();
// Writing: the latest posts that are not already a card above.
const latest = writingRow(area.published, cards);
---

<Base
  title={`${name} · ${label}`}
  description={homeDescription(profile)}
  path="/"
  og={homeCard(profile)}
  jsonLd={serialize(homeGraph(profile))}
>
  <Hero profile={profile} work={cards.length > 0 ? '#work' : undefined} />

  {cards.length > 0 && (
    <section class="section" id="work" aria-labelledby="work-title">
      <SectionTitle id="work-title" title="Selected work" />
      <div class="cards">
        {cards.map((card) => (
          <WorkCard
            tag={card.tag}
            title={card.title}
            text={card.text}
            facts={card.facts}
            link={card.link}
          />
        ))}
      </div>
    </section>
  )}

  {area.visible && (
    <section class="section" id="writing" aria-labelledby="writing-title">
      <SectionTitle id="writing-title" title="Writing" />
      {latest.length > 0 && <PostList posts={latest} level={3} />}
      <ul class="post-links">
        <li>
          <a href="/writing/">All writing</a>
        </li>
        <li>
          <a href="/rss.xml">RSS feed</a>
        </li>
      </ul>
    </section>
  )}
</Base>
