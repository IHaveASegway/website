---
import Board from '../components/board/Board.astro';
import Hero from '../components/Hero.astro';
import Motion from '../components/Motion.astro';
import PostList from '../components/PostList.astro';
import RouteChapter from '../components/RouteChapter.astro';
import RouteScene from '../components/RouteScene.astro';
import SectionTitle from '../components/SectionTitle.astro';
import WorkCard from '../components/WorkCard.astro';
import Base from '../layouts/Base.astro';
import {
  ABOUT_HEADINGS,
  aboutParts,
  LAB_NAMES,
  openingSentence,
  sectionOf,
  withLinks,
} from '../lib/about';
import {
  loadAbout,
  loadLabArea,
  loadProfile,
  loadSelectedWork,
  loadWritingArea,
} from '../lib/content';
import { homeGraph, serialize } from '../lib/jsonld';
import { labPath } from '../lib/lab';
import { figureWords, vanLines } from '../lib/lines';
import { homeCard } from '../lib/og';
import { checkedProfiles, homeDescription } from '../lib/profile';
import { dayLine, formatDuration } from '../lib/route-lab/format';
import { routeData, routeLabPicture } from '../lib/route-lab/picture';
import { CONTACT_EMAIL } from '../lib/site';
import { writingRow } from '../lib/work';
import '../styles/home.css';

// Home (content.md, "Home page"; ADR 0023, ADR 0024, ADR 0025): who Joseph is, told top to bottom,
// and led by the work. The first screen is the stage: the Route Lab's day driven live on the city,
// edge to edge, its water the page itself, and Joseph's column standing on the water: his name,
// his role, the bio's opening, what VROOM saves that day, the ways to reach him and the scene's
// caption. Scrolling brings up the Route Lab's chapter while the day lifts into the space-time
// cube, then the board, every live lab as a line, which slides over the scene; then how he works,
// in the bio's words; then the writing; then what he is working toward and how to reach him. An
// element renders only when its source and its link target exist; until then it is left out,
// never a placeholder.
const profile = await loadProfile();
const { name, label } = profile.basics;
const area = await loadWritingArea();
const lab = await loadLabArea();
// The bio (src/content/about.md) is the one owner of Joseph's words about himself; Home lays out
// its parts and /about/ renders it whole. The fixture builds hold none, and Home has no sentence,
// no How I work and no closing there.
const bioEntry = await loadAbout();
const bio = bioEntry?.body === undefined ? undefined : aboutParts(bioEntry.body);
// Each part by its heading: What I build comes before How I work and is a list of bold leads too,
// so neither its place nor its shape picks the principles. Home shows How I work and the close.
const principles = bio && sectionOf(bio, ABOUT_HEADINGS.how);
// The hero says the opening's first sentence, what Joseph builds; /about/ says the whole opening.
const lede = bio?.lede[0] === undefined ? undefined : [openingSentence(bio.lede[0])];
const toward = bio && sectionOf(bio, ABOUT_HEADINGS.toward);
// The demos this build writes, by slug. The bio names them, and on Home those words link to them.
const demo = new Map(lab.entries.map((entry) => [entry.slug, entry]));
const names = LAB_NAMES.flatMap(({ slug, name: words }) => {
  const entry = demo.get(slug);
  return entry ? [{ name: words, href: labPath(entry) }] : [];
});
// The scene, the figures under the name, the chapter and the board's Route Lab line all come from
// the build's own solve of the lab's default day (lib/route-lab/picture.ts), as the lab's page
// does, so no figure on Home is typed. Astro's root is the working directory (node-solver.ts).
const routes = demo.get('routes');
const picture = routes ? await routeLabPicture(process.cwd()) : undefined;
const scene = picture && routes ? { picture, href: labPath(routes) } : undefined;
// Selected work's other cards: a project whose check is recorded and whose hold is lifted, and a
// featured post (lib/work.ts). The lab's demos are on the board; a card is what has no line.
const list = await loadSelectedWork();
const demoPages = new Set(lab.entries.map(labPath));
const cards = list.filter((card) => !demoPages.has(card.link.href));
const latest = writingRow(area.published, list);
const linkedIn = checkedProfiles(profile).find((p) => p.network === 'LinkedIn');
---

<Base
  title={`${name} · ${label}`}
  description={homeDescription(profile)}
  path="/"
  og={homeCard(profile)}
  jsonLd={serialize(homeGraph(profile))}
>
  <div class={scene ? 'stage' : 'stage stage-plain'} data-stage>
    {scene && <RouteScene picture={scene.picture} data={`${scene.href}scene.json`} />}
    <Hero
      profile={profile}
      lede={lede}
      figures={
        scene && {
          before: formatDuration(scene.picture.before.measured.drive),
          after: formatDuration(scene.picture.after.measured.drive),
          words: figureWords(scene.picture.day),
        }
      }
      caption={
        scene && {
          done: dayLine(
            scene.picture.after.measured.back,
            scene.picture.day.orders.length,
            scene.picture.day.orders.length,
          ),
          credit: routeData.copyright,
        }
      }
    />
    {(lab.entries.length > 0 || cards.length > 0) && (
      <section class="work" id="work" aria-labelledby="work-title">
        <h2 class="visually-hidden" id="work-title">
          Selected work
        </h2>
        {scene && routes && (
          <RouteChapter
            title={routes.title}
            vans={vanLines(routeData, scene.picture.after.measured)}
            href={scene.href}
          />
        )}
        <div class="covers">
          <Board labs={lab.entries} />
          {cards.map((card) => (
            <WorkCard title={card.title} text={card.text} facts={card.facts} link={card.link} />
          ))}
        </div>
      </section>
    )}
  </div>

  {principles && (
    <section class="section principles" id="how" aria-labelledby="how-title">
      <SectionTitle id="how-title" title={principles.heading} />
      <ul class="principles-list" role="list">
        {principles.principles.map((principle) => (
          <li class="principle">
            <h3 class="principle-lead">{principle.lead}</h3>
            <p class="principle-text">
              {withLinks(principle.text, names).map((run) =>
                typeof run === 'string' ? run : <a href={run.href}>{run.text}</a>,
              )}
            </p>
          </li>
        ))}
      </ul>
    </section>
  )}

  {area.visible && (
    <section class="section" id="writing" aria-labelledby="writing-title">
      <SectionTitle id="writing-title" title="Writing" />
      {latest.length > 0 && <PostList posts={latest} level={3} />}
      <ul class="post-links">
        <li>
          <a href="/writing/">All writing</a>
        </li>
        <li>
          <a href="/rss.xml">RSS feed</a>
        </li>
      </ul>
    </section>
  )}

  {toward && (
    <section class="section toward" id="next" aria-labelledby="next-title">
      <SectionTitle id="next-title" title={toward.heading} />
      <div class="toward-body">
        {toward.paragraphs.map((paragraph) => (
          <p class="toward-text">{paragraph}</p>
        ))}
      </div>
      <a class="toward-mail" href={`mailto:${CONTACT_EMAIL}`}>
        {CONTACT_EMAIL}
      </a>
      {linkedIn && (
        <div class="toward-actions">
          <a class="btn" href={linkedIn.url}>
            {linkedIn.network}
          </a>
        </div>
      )}
    </section>
  )}
  <Motion />
</Base>
