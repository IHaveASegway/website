---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page not found · Joseph Peterson"
  description="There is no page at this address."
  noindex
>
  <section class="border-t border-border pt-8 pb-6 md:pt-16 md:pb-10" aria-labelledby="title">
    <p class="label">Error 404</p>
    <h1 id="title" class="mt-4 text-display text-balance">
      Page not found
    </h1>
    <p class="mt-4 max-w-prose text-lead text-muted-foreground">
      There is no page at this address.
    </p>
    <p class="mt-10">
      <a class="btn" href="/">
        Go to the home page
      </a>
    </p>
  </section>
</Base>
