---
import LabCard from '../../components/lab/LabCard.astro';
import Motion from '../../components/Motion.astro';
import PageHead from '../../components/PageHead.astro';
import Base from '../../layouts/Base.astro';
import { loadLabArea, loadProfile } from '../../lib/content';
import { labIndexCard } from '../../lib/og';
import '../../styles/lab-index.css';

// /lab/, the lab's index (docs/design/overhaul.md, "/lab/"; ADR 0027): the page's head, then a
// card for each live lab, in the lab's order (lib/lab.ts), each with its glyph, the lab's system
// drawn at build from the run its page opens on, its title, its summary and one fact from its
// build (components/lab/LabCard.astro). Two a row from 64rem. A rest parameter, so the page builds
// only while a lab is live, as Writing's indexes build only from the first post (lib/lab.ts); the
// labs' own pages are [demo].astro and raft/, queue/, cache/ and backfill/.
export async function getStaticPaths() {
  const lab = await loadLabArea();
  return lab.visible ? [{ params: { index: undefined } }] : [];
}

const profile = await loadProfile();
const { name } = profile.basics;
const lab = await loadLabArea();
---

<Base
  title={`Lab · ${name}`}
  description={`Demos by ${name} that run in your browser.`}
  path="/lab/"
  og={labIndexCard(profile)}
>
  <section class="page lab-index" aria-labelledby="page-title">
    <PageHead
      heading="Lab"
      lead="Systems you can break in your browser. Each drawing is its lab as its page opens, from the same run."
    />
    <ul class="lab-cards" role="list">
      {lab.entries.map((entry) => (
        <LabCard entry={entry} />
      ))}
    </ul>
  </section>
  <Motion />
</Base>
