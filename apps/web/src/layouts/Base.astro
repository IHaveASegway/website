---
import { Font } from 'astro:assets';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Ruler from '../components/Ruler.astro';
import { loadProfile } from '../lib/content';
import { ogAlt, ogTitle, OG_SIZE, type OgCard } from '../lib/og';
import { THEME_SCRIPT } from '../lib/weights';
import '../styles/global.css';

interface Props {
  /** The document title, as tabs and search results show it. */
  title: string;
  /** One or two sentences for search results and link previews. */
  description: string;
  /** The canonical path, such as "/". A page with no canonical URL (the 404) leaves it out. */
  path?: string;
  /**
   * Keeps the page out of search results. Only the 404 sets it: Workers serves that page with
   * status 404 for unknown paths, but with status 200 at /404 itself, a soft 404 a crawler could index.
   */
  noindex?: boolean;
  /** The link preview: the two strings og.png.ts draws beside this page (lib/og.ts). */
  og?: OgCard;
  /** The footer's build line. Home turns it off: its readout row is the page's telemetry strip. */
  telemetry?: boolean;
  /** Structured data for this page, already serialized (lib/jsonld.ts). */
  jsonLd?: string;
}

const { title, description, path, noindex = false, og, telemetry = true, jsonLd } = Astro.props;
const canonical = path === undefined ? undefined : new URL(path, Astro.site).href;
const image = og && canonical ? new URL('og.png', canonical).href : undefined;
const profile = await loadProfile();

// The theme script (src/scripts/theme.js) runs in <head>, before <body> exists, so no frame can
// paint before a stored choice applies. In <body> it left a gap: when the HTML arrived in pieces,
// a frame came before the script had run (seen on the first Worker Preview). The cost: Astro
// writes the CSP <meta> at the end of <head>, and a <meta> policy covers only what follows it, so
// this one script, ours and generated at build, runs before the policy. Everything after it stays
// covered, and test/csp.test.ts allows exactly this script, byte for byte, before the policy.
// astro.config.mjs still hashes it into script-src, and JSON-LD closes <body>.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <script is:inline set:html={THEME_SCRIPT} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {og && canonical && image && (
      <>
        <meta property="og:type" content="website" />
        <meta property="og:title" content={ogTitle(og)} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={image} />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content={String(OG_SIZE.width)} />
        <meta property="og:image:height" content={String(OG_SIZE.height)} />
        <meta property="og:image:alt" content={ogAlt(og)} />
        <meta name="twitter:card" content="summary_large_image" />
      </>
    )}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Font cssVariable="--font-instrument-sans" preload />
    <Font cssVariable="--font-jetbrains-mono" preload />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <div class="frame">
      <Ruler />
      <Header />
    </div>
    <main id="main" class="frame flex-1">
      <slot />
    </main>
    <Footer profile={profile} telemetry={telemetry} />
    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}
  </body>
</html>
