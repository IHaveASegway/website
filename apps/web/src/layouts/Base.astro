---
import Ruler from '../components/Ruler.astro';
import { builtOn, shortCommit } from '../lib/build';
import '../styles/global.css';

interface Props {
  /** The document title, as tabs and search results show it. */
  title: string;
  /** One or two sentences for search results and link previews. */
  description: string;
  /** The canonical path, such as "/". A page with no canonical URL (the 404) leaves it out. */
  path?: string;
  /**
   * Keeps the page out of search results. Only the 404 sets it: Workers serves that page with
   * status 404 for unknown paths, but with status 200 at /404 itself, a soft 404 a crawler could index.
   */
  noindex?: boolean;
}

const { title, description, path, noindex = false } = Astro.props;
const canonical = path === undefined ? undefined : new URL(path, Astro.site).href;
const isHome = Astro.url.pathname === '/';
// The build's year, so the line never goes stale; each deploy is built once and shipped as tested.
const year = new Date().getUTCFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <div class="frame">
      <Ruler />
      <header class="flex min-h-11 items-center py-3.5 md:py-5">
        <a href="/" aria-current={isHome ? 'page' : undefined} class="wordmark">
          ihaveasegway<span>.com</span>
        </a>
      </header>
    </div>
    <main id="main" class="frame flex-1">
      <slot />
    </main>
    <footer class="frame">
      <div class="mt-14 grid gap-5 border-t border-border pt-7 pb-14 md:mt-22 lg:grid-cols-12 lg:items-end lg:gap-x-7">
        <div class="flex flex-col gap-2.5 lg:col-span-7">
          <p class="label">Contact</p>
          <a
            class="text-h3 wrap-anywhere sm:text-h2 md:text-h1"
            href="mailto:hello@ihaveasegway.com"
          >
            hello@ihaveasegway.com
          </a>
        </div>
        <div class="flex flex-col gap-1 font-mono text-meta text-muted-foreground lg:col-span-5 lg:items-end">
          <p>&copy; {year} Joseph Peterson</p>
          <p>
            build {shortCommit} · built {builtOn}
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
