---
import { Font } from 'astro:assets';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Palette from '../components/Palette.astro';
import { loadLabArea, loadProfile, loadWritingArea } from '../lib/content';
import { labPath, labRoutes } from '../lib/lab';
import { NOINDEX } from '../lib/noindex.mjs';
import { ogAlt, ogTitle, OG_SIZE, type OgCard } from '../lib/og';
import { areaRoutes, postPath } from '../lib/posts';
import { chromeColor } from '../lib/tokens';
import { THEME_SCRIPT } from '../lib/weights';
import tokensCss from '../styles/tokens.css?raw';
import '../styles/global.css';

interface Props {
  /** The document title, as tabs and search results show it. */
  title: string;
  /** One or two sentences for search results and link previews. */
  description: string;
  /** The canonical path, such as "/". A page with no canonical URL (the 404) leaves it out. */
  path?: string;
  /**
   * Keeps the page out of search results. The 404 sets it: Workers serves that page with status 404
   * for unknown paths, but with status 200 at /404 itself, a soft 404 a crawler could index. A draft
   * sets it through Prose.astro. The tag is lib/noindex.mjs's, byte for byte.
   */
  noindex?: boolean;
  /** The link preview: the two strings og.png.ts draws beside this page (lib/og.ts). */
  og?: OgCard;
  /** Open Graph's type: a post is an article; every other page is the website. */
  ogType?: 'website' | 'article';
  /** Structured data for this page, already serialized (lib/jsonld.ts). */
  jsonLd?: string;
  /** The page has a Print button ([data-print]), so the command menu offers it too: /about/. */
  print?: boolean;
  /** The page draws code, so it declares B612 Mono, the face code is set in: a post with a code
   *  span or block (Prose.astro). No other page does. */
  code?: boolean;
}

const {
  title,
  description,
  path,
  noindex = false,
  og,
  ogType = 'website',
  jsonLd,
  print = false,
  code = false,
} = Astro.props;
const canonical = path === undefined ? undefined : new URL(path, Astro.site).href;
const image = og && canonical ? new URL('og.png', canonical).href : undefined;
const profile = await loadProfile();
// Writing's pages and feed exist only from the first published post (lib/posts.ts), and the lab's
// from its first live demo (lib/lab.ts): the header, the footer and the feed link below learn from
// this which of them this build writes.
const area = await loadWritingArea();
const lab = await loadLabArea();
const generated = [...areaRoutes(area), ...labRoutes(lab)];
// The demos and the published posts, each a page these areas build: the command menu finds any of
// them by its words.
const demos = lab.entries.map((entry) => ({
  title: entry.title,
  summary: entry.summary,
  href: labPath(entry),
  line: entry.slug,
}));
const posts = area.published.map((post) => ({
  title: post.title,
  summary: post.summary,
  href: postPath(post),
}));

// The theme script (src/scripts/theme.js) runs in <head>, before <body> exists, so no frame can
// paint before a stored choice applies. In <body> it left a gap: when the HTML arrived in pieces,
// a frame came before the script had run (seen on the first Worker Preview). The page policy is a
// header, written at build with a hash for this script (src/lib/csp.mjs), so it governs the script
// here too: until 2026-10-25 it was a <meta> after it, and this one script ran uncovered. JSON-LD
// closes <body>, as a data block the policy does not govern. The script carries
// no comments, since it ships as written: what it does is told here and in design-system.md
// ("Theme before first paint"). It applies a choice the visitor made in this tab, again when the
// browser restores the page from its back-forward cache, and handles the toggle.

// The faces (docs/design/overhaul.md, "Type"; ADR 0027): every page's first screen sets its name or
// title in Archivo ExtraCondensed ExtraBold, its navigation in Archivo Expanded, its buttons and
// controls in Archivo Condensed SemiBold and its sentences in Archivo, so those four are preloaded.
// Archivo's SemiBold draws <strong> only, so a page fetches it when it sets some, in the fitted
// fallback until then. B612 Mono draws code and nothing else, so only a
// page with code declares it (the code prop): the Route Lab's first view carries no face it never
// draws.

// The skip link sits in the masthead, the top bar's full-width band, which it covers when focused
// (global.css); the bar's own row stands in the frame, so its edges line up with the page's.

// The command menu (components/Palette.astro) follows the footer: a closed <dialog> the page does
// not draw, opened by the top bar's Search, and the one module every page loads
// (src/scripts/palette.js).

// The browser chrome takes the page's background: one theme-color meta per OS scheme, resolved
// from tokens.css at build (lib/tokens.ts). They come before the theme script, which points both
// at a chosen theme's color before the first paint, and again on every press of the toggle.
const chrome = (['dark', 'light'] as const).map((scheme) => ({
  media: `(prefers-color-scheme: ${scheme})`,
  color: chromeColor(tokensCss, scheme),
}));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    {chrome.map(({ media, color }) => (
      <meta name="theme-color" media={media} content={color} />
    ))}
    <script is:inline set:html={THEME_SCRIPT} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <Fragment set:html={NOINDEX} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {og && canonical && image && (
      <>
        <meta property="og:type" content={ogType} />
        <meta property="og:title" content={ogTitle(og)} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={image} />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content={String(OG_SIZE.width)} />
        <meta property="og:image:height" content={String(OG_SIZE.height)} />
        <meta property="og:image:alt" content={ogAlt(og)} />
        <meta name="twitter:card" content="summary_large_image" />
      </>
    )}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {area.visible && (
      <link
        rel="alternate"
        type="application/rss+xml"
        title={`${profile.basics.name}: writing`}
        href="/rss.xml"
      />
    )}
    <Font cssVariable="--font-archivo-display" preload />
    <Font cssVariable="--font-archivo-wide" preload />
    <Font cssVariable="--font-archivo-label" preload />
    <Font cssVariable="--font-archivo" preload={[{ weight: 400 }]} />
    {code && <Font cssVariable="--font-b612-mono" />}
  </head>
  <body>
    <div class="masthead">
      <a class="skip-link" href="#main">
        Skip to content
      </a>
      <div class="frame">
        <Header name={profile.basics.name} generated={generated} />
      </div>
    </div>
    <main id="main" class="frame">
      <slot />
    </main>
    <Footer profile={profile} generated={generated} />
    <Palette profile={profile} generated={generated} demos={demos} posts={posts} print={print} />
    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}
  </body>
</html>
