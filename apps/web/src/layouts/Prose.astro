---
import PageHead from '../components/PageHead.astro';
import type { OgCard } from '../lib/og';
import Base from './Base.astro';
import '../styles/prose.css';

// The long-form layout (ADR 0029): one reading column, centered. The page's one <h1> and its lead,
// then its register, who wrote it and when, on one line under the lead, never a label over the
// title. Then the body in .prose, in the reading face at about 63 characters a line. After the
// body, whatever the page passes in "after". It knows nothing about posts: a page passes its words in, its register in the
// "register" slot, its body in the default slot.

interface Props {
  /** The document title, as tabs and search results show it. */
  title: string;
  /** One or two sentences for search results and link previews. */
  description: string;
  /** The canonical path, such as "/writing/". */
  path: string;
  /** The page's one <h1>. */
  heading: string;
  /** A sentence under the heading. */
  lead?: string;
  /** Keeps the page out of search results and the sitemap: a draft in a preview. */
  noindex?: boolean;
  og?: OgCard;
  ogType?: 'website' | 'article';
  jsonLd?: string;
  /** An article's day, for link previews. */
  published?: string;
}

const {
  title,
  description,
  path,
  heading,
  lead,
  noindex = false,
  og,
  ogType = 'website',
  jsonLd,
  published,
} = Astro.props;
// The body, rendered before the page around it: a body with a code span or block makes the page
// declare JetBrains Mono, the face code is set in, and a body without one leaves it out (Base.astro).
const body = await Astro.slots.render('default');
const code = /<(code|pre)\b/i.test(body);
---

<Base
  title={title}
  description={description}
  path={path}
  noindex={noindex}
  ogType={ogType}
  code={code}
  reading
  {...(published ? { published } : {})}
  {...(og ? { og } : {})}
  {...(jsonLd ? { jsonLd } : {})}
>
  <article class="page long-form" aria-labelledby="page-title">
    <PageHead heading={heading} lead={lead} />
    <slot name="register" />
    <div class="long-form-body">
      <div class="prose">
        <Fragment set:html={body} />
      </div>
    </div>
    <slot name="after" />
  </article>
</Base>
