---
import { cluster, STORY } from '../lib/iso';

// The Raft Lab's five servers, drawn in isometric at build (lib/iso.ts; ADR 0023), acting out an
// election (ADR 0024): server 1 leads term 3 with its roof in the accent and a hollow last entry
// in its log that a majority has not stored yet; every pair of servers is linked on the floor; each
// follower's dial is its election timer, part full, as the lab draws it. With motion, home.css
// plays lib/iso.ts's STORY on one loop: heartbeats, the leader's crash, server 3's timeout, its
// votes, its term as leader and server 1's return. Without motion, and paused, it is the first
// moment of that story. A picture, so screen readers skip it: the words beside it say what it shows
// and link to the lab.
const scene = cluster();
const { leader, candidate, terms } = STORY;
const at = (id: number) =>
  scene.servers.find((server) => server.id === id)?.label ?? { x: 0, y: 0 };
const says = [
  { server: leader, act: 'lead-1', text: `LEADER · TERM ${terms[0]}` },
  { server: leader, act: 'down', text: 'DOWN' },
  { server: candidate, act: 'ask', text: `CANDIDATE · TERM ${terms[1]}` },
  { server: candidate, act: 'lead-3', text: `LEADER · TERM ${terms[1]}` },
];
---

<svg class="iso iso-cluster" viewBox={scene.viewBox} aria-hidden="true" focusable="false">
  <g class="iso-platform">
    <polygon class="iso-face-left" points={scene.platform.left} />
    <polygon class="iso-face-right" points={scene.platform.right} />
    <polygon class="iso-face-top" points={scene.platform.top} />
  </g>
  <path class="iso-floor" d={scene.floor} />
  <path class="iso-link" d={scene.links.join('')} />
  {scene.trips.map((trip) => (
    <g transform={trip.transform}>
      <path class="iso-packet" data-act={trip.act} data-to={trip.to} d={trip.d} />
    </g>
  ))}
  {scene.servers.map((server) => (
    <g class={server.leader ? 'iso-server iso-leader' : 'iso-server'} data-server={server.id}>
      <polygon class="iso-face-left" points={server.faces.left} />
      <polygon class="iso-face-right" points={server.faces.right} />
      <polygon class="iso-face-top" points={server.faces.top} />
      {(server.id === leader || server.id === candidate) && (
        <polygon class="iso-crown" data-crown={server.id} points={server.faces.top} />
      )}
      {server.id === candidate && <polygon class="iso-candidate" points={server.faces.top} />}
      {server.log.map((entry) => (
        <polygon
          class={entry.committed ? 'iso-entry' : 'iso-entry iso-pending'}
          points={entry.cell}
        />
      ))}
      <ellipse
        class="iso-dial-track"
        cx={server.dial.cx}
        cy={server.dial.cy}
        rx={server.dial.rx}
        ry={server.dial.ry}
      />
      <ellipse
        class="iso-dial"
        cx={server.dial.cx}
        cy={server.dial.cy}
        rx={server.dial.rx}
        ry={server.dial.ry}
        pathLength="100"
        stroke-dasharray={`${server.dial.fill} 100`}
      />
      {server.id === candidate && (
        <ellipse
          class="iso-timeout"
          cx={server.dial.cx}
          cy={server.dial.cy}
          rx={server.dial.rx}
          ry={server.dial.ry}
        />
      )}
    </g>
  ))}
  {scene.ripples.map(({ server, ellipse }) => (
    <ellipse
      class="iso-ripple"
      data-ripple={server}
      cx={ellipse.cx}
      cy={ellipse.cy}
      rx={ellipse.rx}
      ry={ellipse.ry}
    />
  ))}
  {says.map(({ server, act, text }) => (
    <text class="iso-label" data-say={act} x={at(server).x} y={at(server).y} text-anchor="middle">
      {text}
    </text>
  ))}
</svg>
