---
import { cluster } from '../lib/iso';

interface Props {
  /** Where it stands: Home's first screen, or the Raft Lab's card. Its heartbeats run with Home's
   *  living ground, under its pause button, in the first; while the card is pointed at or focused
   *  in the second. */
  place: 'hero' | 'card';
}

const { place } = Astro.props;
// The Raft Lab's five servers, drawn in isometric at build (lib/iso.ts; ADR 0023): the leader at
// the back with its roof in the accent, a hollow last entry in its log that a majority has not
// stored yet, and on the floor the links its heartbeats travel. Each follower's dial is its
// election timer, part full, as the lab draws it. A picture, so screen readers skip it: the words
// beside it say what it shows and link to the lab.
const scene = cluster();
---

<svg
  class={`iso iso-cluster iso-${place}`}
  viewBox={scene.viewBox}
  aria-hidden="true"
  focusable="false"
>
  <g class="iso-platform">
    <polygon class="iso-face-left" points={scene.platform.left} />
    <polygon class="iso-face-right" points={scene.platform.right} />
    <polygon class="iso-face-top" points={scene.platform.top} />
  </g>
  {place === 'hero' && <path class="iso-floor" d={scene.floor} />}
  {scene.links.map((link) => (
    <path class="iso-link" d={link.d} />
  ))}
  {scene.packets.map((packet) => (
    <g transform={packet.transform}>
      <path class="iso-packet" d={packet.d} />
    </g>
  ))}
  {scene.servers.map((server) => (
    <g class={server.leader ? 'iso-server iso-leader' : 'iso-server'} data-server={server.id}>
      <polygon class="iso-face-left" points={server.faces.left} />
      <polygon class="iso-face-right" points={server.faces.right} />
      <polygon class="iso-face-top" points={server.faces.top} />
      {server.log.map((entry) => (
        <polygon
          class={entry.committed ? 'iso-entry' : 'iso-entry iso-pending'}
          points={entry.cell}
        />
      ))}
      <ellipse
        class="iso-dial-track"
        cx={server.dial.cx}
        cy={server.dial.cy}
        rx={server.dial.rx}
        ry={server.dial.ry}
      />
      <ellipse
        class="iso-dial"
        cx={server.dial.cx}
        cy={server.dial.cy}
        rx={server.dial.rx}
        ry={server.dial.ry}
        pathLength="100"
        stroke-dasharray={`${server.dial.fill} 100`}
      />
    </g>
  ))}
  <ellipse
    class="iso-ripple"
    cx={scene.ripple.cx}
    cy={scene.ripple.cy}
    rx={scene.ripple.rx}
    ry={scene.ripple.ry}
  />
  {place === 'hero' && (
    <text class="iso-label" x={scene.label.x} y={scene.label.y} text-anchor="middle">
      LEADER · TERM 3
    </text>
  )}
</svg>
