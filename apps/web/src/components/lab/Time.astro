---
import '../../styles/lab-controls.css';
import Choice from './Choice.astro';

interface Props {
  /** The lab's prefix: its app finds each control by it, as data-qu-run. */
  short: 'rf' | 'qu' | 'cl' | 'bf';
  /** How fast Run plays: each value is the lab's own unit, and the words the same in every lab. */
  speeds: readonly { readonly value: string; readonly words: string }[];
  /** The speed the page opens at. */
  speed: string;
  /** What Run says when the lab has something to say of it (the Raft Lab: nothing is scheduled). */
  runSays?: string;
  /** What Start over says, where it's always the same: the Raft Lab's. */
  resetSays?: string;
}

// A lab's Time group, one in the same order on every desk: the clock (the slot, in the lab's own
// units), Run, Next event, Start over and Speed. What each does is the same in every lab too
// (docs/lab.md, "The controls"). Until 2026-11-02 the clock stood under Run in one lab and over it in
// another, and on a phone one lab's Speed was 650 px below its Run. Run is a push-button whose lamp is
// lit while the run is on (the app sets data-lamp): its words change with its state, so it is no
// toggle and has no aria-pressed (WAI-ARIA APG, Button pattern).
const { short, speeds, speed, runSays, resetSays } = Astro.props;
const control = (name: string) => ({ [`data-${short}-${name}`]: '' });
---

<div class="lab-group lab-time" role="group" aria-labelledby={`${short}-time`}>
  <div class="lab-time-head">
    <p class="lab-group-name" id={`${short}-time`}>
      Time
    </p>
    <slot />
  </div>
  <div class="lab-row">
    <button
      type="button"
      class="btn lab-run"
      data-lamp="off"
      data-why={runSays}
      {...control('run')}
    >
      Run
    </button>
    <button type="button" class="btn" {...control('step')}>
      Next event
    </button>
    <button type="button" class="btn" data-why={resetSays} {...control('reset')}>
      Start over
    </button>
    <Choice legend="Speed" name={`${short}-speed`} options={speeds} checked={speed} inline />
  </div>
</div>
