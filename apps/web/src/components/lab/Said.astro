---
interface Props {
  /** What its controls do, which it says until a press has something to say. */
  words: string;
}

// The line under a part of a lab's controls that says what its presses did (lib/lab/said.ts). It
// keeps its room from the first paint. Assistive technology hears the whole of each press from one
// live region elsewhere, so this one is hidden from it.
const { words } = Astro.props;
---

<p class="lab-said" aria-hidden="true" data-said={words}>
  {words}
</p>
