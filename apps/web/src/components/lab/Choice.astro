---
import '../../styles/lab-controls.css';

interface Option {
  readonly value: string;
  /** What the button shows. */
  readonly words: string;
  /** Its whole name, when the button shows less of it: "Mon" is Monday. */
  readonly long?: string;
}

interface Props {
  legend: string;
  name: string;
  options: readonly Option[];
  checked: string;
  /** Its name beside its buttons, not over them: the Time group's Speed, which keeps it low. A
   *  radio group with a name of its own, since browsers disagree on where a fieldset's floated legend
   *  goes: WebKit keeps it over the buttons. */
  inline?: boolean;
}

// A choice on a lab's desk (lab-controls.css, .lab-option), one look and one markup in every lab: a row
// of joined push-buttons, each a native radio that covers its button, so the keyboard's focus is
// drawn around the whole of it, with a lamp after it that is lit while it is chosen. The arrow keys
// move between them, as between any radios. Until 2026-11-02 each lab drew its own, in three looks.
const { legend, name, options, checked, inline = false } = Astro.props;
const Group = inline ? 'div' : 'fieldset';
const Name = inline ? 'span' : 'legend';
const naming = inline ? ({ role: 'radiogroup', 'aria-labelledby': `${name}-name` } as const) : {};
---

<Group class={inline ? 'lab-choice-inline' : 'lab-choice'} {...naming}>
  <Name class="lab-group-name" id={inline ? `${name}-name` : undefined}>
    {legend}
  </Name>
  <div class="lab-options">
    {options.map((option) => (
      <label class="btn lab-option" data-short={option.long ? '' : undefined}>
        <input
          type="radio"
          name={name}
          value={option.value}
          checked={option.value === checked}
          autocomplete="off"
        />
        <span class="lab-option-lamp" />
        {option.long ? <span aria-hidden="true">{option.words}</span> : option.words}
        {option.long && <span class="lab-sr">{option.long}</span>}
      </label>
    ))}
  </div>
</Group>
