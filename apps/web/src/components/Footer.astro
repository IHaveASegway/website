---
import { navFor } from '../lib/nav';
import { checkedProfiles, type Profile } from '../lib/profile';
import { CONTACT_EMAIL } from '../lib/site';

interface Props {
  profile: Profile;
  /** URLs content adds to this build (lib/posts.ts, areaRoutes). */
  generated: readonly string[];
}

const { profile, generated } = Astro.props;
// The footer (docs/design/overhaul.md, "Footer"; ADR 0027): who this is and how to write to him on
// the left, then the links, the pages this build writes (RSS, Colophon, from the manifest's footer
// items) and the external profiles whose readiness check is recorded (rel="me" pairs each with the
// profile's link back to this site), and the copyright, in the build's year, under them. The
// address may break after its "@" when a larger text size leaves it no room on one line, and never
// elsewhere unless a part alone is wider than the screen.
const year = new Date().getUTCFullYear();
const [mailbox, domain] = CONTACT_EMAIL.split('@');
const links = [
  ...navFor('footer', generated).map((item) => ({
    label: item.label,
    href: item.href,
    rel: undefined,
  })),
  ...checkedProfiles(profile).map((p) => ({ label: p.network, href: p.url, rel: 'me' })),
];
---

<footer class="site-foot">
  <div class="frame site-footer">
    <div class="footer-who">
      <p class="footer-name">{profile.basics.name}</p>
      <p class="footer-role">{profile.basics.label}</p>
      <a class="footer-email" href={`mailto:${CONTACT_EMAIL}`}>
        {mailbox}@<wbr />
        {domain}
      </a>
    </div>
    <ul class="footer-links">
      {links.map((link) => (
        <li>
          <a href={link.href} rel={link.rel}>
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    <p class="fine-print">
      © {year} {profile.basics.name}
    </p>
  </div>
</footer>
