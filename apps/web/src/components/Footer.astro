---
import { navFor } from '../lib/nav';
import { checkedProfiles, type Profile } from '../lib/profile';
import { CONTACT_EMAIL } from '../lib/site';

interface Props {
  profile: Profile;
  /** URLs content adds to this build (lib/posts.ts, areaRoutes). */
  generated: readonly string[];
}

const { profile, generated } = Astro.props;
// One line: the address, the pages that exist (RSS, Now, Colophon), the external profiles whose
// readiness check is recorded (rel="me" pairs each with the profile's link back to this site), and
// the copyright, in the build's year.
const year = new Date().getUTCFullYear();
const links = [
  ...navFor('footer', generated).map((item) => ({
    label: item.label,
    href: item.href,
    rel: undefined,
  })),
  ...checkedProfiles(profile).map((p) => ({ label: p.network, href: p.url, rel: 'me' })),
];
---

<footer class="frame">
  <div class="site-footer">
    <a class="footer-email" href={`mailto:${CONTACT_EMAIL}`}>
      {CONTACT_EMAIL}
    </a>
    {links.length > 0 && (
      <ul class="footer-links">
        {links.map((link) => (
          <li>
            <a href={link.href} rel={link.rel}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    )}
    <p class="fine-print">
      © {year} {profile.basics.name}
    </p>
  </div>
</footer>
