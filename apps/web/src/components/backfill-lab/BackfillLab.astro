---
import { DAYS, weekday, when } from '../../lib/backfill/core';
import {
  boardView,
  eventsText,
  LATE_BY,
  lineTime,
  openingRun,
  propertyViews,
  STRIP_HEIGHT,
  stripLabel,
  stripMarkup,
  summary,
  switchWords,
} from '../../lib/backfill/view';
import '../../styles/backfill-lab.css';
import Choice from './Choice.astro';

// The Backfill Lab (ADR 0026): the bakery's report pipeline as a run board, a row a day and a lamp
// a step, drawn at build from the opening run (lib/backfill/view.ts), so the page is complete
// without JavaScript. The controls show only where script runs (backfill-lab.css), and boot.ts
// loads the simulation on the visitor's first intent; it replays the same opening, so it takes over
// exactly where this stands.
//
// It all sits on the lab's desk (ADR 0025; global.css, .desk), in two parts: the picture (the
// board, the lamps' key, the caption, the strip and the checks) and the panel (the controls, then
// the log). The controls that play the week, and the choice that fixes it, come first, so on a
// phone they stand right under the board, and a visitor sees the lamps change as they press;
// on a wide desk the panel is the column beside the picture (backfill-lab.css). Run is a
// push-button whose lamp is lit while the run is on (app.ts sets data-lamp; its words change, so
// it is no toggle and has no aria-pressed).
const sim = openingRun();
const board = boardView(sim);
const checks = propertyViews(sim);
const lines = sim.lines.slice(-60);

/** The steps' column heads: the first word stays on a phone, the rest joins it on a wider desk. */
const STEPS = [
  { word: 'Wait', rest: ' for the file' },
  { word: 'Extract', rest: '' },
  { word: 'Convert', rest: '' },
  { word: 'Load', rest: '' },
  { word: 'Check', rest: '' },
];
/** Virtual minutes a second of real time: about 20 seconds for the opening's week at Steady. */
const SPEEDS = [
  { value: '2', words: 'Slow' },
  { value: '6', words: 'Steady' },
  { value: '30', words: 'Quick' },
];
const MODES = [
  { value: 'append', words: 'Append rows' },
  { value: 'overwrite', words: 'Overwrite the day' },
];
const PARTITIONS = [
  { value: 'run-day', words: "The run's own day" },
  { value: 'today', words: 'Today, by the clock' },
];
const days = Array.from({ length: DAYS }, (_, day) => day);
const RUNS = days.map((day) => ({
  value: String(day + 1),
  words: String(day + 1),
  long: `${day + 1} ${day === 0 ? 'run' : 'runs'} at once`,
}));
const PICKS = days.map((day) => ({
  value: String(day),
  words: weekday(day).slice(0, 3),
  long: weekday(day),
}));
/** A failed step's mark, a cross inside its lamp's ring, as the board's lines draw a failed
 *  station (lines.css, .line-cross), so a cross in a ring means failed wherever it stands. */
const CROSS = 'M-3.5-3.5l7 7m0-7-7 7';
const KEY = [
  { lamp: 'hollow', word: 'Not started' },
  { lamp: 'lit', word: 'Running' },
  { lamp: 'filled', word: 'Succeeded' },
  { lamp: 'cross', word: 'Failed' },
  { lamp: 'clock', word: 'Waiting to retry, at the time under it' },
  { lamp: 'dash', word: 'Not run, as a step before it failed' },
];
---

<div class="bf desk" id="backfill-lab">
  <div class="bf-stage">
    <div class="bf-picture">
      <div
        class="bf-board-box"
        role="region"
        aria-labelledby="bf-board-name"
        aria-describedby="bf-summary"
        tabindex="0"
      >
        <table class="bf-board" data-bf-board>
          <caption class="bf-sr" id="bf-board-name">
            The run board: a row for each day, and a lamp for each step of its run
          </caption>
          <thead>
            <tr>
              <th scope="col" class="bf-col-day">
                <span class="bf-sr">Day</span>
              </th>
              {STEPS.map((step) => (
                <th scope="col" class="bf-col-step">
                  <span class="bf-col-name">
                    {step.word}
                    {step.rest && <span class="bf-col-rest">{step.rest}</span>}
                  </span>
                </th>
              ))}
              <th scope="col" class="bf-col-num">
                Report
              </th>
              <th scope="col" class="bf-col-num">
                Source
              </th>
            </tr>
          </thead>
          <tbody>
            {board.days.map((day) => (
              <tr data-bf-day={day.day}>
                <th scope="row" class="bf-day">
                  <span class="bf-day-name" aria-hidden="true">
                    {day.short}
                  </span>
                  <span class="bf-sr">{day.long}</span>
                  <span class="bf-run" data-bf-run-word>
                    {day.run}
                  </span>
                </th>
                {day.steps.map((step, i) => (
                  <td class="bf-step" data-lamp={step.lamp} data-bf-step={i}>
                    <svg class="bf-lamp" viewBox="-11 -11 22 22" aria-hidden="true">
                      <circle class="bf-plate" r="9" />
                      <circle class="bf-halo" r="9" />
                      <circle class="bf-disc" r="6" />
                      <path class="bf-x" d={CROSS} />
                      <path class="bf-hands" d="M0-3.5V0h3" />
                      <path class="bf-dash" d="M-4.5 0h9" />
                    </svg>
                    <span class="bf-sr" data-bf-word>
                      {step.word}
                    </span>
                    <span class="bf-retry" aria-hidden="true" data-bf-retry>
                      {step.retry}
                    </span>
                  </td>
                ))}
                <td class="bf-num">
                  <span data-bf-report>{day.report}</span>
                  <span class="bf-diff" data-bf-diff>
                    {day.difference}
                  </span>
                </td>
                <td class="bf-num" data-bf-source>
                  {day.source}
                </td>
              </tr>
            ))}
          </tbody>
          <tfoot>
            <tr class="bf-stray" data-bf-stray hidden={board.stray === null}>
              <th scope="row" class="bf-day">
                <span class="bf-day-name" aria-hidden="true" data-bf-stray-short>
                  {board.stray?.short}
                </span>
                <span class="bf-sr" data-bf-stray-long>
                  {board.stray?.long}
                </span>
                <span class="bf-run">after the week</span>
              </th>
              <td class="bf-note" colspan="5">
                Filed here by the clock
              </td>
              <td class="bf-num" data-bf-stray-rows>
                {board.stray?.rows}
              </td>
              <td class="bf-num" />
            </tr>
            <tr class="bf-week">
              <th scope="row" class="bf-day">
                <span class="bf-day-name">Week</span>
              </th>
              <td colspan="5" />
              <td class="bf-num">
                <span data-bf-week-report>{board.week.report}</span>
                <span class="bf-diff" data-bf-week-diff>
                  {board.week.difference}
                </span>
              </td>
              <td class="bf-num" data-bf-week-source>
                {board.week.source}
              </td>
            </tr>
          </tfoot>
        </table>
      </div>

      <ul class="bf-key" aria-label="What the lamps mean" role="list">
        {KEY.map((item) => (
          <li data-lamp={item.lamp}>
            <svg class="bf-lamp" viewBox="-11 -11 22 22" aria-hidden="true">
              <circle class="bf-plate" r="9" />
              <circle class="bf-halo" r="9" />
              <circle class="bf-disc" r="6" />
              <path class="bf-x" d={CROSS} />
              <path class="bf-hands" d="M0-3.5V0h3" />
              <path class="bf-dash" d="M-4.5 0h9" />
            </svg>
            {item.word}
          </li>
        ))}
      </ul>

      <p class="bf-summary" id="bf-summary" data-bf-summary>
        {summary(sim)}
      </p>

      <div class="bf-strip-part">
        <p class="bf-strip-title">
          Over time, each day's steps: a hollow bar is a sensor waiting for its file, a filled one a
          step at work, and a cross an attempt that failed. A dotted track with nothing on it is a
          run waiting for a slot or a retry, and the upright line is now.
        </p>
        <div class="bf-strip-box">
          <ol class="bf-strip-days" aria-hidden="true">
            {days.map((day) => (
              <li>{weekday(day).slice(0, 3)}</li>
            ))}
          </ol>
          <svg
            class="bf-strip"
            height={STRIP_HEIGHT}
            role="img"
            aria-label={stripLabel(sim)}
            data-bf-strip
            set:html={stripMarkup(sim)}
          />
        </div>
      </div>

      <section class="bf-checks-block" aria-labelledby="bf-checks">
        <h2 class="bf-heading" id="bf-checks">
          Checked after every event
        </h2>
        <ul class="bf-checks" aria-labelledby="bf-checks" role="list">
          {checks.map((check) => (
            <li
              class="bf-check"
              data-bf-check={check.id}
              data-lamp={check.held ? 'filled' : 'cross'}
            >
              <svg class="bf-lamp" viewBox="-11 -11 22 22" aria-hidden="true">
                <circle class="bf-plate" r="9" />
                <circle class="bf-disc" r="6" />
                <path class="bf-x" d={CROSS} />
              </svg>
              <span>
                <span class="bf-check-name">{check.name}</span>
                <span class="bf-check-word" data-bf-check-word>
                  {check.word}
                </span>
              </span>
            </li>
          ))}
        </ul>
      </section>
    </div>

    <div class="bf-panel">
      <div class="bf-controls bf-play" data-bf-js>
        <p class="bf-clock">
          <span data-bf-clock>{when(sim.now)}</span>, <span data-bf-events>{eventsText(sim)}</span>,
          seed <span data-bf-seed>{sim.seed}</span>
        </p>
        <div class="bf-row" role="group" aria-label="Time">
          <button type="button" class="btn bf-run-button" data-lamp="off" data-bf-run>
            Run
          </button>
          <button type="button" class="btn" data-bf-step>
            Next event
          </button>
          <button type="button" class="btn" data-bf-reset>
            Start over
          </button>
          <Choice legend="Speed" name="bf-speed" options={SPEEDS} checked="6" />
        </div>
        <div class="bf-row" role="group" aria-label="Its loads">
          <Choice legend="How a load writes" name="bf-mode" options={MODES} checked={sim.mode} />
        </div>
        <p class="bf-sr" role="status" data-bf-said></p>
      </div>

      <div class="bf-controls bf-more" data-bf-js>
        <div class="bf-row" role="group" aria-label="The job">
          <button
            type="button"
            class="btn bf-switch"
            aria-disabled={sim.on ? 'true' : undefined}
            data-bf-on
          >
            {switchWords(sim)}
          </button>
          <Choice
            legend="Runs at once"
            name="bf-runs"
            options={RUNS}
            checked={String(sim.maxActiveRuns)}
          />
        </div>
        <div class="bf-row" role="group" aria-label="Where its loads write">
          <Choice
            legend="Which day a load writes"
            name="bf-partition"
            options={PARTITIONS}
            checked={sim.partition}
          />
        </div>
        <div class="bf-row" role="group" aria-label="One day">
          <Choice legend="Day" name="bf-day" options={PICKS} checked="0" />
          <button type="button" class="btn" data-bf-fail>
            <span>
              Fail <span data-bf-picked>{weekday(0)}</span>'s next load
            </span>
          </button>
          <button type="button" class="btn" data-bf-late>
            <span>
              Make <span data-bf-picked>{weekday(0)}</span>'s file {LATE_BY / 60} hours late
            </span>
          </button>
          <button type="button" class="btn" data-bf-clear>
            <span>
              Clear <span data-bf-picked>{weekday(0)}</span> and rerun it
            </span>
          </button>
        </div>
      </div>

      <div class="bf-events">
        <h2 class="bf-heading" id="bf-events">
          What happened
        </h2>
        <div class="bf-lines" role="log" aria-live="off" aria-labelledby="bf-events" tabindex="0">
          <ol class="bf-list" data-bf-lines>
            {lines.map((line) => (
              <li>
                <span class="bf-at">{lineTime(line.at)}</span> {line.text}
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import './boot';
</script>
