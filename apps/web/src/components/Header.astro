---
import { navFor } from '../lib/nav';
import Keys from './Keys.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  /** The name the header links home with. */
  name: string;
  /** URLs content adds to this build (lib/posts.ts, areaRoutes). */
  generated: readonly string[];
}

const { name, generated } = Astro.props;
// The top bar (docs/design/overhaul.md, "Top nav"; ADR 0027), the same on every page and at every
// width: it replaces the rail of ADR 0021. The wordmark links home, on Home too, where it is the
// page itself; then the manifest's header items whose page exists (Lab, Writing, About); then the
// tools: Search, which opens the command menu (components/Palette.astro), Home's motion button
// while its scene runs (SC 2.2.2), and the theme toggle. One row, 56 px, at every width: on a phone
// the wordmark is its tile and Search its glass, each still named in words for assistive
// technology, so the three items stay in sight and nothing hides behind a menu button. The current
// item is marked by a 2 px rule in the accent under it, and aria-current names it: the page
// itself, or a page inside the section (/lab/routes/ marks Lab, a post marks Writing).
const headerNav = navFor('header', generated);
const here = Astro.url.pathname;
const home = here === '/';
---

<header class="site-header">
  <a href="/" class="wordmark" aria-current={home ? 'page' : undefined}>
    <svg class="wordmark-tile" viewBox="0 0 20 12" aria-hidden="true" focusable="false">
      <path d="M10 .75 19 6l-9 5.25L1 6z" />
    </svg>
    <span class="wordmark-name">{name}</span>
  </a>
  {headerNav.length > 0 && (
    <nav class="site-nav" aria-label="Primary">
      <ul>
        {headerNav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={
                here === item.href ? 'page' : here.startsWith(item.href) ? 'true' : undefined
              }
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )}
  <ul class="header-tools">
    <li class="palette-item">
      <button
        type="button"
        class="search-open"
        data-palette-open
        aria-haspopup="dialog"
        aria-keyshortcuts="Meta+K Control+K"
      >
        <svg class="search-glass" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <circle cx="7" cy="7" r="4.75" />
          <path d="m10.5 10.5 3.75 3.75" />
        </svg>
        <span class="search-word">Search</span> <Keys />
      </button>
    </li>
    {home && (
      <li class="motion-item">
        <button
          type="button"
          class="motion-toggle"
          data-motion-toggle
          aria-label="Pause motion"
          title="Pause motion"
        >
          <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <path class="motion-pause" d="M4.5 3h2.25v10H4.5zM9.25 3h2.25v10H9.25z" />
            <path class="motion-play" d="M5 2.75v10.5L13.25 8z" />
          </svg>
        </button>
      </li>
    )}
    <li>
      <ThemeToggle />
    </li>
  </ul>
</header>
