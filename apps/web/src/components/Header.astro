---
import { navFor, type NavLeaf } from '../lib/nav';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  /** The name the header links home with. */
  name: string;
  /** The title under the name, in the rail only. */
  role: string;
  /** URLs content adds to this build (lib/posts.ts, areaRoutes). */
  generated: readonly string[];
  /** What the rail lists under a header item, by its id: every demo under Lab, the newest posts
   *  under Writing (lib/nav.ts, railLeaves). */
  leaves: Readonly<Record<string, readonly NavLeaf[]>>;
}

const { name, role, generated, leaves } = Astro.props;
// The name, linking home, with the title under it in the rail; then the manifest's header items
// whose page exists (Writing, from the first post), the command menu's button, on Home the button
// that pauses its moving drawing (SC 2.2.2), and the theme toggle. From 80rem the header is the
// rail down the left edge (ADR 0021), and an index of the site (ADR 0022): the name heads it on
// every page, Home included, a search field opens the command menu, and each item lists what it
// holds, every demo under Lab and the newest posts under Writing. Below 80rem it is the row across
// the top it always was, without the leaves, and on Home without the name, which Home's <h1> is.
const headerNav = navFor('header', generated);
const here = Astro.url.pathname;
const home = here === '/';
---

<header class="site-header">
  <div class={home ? 'rail-head rail-only' : 'rail-head'}>
    <a href="/" class={home ? 'home-mark' : 'wordmark'} aria-current={home ? 'page' : undefined}>
      {name}
    </a>
    <p class="rail-role">{role}</p>
  </div>
  <div class="header-end">
    <button
      type="button"
      class="rail-search rail-only"
      data-palette-open
      aria-haspopup="dialog"
      aria-keyshortcuts="Meta+K Control+K"
    >
      <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        <circle cx="7" cy="7" r="4.75" />
        <path d="m10.5 10.5 3.75 3.75" />
      </svg>
      <span>{'Search '}</span>
      <kbd>Ctrl K</kbd>
    </button>
    {headerNav.length > 0 && (
      <nav class="site-nav" aria-label="Primary">
        <ul>
          {headerNav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={
                  here === item.href ? 'page' : here.startsWith(item.href) ? 'true' : undefined
                }
              >
                {item.label}
              </a>
              {(leaves[item.id] ?? []).length > 0 && (
                <ul class="nav-leaves rail-only">
                  {(leaves[item.id] ?? []).map((leaf) => (
                    <li>
                      <a href={leaf.href} aria-current={here === leaf.href ? 'page' : undefined}>
                        {leaf.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </nav>
    )}
    <ul class="header-tools">
      <li class="palette-item">
        <button
          type="button"
          class="palette-open"
          data-palette-open
          aria-haspopup="dialog"
          aria-keyshortcuts="Meta+K Control+K"
        >
          <span class="palette-name">{'Command menu '}</span>
          <kbd>Ctrl K</kbd>
        </button>
      </li>
      {home && (
        <li class="motion-item">
          <button
            type="button"
            class="motion-toggle"
            data-motion-toggle
            aria-label="Pause motion"
            title="Pause motion"
          >
            <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
              <path class="motion-pause" d="M4.5 3h2.25v10H4.5zM9.25 3h2.25v10H9.25z" />
              <path class="motion-play" d="M5 2.75v10.5L13.25 8z" />
            </svg>
          </button>
        </li>
      )}
      <li>
        <ThemeToggle />
      </li>
    </ul>
  </div>
</header>
