---
// The ruler across the top of every page: the twelve columns the layout sits on, numbered over a
// tick band. It is decoration, so assistive technology skips it. Phones show the first four.
const columns = Array.from({ length: 12 }, (_, i) => String(i + 1).padStart(2, '0'));
---

<div class="ruler" aria-hidden="true">
  {columns.map((n) => (
    <span>{n}</span>
  ))}
</div>
