---
import { checkedProfiles, locationLine, type Profile } from '../lib/profile';
import { CONTACT_EMAIL } from '../lib/site';

interface Props {
  profile: Profile;
  /** Where the Work button scrolls to: Selected work, when Home has it. Left out, no button. */
  work?: string | undefined;
  /** The bio's opening, Joseph's own words (src/content/about.md), and the page it opens. Left out
   *  where the build holds no bio, as the fixture builds do: then the hero has no sentence. */
  bio?: { readonly lede: readonly string[]; readonly href: string } | undefined;
}

const { profile, work, bio } = Astro.props;
// External profiles render only from a record whose readiness check is recorded (profile.ts).
const external = checkedProfiles(profile);
// Row 1 (design-system.md, "Home, row by row"): the name on two lines, then the title, the
// location, what Joseph does in his own words and the ways to reach him. The name's markup is its
// words alone. The sentence is the bio's opening, which Joseph cleared with the bio on 2026-10-29
// (content.md, row 1), so Home and /about/ say it from one file (ADR 0023).
---

<section class="hero hero-home" aria-labelledby="name" data-row="1">
  <h1 id="name" class="hero-name">
    {profile.basics.name}
  </h1>
  <div class="hero-side">
    <div class="hero-who">
      <p class="hero-title">{profile.basics.label}</p>
      <p class="where">{locationLine(profile)}</p>
    </div>
    {bio?.lede.map((paragraph) => (
      <p class="hero-lede">{paragraph}</p>
    ))}
    <div class="hero-actions">
      <a class="btn btn-primary" href={`mailto:${CONTACT_EMAIL}`}>
        Email
      </a>
      {bio && (
        <a class="btn" href={bio.href}>
          About me{' '}
          <span class="hint" aria-hidden="true">
            →
          </span>
        </a>
      )}
      {work && (
        <a class="btn" href={work}>
          Work{' '}
          <span class="hint" aria-hidden="true">
            ↓
          </span>
        </a>
      )}
      {external.map((p) => (
        <a class="btn" href={p.url} rel="me">
          {p.network}{' '}
          <span class="hint" aria-hidden="true">
            ↗
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
