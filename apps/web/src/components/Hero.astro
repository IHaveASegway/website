---
import { checkedProfiles, roleLine, type Profile } from '../lib/profile';
import { CONTACT_EMAIL } from '../lib/site';

interface Props {
  profile: Profile;
  /** The bio's opening, Joseph's own words (src/content/about.md). Left out where the build holds
   *  no bio, as the fixture builds do: then the column has no sentence. */
  lede?: readonly string[] | undefined;
  /** The Route Lab's result, from the build's own solve: the day's driving as the orders came in
   *  and as VROOM plans it, and the words under them. Left out where the Route Lab does not build. */
  figures?: { readonly before: string; readonly after: string; readonly words: string } | undefined;
  /** The scene's caption: where its day stands once every van is back, which the picture shows,
   *  and the map's source, credited under the ODbL. The scene's clock counts the day in its place
   *  while the vans drive. Left out with the scene. */
  caption?: { readonly done: string; readonly credit: string } | undefined;
}

const { profile, lede = [], figures, caption } = Astro.props;
// External profiles render only from a record whose readiness check is recorded (profile.ts).
const external = checkedProfiles(profile);
// The column over the water (ADR 0025), one order for the markup and the keyboard: the name on two
// lines, the role in a sentence, the bio's opening, the Route Lab's result, the ways to reach him,
// and the scene's caption. Below 64rem the name, the role and the buttons lead and the map's band
// follows them (home.css places each item; the order stays this one). Each button is its words
// alone: no arrows. The sentence is the bio's opening, which Joseph cleared with the bio on
// 2026-10-29 (content.md, row 1), so Home and /about/ say it from one file (ADR 0023).
---

<section class="hero hero-home" aria-labelledby="name" data-row="1">
  <h1 id="name" class="hero-name">
    {profile.basics.name}
  </h1>
  <p class="hero-title">{roleLine(profile)}</p>
  {lede.length > 0 && (
    <div class="hero-lede">
      {lede.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>
  )}
  {figures && (
    <p class="figures">
      <s class="figure-before">{figures.before}</s>
      <span class="visually-hidden"> of driving as the orders came in, now </span>
      <span class="figure-after">{figures.after}</span>
      <span class="figure-words">{figures.words}</span>
    </p>
  )}
  <div class="hero-actions">
    <a class="btn btn-primary btn-email" href={`mailto:${CONTACT_EMAIL}`}>
      Email {CONTACT_EMAIL}
    </a>
    {external.map((p) => (
      <a class="btn" href={p.url} rel="me">
        {p.network}
      </a>
    ))}
  </div>
  {caption && (
    <p class="hero-caption">
      <span class="scene-clock">
        <span class="scene-clock-done">{caption.done}</span>
        <span class="scene-clock-live" data-scene-clock aria-hidden="true"></span>
      </span>
      <span class="scene-credit">
        Map data © <a href={caption.credit}>OpenStreetMap contributors</a>.
      </span>
    </p>
  )}
</section>
