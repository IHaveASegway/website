---
import { inWords, raftLine } from '../../../lib/lines';
import { openingRun, statusText } from '../../../lib/raft/view';
import type { LineAt } from '../line-of';
import '../../../styles/lines.css';

interface Props {
  /** Home's board, the default, or the Lab index (line-of.ts). */
  at?: LineAt;
}

// The Raft Lab's line (ADR 0025): a hub and its spokes, not a ring. The leader is the hub, a
// filled lamp with its number; every other server sits on a spoke, a hollow lamp with its number,
// since each one answers to the leader alone. Then the log runs out to the right as a track of
// lamps, filled once a majority holds the entry, so it is committed. All of it from the Raft Lab's
// opening run (lib/raft/view.ts), the run its own page draws before anyone presses anything. It
// stands still: the board's one moving thing is the Route Lab's vans. Drawn twice, for a narrow
// screen and a wide one, without a viewBox, as the Route Lab's line is (routes.astro). On the board
// its describer says who leads; on the Lab index it is larger, names its stations, comes in from
// the page's edge, and says what the run proved: the properties held over its events.
const { at = 'board' } = Astro.props;
const run = openingRun();
const line = raftLine(run);
const words = at === 'board' ? line.words : statusText(run);

const SIZES = {
  board: [
    {
      name: 'wide',
      height: 80,
      hub: 96,
      reach: [44, 24],
      leader: 14,
      server: 11.5,
      log: 190,
      step: 30,
      lamp: 6,
      numbers: true,
      labels: false,
    },
    {
      name: 'compact',
      height: 56,
      hub: 60,
      reach: [30, 17],
      leader: 9,
      server: 6.5,
      log: 116,
      step: 18,
      lamp: 4,
      numbers: false,
      labels: false,
    },
  ],
  index: [
    {
      name: 'wide',
      height: 128,
      hub: 70,
      reach: [54, 32],
      leader: 18,
      server: 13,
      log: 204,
      step: 38,
      lamp: 8,
      numbers: true,
      labels: true,
    },
    {
      name: 'compact',
      height: 56,
      hub: 40,
      reach: [30, 17],
      leader: 9,
      server: 6.5,
      log: 96,
      step: 18,
      lamp: 4,
      numbers: false,
      labels: false,
    },
  ],
} as const;

// The followers' places around the hub: upper left, upper right, lower right, lower left.
const AROUND = [
  [-1, -1],
  [1, -1],
  [1, 1],
  [-1, 1],
] as const;

// On the index the track comes in from past the drawing's left edge, as the Route Lab's does.
const enters = at === 'index' ? '-100%' : '0';
// The stations the index names: the servers, the log's first lamp, and its first lamp not yet
// committed, when there is room between the two for both names.
const servers = `${inWords(run.servers.length).replace(/^./, (c) => c.toUpperCase())} servers`;
const pending = line.log.indexOf(false);
const drawings = SIZES[at].map((size) => {
  const middle = size.height / 2;
  const [dx, dy] = size.reach;
  const followers = line.followers.slice(0, AROUND.length).map((id, i) => {
    const [sx, sy] = AROUND[i] ?? [1, 1];
    return { id, x: size.hub + sx * dx, y: middle + sy * dy };
  });
  const under = middle + size.lamp + 17;
  return { size, middle, followers, under, below: middle + dy + size.server + 15 };
});
---

<div class="line line-raft">
  {drawings.map(({ size, middle, followers, under, below }) => (
    <svg
      class={`line-draw line-${size.name}`}
      height={size.height}
      aria-hidden="true"
      focusable="false"
    >
      <line class="line-track" x1={enters} y1={middle} x2="100%" y2={middle} />
      {followers.map((f) => (
        <line class="line-spoke" x1={size.hub} y1={middle} x2={f.x} y2={f.y} />
      ))}
      {line.log.map((committed, k) => (
        <>
          <circle class="line-lamp" cx={size.log + k * size.step} cy={middle} r={size.lamp} />
          {committed && (
            <circle
              class="line-lamp-lit"
              cx={size.log + k * size.step}
              cy={middle}
              r={size.lamp + 1}
              data-lit=""
            />
          )}
        </>
      ))}
      {followers.map((f) => (
        <>
          <circle class="line-lamp" cx={f.x} cy={f.y} r={size.server} />
          {size.numbers && (
            <text class="line-number" x={f.x} y={f.y}>
              {f.id}
            </text>
          )}
        </>
      ))}
      {line.leader !== null && (
        <>
          <circle class="line-hub" cx={size.hub} cy={middle} r={size.leader} />
          {size.numbers && (
            <text class="line-number line-number-lit" x={size.hub} y={middle}>
              {line.leader}
            </text>
          )}
        </>
      )}
      {size.labels && (
        <>
          <text class="line-label line-label-middle" x={size.hub} y={below}>
            {servers}
          </text>
          {line.log.length > 0 && (
            <text class="line-label line-label-middle" x={size.log} y={under}>
              Log entry 1
            </text>
          )}
          {pending >= 3 && (
            <text class="line-label line-label-middle" x={size.log + pending * size.step} y={under}>
              Not yet committed
            </text>
          )}
        </>
      )}
    </svg>
  ))}
</div>
<p class={at === 'board' ? 'band-words' : 'lab-fact'}>{words}</p>
