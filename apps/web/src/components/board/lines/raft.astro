---
import { RAFT_SIZES, raftShape } from '../../../lib/line-shapes';
import { inWords, raftFailover, raftLine } from '../../../lib/lines';
import { replay } from '../../../lib/raft/sim';
import { OPENING, openingRun, statusText } from '../../../lib/raft/view';
import type { LineAt } from '../line-of';
import '../../../styles/lines.css';

interface Props {
  /** Home's board, the default, or the Lab index (line-of.ts). */
  at?: LineAt;
}

// The Raft Lab's line (ADR 0025): a hub and its spokes, not a ring. The leader is the hub, a
// filled lamp with its number; every other server sits on a spoke, a hollow lamp with its number,
// since each one answers to the leader alone. Then the log runs out to the right as a track of
// lamps, filled once a majority holds the entry, so it is committed. The track ends a step past
// the last entry in a buffer stop, the log's end, as every other line ends at a station of its
// own; until 2026-10-31 it ran on into the panel's edge and read as cut off. All of it from the
// Raft Lab's opening run (lib/raft/view.ts), the run its own page draws before anyone presses
// anything. It stands still: the board's one moving thing is the Route Lab's vans. Drawn twice,
// for a narrow screen and a wide one, without a viewBox, as the Route Lab's line is (routes.astro).
// On the board its describer says who leads, and what happens when that leader crashes: the same
// opening replayed with the crash, until another server leads; on the Lab index it is larger,
// names its stations, comes in from the page's edge, and says what the run proved: the properties
// held over its events. Where everything stands, at each size, is lib/line-shapes.ts, which the
// link previews draw too.
const { at = 'board' } = Astro.props;
const run = openingRun();
const line = raftLine(run);
const crashed = () =>
  replay(
    { seed: OPENING.seed },
    [...OPENING.actions, { at: OPENING.until, kind: 'crash', node: (line.leader ?? 0) - 1 }],
    OPENING.until,
  );
const words = at === 'board' ? `${line.words} ${raftFailover(run, crashed())}` : statusText(run);

// On the index the track comes in from past the drawing's left edge, as the Route Lab's does.
const enters = at === 'index' ? '-100%' : '0';
// The stations the index names: the servers, the log's first lamp, and its first lamp not yet
// committed, when there is room between the two for both names.
const servers = `${inWords(run.servers.length).replace(/^./, (c) => c.toUpperCase())} servers`;
const pending = line.log.indexOf(false);
const drawings = RAFT_SIZES[at].map((size) => {
  const shape = raftShape(line, size);
  // The names' baselines: under the log's lamps, and under the lower spokes' servers.
  const under = shape.middle + size.lamp + 17;
  const below = shape.middle + size.reach[1] + size.server + 15;
  return { ...shape, under, below };
});
---

<div class="line line-raft">
  {drawings.map(({ size, middle, leader, followers, log, under, end, below }) => (
    <svg
      class={`line-draw line-${size.name}`}
      height={size.height}
      aria-hidden="true"
      focusable="false"
    >
      <line class="line-track" x1={enters} y1={middle} x2={end} y2={middle} />
      <rect
        class="line-depot"
        x={end}
        y={middle - size.stop[1] / 2}
        width={size.stop[0]}
        height={size.stop[1]}
      />
      {followers.map((f) => (
        <line class="line-spoke" x1={size.hub} y1={middle} x2={f.x} y2={f.y} />
      ))}
      {log.map((entry) => (
        <>
          <circle class="line-lamp" cx={entry.x} cy={middle} r={size.lamp} />
          {entry.lamp === 'filled' && (
            <circle class="line-lamp-lit" cx={entry.x} cy={middle} r={size.lamp + 1} data-lit="" />
          )}
        </>
      ))}
      {followers.map((f) => (
        <>
          <circle class="line-lamp" cx={f.x} cy={f.y} r={size.server} />
          {size.numbers && (
            <text class="line-number" x={f.x} y={f.y}>
              {f.id}
            </text>
          )}
        </>
      ))}
      {leader !== null && (
        <>
          <circle class="line-hub" cx={size.hub} cy={middle} r={size.leader} />
          {size.numbers && (
            <text class="line-number line-number-lit" x={size.hub} y={middle}>
              {leader}
            </text>
          )}
        </>
      )}
      {size.labels && (
        <>
          <text class="line-label line-label-middle" x={size.hub} y={below}>
            {servers}
          </text>
          {log.length > 0 && (
            <text class="line-label line-label-middle" x={size.log} y={under}>
              Log entry 1
            </text>
          )}
          {pending >= 3 && (
            <text class="line-label line-label-middle" x={size.log + pending * size.step} y={under}>
              Not yet committed
            </text>
          )}
        </>
      )}
    </svg>
  ))}
</div>
<p class={at === 'board' ? 'band-words' : 'lab-fact'}>{words}</p>
