---
import { QUEUE_SIZES, queueShape } from '../../../lib/line-shapes';
import { queueFix, queueLine } from '../../../lib/lines';
import { replay } from '../../../lib/queue/sim';
import { OPENING, openingRun } from '../../../lib/queue/view';
import '../../../styles/lines.css';

// The Queue Lab's line (ADR 0025): the publisher, a square at the left; the broker's queue, a tank
// of lamps on the stem, one for each order waiting; then a fork to each worker's track, its lamp
// lit while it works on an order, hollow while idle, and while it is down no lamp at all, its track
// hollow, as the lab's desk draws it (design-system.md, "Lamps: one meaning per mark"); and below
// them the siding of dead letters, which ends in a buffer stop. All of it from the Queue Lab's
// opening run (lib/queue/view.ts), the run its own page draws before anyone presses anything:
// worker 2 down after its crash. It stands still: the board's one moving thing is the Route Lab's
// vans. Drawn twice, for a narrow screen and a wide one, without a viewBox, as the Route Lab's line
// is (routes.astro): everything up to the fork in pixels, the tracks after it in shares of the
// width. On the board its describer says what the crash did and what the idempotency key does about
// it. Where everything stands, at each size, is lib/line-shapes.ts, which the link previews draw
// too.
const line = queueLine(openingRun());
const keyed = replay({ ...OPENING.config, key: true }, OPENING.actions, OPENING.until);
const words = `${line.words} ${queueFix(keyed)}`;

const drawings = QUEUE_SIZES.board.map((size) => queueShape(line, size));
---

<div class="line line-queue">
  {drawings.map(({ size, middle, fork, tracks, waiting, letters }) => (
    <svg
      class={`line-draw line-${size.name}`}
      height={size.height}
      aria-hidden="true"
      focusable="false"
    >
      <line class="line-track" x1="0" y1={middle} x2={size.depot} y2={middle} />
      <line class="line-track" x1={size.depot + size.side} y1={middle} x2={fork} y2={middle} />
      {tracks.map((track) => (
        <>
          <line class="line-track" x1={fork} y1={middle} x2={fork + track.rise} y2={track.y} />
          <line
            class="line-track"
            x1={fork + track.rise}
            y1={track.y}
            x2={`${track.dead ? size.stop : size.end}%`}
            y2={track.y}
          />
        </>
      ))}
      <rect
        class="line-depot"
        x={size.depot}
        y={middle - size.side / 2}
        width={size.side}
        height={size.side}
      />
      {waiting.map((x) => (
        <circle class="line-lamp" cx={x} cy={middle} r={size.lamp} />
      ))}
      {tracks.map((track) =>
        track.dead ? (
          <svg x={`${size.stop}%`} overflow="visible">
            <rect
              class="line-depot"
              x="0"
              y={track.y - size.station}
              width={size.side / 3}
              height={size.station * 2}
            />
            {letters.map((x) => (
              <circle class="line-lamp-lit" cx={x} cy={track.y} r={size.lamp + 1} data-lit="" />
            ))}
            {size.labels && (
              <text class="line-label" x={size.side / 3 + 10} y={track.y + 4.5}>
                {track.name}
              </text>
            )}
          </svg>
        ) : (
          <>
            {track.lamp === 'down' ? (
              <line
                class="line-gap"
                x1={track.hollow}
                y1={track.y}
                x2={`${size.end}%`}
                y2={track.y}
              />
            ) : (
              <circle
                class={track.lamp === 'lit' ? 'line-now' : 'line-lamp'}
                cx={`${size.worker}%`}
                cy={track.y}
                r={size.station}
              />
            )}
            {size.labels && (
              <svg x={`${size.end}%`} overflow="visible">
                <text class="line-label" x="10" y={track.y + 4.5}>
                  {track.name}
                </text>
              </svg>
            )}
          </>
        ),
      )}
    </svg>
  ))}
</div>
<p class="band-words">{words}</p>
