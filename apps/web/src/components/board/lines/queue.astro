---
import { queueFact, queueLine, TANK } from '../../../lib/lines';
import { replay } from '../../../lib/queue/sim';
import { OPENING, openingRun } from '../../../lib/queue/view';
import type { LineAt } from '../line-of';
import '../../../styles/lines.css';

interface Props {
  /** Home's board, the default, or the Lab index (line-of.ts). */
  at?: LineAt;
}

// The Queue Lab's line (ADR 0025): the publisher, a square at the left; the broker's queue, a tank
// of lamps on the stem, one for each order waiting; then a fork to each worker's track, its lamp
// lit while it works on an order, hollow while idle, crossed while it is down; and below them the
// siding of dead letters, which ends in a buffer stop. All of it from the Queue Lab's opening run
// (lib/queue/view.ts), the run its own page draws before anyone presses anything: worker 2 down
// after its crash. It stands still: the board's one moving thing is the Route Lab's vans. Drawn
// twice, for a narrow screen and a wide one, without a viewBox, as the Route Lab's line is
// (routes.astro): everything up to the fork in pixels, the tracks after it in shares of the width.
// On the board its describer says what the crash did; on the Lab index it is larger, names its
// stations, comes in from the page's edge, and says what the idempotency key changes.
const { at = 'board' } = Astro.props;
const line = queueLine(openingRun());
const words =
  at === 'board'
    ? line.words
    : queueFact(replay({ ...OPENING.config, key: true }, OPENING.actions, OPENING.until));

interface Size {
  readonly name: 'wide' | 'compact';
  /** Its height, and the space between the tracks after the fork. */
  readonly height: number;
  readonly gap: number;
  /** The publisher's left edge and side, the tank's first lamp and the space between its lamps. */
  readonly depot: number;
  readonly side: number;
  readonly tank: number;
  readonly step: number;
  /** Where a worker's lamp stands and its track ends, in percent; the siding's buffer stop. */
  readonly worker: number;
  readonly end: number;
  readonly stop: number;
  /** A waiting order's lamp and a worker's, by radius. */
  readonly lamp: number;
  readonly station: number;
  readonly labels: boolean;
}

const SIZES: Record<LineAt, readonly Size[]> = {
  board: [
    {
      name: 'wide',
      height: 96,
      gap: 21,
      depot: 40,
      side: 14,
      tank: 70,
      step: 16,
      worker: 62,
      end: 82,
      stop: 74,
      lamp: 5,
      station: 8,
      labels: true,
    },
    {
      name: 'compact',
      height: 64,
      gap: 13,
      depot: 16,
      side: 10,
      tank: 34,
      step: 9,
      worker: 72,
      end: 94,
      stop: 86,
      lamp: 3,
      station: 5,
      labels: false,
    },
  ],
  // Made, as the Route Lab's is, for a column of 30rem at the least beside the words from 64rem,
  // and the whole column of a phone below 48rem.
  index: [
    {
      name: 'wide',
      height: 128,
      gap: 26,
      depot: 0,
      side: 16,
      tank: 34,
      step: 18,
      worker: 58,
      end: 72,
      stop: 66,
      lamp: 6,
      station: 10,
      labels: true,
    },
    {
      name: 'compact',
      height: 64,
      gap: 13,
      depot: 0,
      side: 10,
      tank: 18,
      step: 9,
      worker: 70,
      end: 94,
      stop: 86,
      lamp: 3,
      station: 5,
      labels: false,
    },
  ],
};

// On the index the stem comes in from past the drawing's left edge, as the Route Lab's does.
const enters = at === 'index' ? '-100%' : '0';
const rows = [
  ...line.workers.map((w) => ({ ...w, dead: false })),
  { name: 'Dead letters', lamp: 'hollow', dead: true },
];
const drawings = SIZES[at].map((size) => {
  const middle = size.height / 2;
  // The fork stands past the tank's last place, so a fuller queue never reaches it.
  const fork = size.tank + (TANK - 1) * size.step + size.lamp + 12;
  const tracks = rows.map((row, i) => {
    const y = Math.round(middle + (i - (rows.length - 1) / 2) * size.gap);
    return { ...row, y, rise: Math.abs(y - middle) };
  });
  const waiting = Array.from({ length: line.waiting }, (_, k) => size.tank + k * size.step);
  return { size, middle, fork, tracks, waiting };
});
---

<div class="line line-queue">
  {drawings.map(({ size, middle, fork, tracks, waiting }) => (
    <svg
      class={`line-draw line-${size.name}`}
      height={size.height}
      aria-hidden="true"
      focusable="false"
    >
      <line class="line-track" x1={enters} y1={middle} x2={size.depot} y2={middle} />
      <line class="line-track" x1={size.depot + size.side} y1={middle} x2={fork} y2={middle} />
      {tracks.map((track) => (
        <>
          <line class="line-track" x1={fork} y1={middle} x2={fork + track.rise} y2={track.y} />
          <line
            class="line-track"
            x1={fork + track.rise}
            y1={track.y}
            x2={`${track.dead ? size.stop : size.end}%`}
            y2={track.y}
          />
        </>
      ))}
      <rect
        class="line-depot"
        x={size.depot}
        y={middle - size.side / 2}
        width={size.side}
        height={size.side}
      />
      {waiting.map((x) => (
        <circle class="line-lamp" cx={x} cy={middle} r={size.lamp} />
      ))}
      {tracks.map((track) =>
        track.dead ? (
          <svg x={`${size.stop}%`} overflow="visible">
            <rect
              class="line-depot"
              x="0"
              y={track.y - size.station}
              width={size.side / 3}
              height={size.station * 2}
            />
            {Array.from({ length: line.dead }, (_, k) => (
              <circle
                class="line-lamp-lit"
                cx={-(k + 1) * size.step}
                cy={track.y}
                r={size.lamp + 1}
                data-lit=""
              />
            ))}
            {size.labels && (
              <text class="line-label" x={size.side / 3 + 10} y={track.y + 4.5}>
                {track.name}
              </text>
            )}
          </svg>
        ) : (
          <>
            <circle
              class={track.lamp === 'lit' ? 'line-now' : 'line-lamp'}
              cx={`${size.worker}%`}
              cy={track.y}
              r={size.station}
            />
            {track.lamp === 'cross' && (
              <svg x={`${size.worker}%`} overflow="visible">
                <path
                  class="line-cross"
                  d={`M${-size.station * 0.6} ${track.y - size.station * 0.6}l${size.station * 1.2} ${size.station * 1.2}m0 ${-size.station * 1.2}l${-size.station * 1.2} ${size.station * 1.2}`}
                />
              </svg>
            )}
            {size.labels && (
              <svg x={`${size.end}%`} overflow="visible">
                <text class="line-label" x="10" y={track.y + 4.5}>
                  {track.name}
                </text>
              </svg>
            )}
          </>
        ),
      )}
      {size.labels && at === 'index' && (
        <>
          <text class="line-label" x="0" y={middle - 13}>
            Publisher
          </text>
          <text
            class="line-label line-label-middle"
            x={size.tank + ((TANK - 1) * size.step) / 2}
            y={middle + size.lamp + 18}
          >
            Queue
          </text>
        </>
      )}
    </svg>
  ))}
</div>
<p class={at === 'board' ? 'band-words' : 'lab-fact'}>{words}</p>
