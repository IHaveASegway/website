---
import { openingRun } from '../../../lib/backfill/view';
import { BACKFILL_SIZES, backfillShape } from '../../../lib/line-shapes';
import { backfillFact, backfillFix, backfillLine } from '../../../lib/lines';
import type { LineAt } from '../line-of';
import '../../../styles/lines.css';

interface Props {
  /** Home's board, the default, or the Lab index (line-of.ts). */
  at?: LineAt;
}

// The Backfill Lab's line (ADR 0025): the week runs along the top, a station for each day's run,
// and from each one a drop to the report's track below, which ends in the report, a square: every
// run writes its own day into the one table. A day's lamp is its run on the lab's own run board,
// filled once every step succeeded, crossed once a step failed or its check found the totals
// apart, and the describer says "failed" beside it (design-system.md, "Lamps: one meaning per
// mark"), lit while a step runs, hollow before. All of it from the Backfill Lab's opening run
// (lib/backfill/view.ts), the week its own page draws before anyone presses anything, where
// Wednesday is counted twice. It stands still: the board's one moving thing is the Route Lab's
// vans. Drawn twice, for a narrow screen and a wide one, without a viewBox, as the Route Lab's
// line is (routes.astro): heights in pixels, the days and the report in shares of the width. On
// the board its describer names the day that failed and what loads that overwrite their day do
// about it; on the Lab index it is larger, names its stations, comes in from the page's edge, and
// says what those loads give, in figures. Where everything stands, at each size, is
// lib/line-shapes.ts, which the link previews draw too.
const { at = 'board' } = Astro.props;
const appended = openingRun();
const overwritten = openingRun('overwrite');
const line = backfillLine(appended);
const words =
  at === 'board'
    ? `${line.words} ${backfillFix(overwritten)}`
    : backfillFact(appended, overwritten);

// On the index the week comes in from past the drawing's left edge, as the Route Lab's track does.
const enters = at === 'index' ? '-100%' : '0';
const drawings = BACKFILL_SIZES[at].map((size) => backfillShape(line, size));
---

<div class="line line-backfill">
  {drawings.map(({ size, days }) => (
    <svg
      class={`line-draw line-${size.name}`}
      height={size.height}
      aria-hidden="true"
      focusable="false"
    >
      <line
        class="line-track"
        x1={enters}
        y1={size.week}
        x2={`${days.at(-1)?.x ?? size.to}%`}
        y2={size.week}
      />
      {days.map((day) => (
        <line
          class="line-spoke"
          x1={`${day.x}%`}
          y1={size.week}
          x2={`${day.x}%`}
          y2={size.report}
        />
      ))}
      <line
        class="line-track"
        x1={`${days[0]?.x ?? size.from}%`}
        y1={size.report}
        x2={`${size.table}%`}
        y2={size.report}
      />
      <rect
        class="line-depot"
        x={`${size.table}%`}
        y={size.report - size.side / 2}
        width={size.side}
        height={size.side}
      />
      {days.map((day) => (
        <>
          <circle
            class={day.lamp === 'lit' ? 'line-now' : 'line-lamp'}
            cx={`${day.x}%`}
            cy={size.week}
            r={size.lamp}
          />
          {day.lamp === 'filled' && (
            <circle
              class="line-lamp-lit"
              cx={`${day.x}%`}
              cy={size.week}
              r={size.lamp + 1}
              data-lit=""
            />
          )}
          {day.lamp === 'cross' && (
            <svg x={`${day.x}%`} overflow="visible">
              <path
                class="line-cross"
                d={`M${-size.lamp * 0.6} ${size.week - size.lamp * 0.6}l${size.lamp * 1.2} ${size.lamp * 1.2}m0 ${-size.lamp * 1.2}l${-size.lamp * 1.2} ${size.lamp * 1.2}`}
              />
            </svg>
          )}
          {size.labels && (
            <text
              class="line-label line-label-middle"
              x={`${day.x}%`}
              y={size.week - size.lamp - 10}
            >
              {day.name}
            </text>
          )}
        </>
      ))}
      {size.labels && (
        <svg x={`${size.table}%`} overflow="visible">
          <text class="line-label" x={size.side + 10} y={size.report + 4.5}>
            Report
          </text>
        </svg>
      )}
    </svg>
  ))}
</div>
<p class={at === 'board' ? 'band-words' : 'lab-fact'}>{words}</p>
