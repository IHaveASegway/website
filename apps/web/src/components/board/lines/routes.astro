---
import { ROUTES_SIZES, routesShape } from '../../../lib/line-shapes';
import { routesLine, routesWords } from '../../../lib/lines';
import { routeLabPicture } from '../../../lib/route-lab/picture';
import '../../../styles/lines.css';

// The Route Lab's line (ADR 0025): the bakery, a square depot at the left, and a track forking out
// to each van, its stops as lamps placed by when the van reaches them in the build's solve of the
// lab's default day, so van 3's short run ends early and van 2's long one runs to the end. A
// filled lamp is an order delivered, a hollow one an order still on board; the van itself is the
// lit lamp. The still drawing shows the middle of its day (lib/lines.ts, MIDDAY); styles/board.css
// moves it, one van a stop a second, on Home. Drawn twice, for a narrow screen and a wide one,
// each without a viewBox: a track's height and a lamp's size are pixels and its place along the day
// a share of the width, so nothing scales with the screen and a lamp stays round. On the board the
// line starts at the panel's edge and its describer gives the day's driving as the orders came in
// and as VROOM plans it, the failure and its fix. Until ADR 0027 the Lab index drew it too, larger;
// the index draws each lab's glyph now (components/iso/Glyph.astro).
// Where everything stands, at each size, is lib/line-shapes.ts, which the link previews draw too.
const picture = await routeLabPicture(process.cwd());
const line = routesLine(picture.after.measured);
const words = routesWords(picture.day, picture.before.measured, picture.after.measured);

const drawings = ROUTES_SIZES.board.map((size) => routesShape(line, size));
---

<div class="line line-routes" data-vans={line.vans.length}>
  {drawings.map(({ size, middle, vans }) => (
    <svg
      class={`line-draw line-${size.name}`}
      height={size.height}
      aria-hidden="true"
      focusable="false"
    >
      <line class="line-track" x1="0" y1={middle} x2={size.depot} y2={middle} />
      {vans.map((van) => (
        <>
          <path
            class="line-track"
            d={`M${size.depot + size.side} ${middle}H${size.fork}L${size.fork + van.rise} ${van.y}`}
          />
          <line
            class="line-track"
            x1={size.fork + van.rise}
            y1={van.y}
            x2={`${van.back}%`}
            y2={van.y}
          />
        </>
      ))}
      <rect
        class="line-depot"
        x={size.depot}
        y={middle - size.side / 2}
        width={size.side}
        height={size.side}
      />
      {size.bakery !== null && (
        <text class="line-label" x={size.bakery} y={middle - 13}>
          Bakery
        </text>
      )}
      {vans.map((van, row) => (
        <g class="line-van" data-van={row}>
          <svg x={`${van.back}%`} overflow="visible">
            <circle class="line-loop" cx={size.loop} cy={van.y} r={size.loop} />
            {size.vans && (
              <text class="line-label" x={size.loop * 2 + 10} y={van.y + 4.5}>
                {van.name}
              </text>
            )}
          </svg>
          {van.stops.map((stop, k) => (
            <>
              <circle class="line-lamp" cx={`${stop.x}%`} cy={van.y} r={size.lamp} />
              <circle
                class="line-lamp-lit"
                cx={`${stop.x}%`}
                cy={van.y}
                r={size.lamp + 1}
                data-k={k + 1}
                data-lit={stop.lamp === 'filled' ? '' : undefined}
              />
            </>
          ))}
          {[van.head, ...van.stops.map((stop) => stop.x)].map((x, k) => (
            <circle
              class="line-van-at"
              cx={`${x}%`}
              cy={van.y}
              r={size.van}
              data-k={k}
              data-here={k === van.now ? '' : undefined}
            />
          ))}
          <svg x={`${van.back}%`} overflow="visible">
            <circle
              class="line-van-at line-van-back"
              cx={size.loop}
              cy={van.y}
              r={size.van}
              data-k={van.stops.length + 1}
              data-here={van.now === van.stops.length + 1 ? '' : undefined}
            />
          </svg>
        </g>
      ))}
    </svg>
  ))}
</div>
<p class="band-words">{words}</p>
