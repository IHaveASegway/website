---
import { replay } from '../../../lib/cache/sim';
import { OPENING, openingRun } from '../../../lib/cache/view';
import { CACHE_SIZES, cacheShape } from '../../../lib/line-shapes';
import { cacheFix, cacheLine } from '../../../lib/lines';
import '../../../styles/lines.css';

// The Cache Lab's line (ADR 0025): the readers come in from the left and fan out to the four cache
// nodes, each a filled lamp while it is up, and while it is down no lamp, its track hollow, as the
// lab's desk draws it (design-system.md, "Lamps: one meaning per mark"); the nodes' tracks fan in
// to the database, a square, and its pool runs on from it as a track of lamps, one per connection,
// lit while a fetch runs on it. All of it from the Cache Lab's opening run (lib/cache/view.ts), the
// run its own page draws before anyone presses anything, as it stands once the menu's stampede has
// passed. It stands still: the board's one moving thing is the Route Lab's vans. Drawn twice, for a
// narrow screen and a wide one, without a viewBox, as the Route Lab's line is (routes.astro): the
// fork in pixels, the nodes and the join in shares of the width, the database and its pool in
// pixels from the join. On the board its describer tells the stampede and what coalescing does
// about it. Where everything stands, at each size, is lib/line-shapes.ts, which the link previews
// draw too.
const opening = openingRun();
const line = cacheLine(opening);
const coalesced = replay({ ...OPENING.config, coalesce: true }, OPENING.actions, OPENING.until);
const words = `${line.words} ${cacheFix(opening, coalesced)}`;

const drawings = CACHE_SIZES.board.map((size) => cacheShape(line, size));
---

<div class="line line-cache">
  {drawings.map(({ size, middle, nodes, meet, database, pool }) => (
    <svg
      class={`line-draw line-${size.name}`}
      height={size.height}
      aria-hidden="true"
      focusable="false"
    >
      <line class="line-track" x1="0" y1={middle} x2={size.fork} y2={middle} />
      {nodes.map((node) => (
        <>
          <line
            class="line-track"
            x1={size.fork}
            y1={middle}
            x2={size.fork + node.rise}
            y2={node.y}
          />
          <line
            class="line-track"
            x1={size.fork + node.rise}
            y1={node.y}
            x2={`${size.join}%`}
            y2={node.y}
          />
        </>
      ))}
      <svg x={`${size.join}%`} overflow="visible">
        {nodes.map((node) => (
          <path class="line-track" d={`M0 ${node.y}H${meet - node.rise}L${meet} ${middle}`} />
        ))}
        <line
          class="line-track"
          x1={meet}
          y1={middle}
          x2={pool.at(-1)?.x ?? database}
          y2={middle}
        />
        <rect
          class="line-depot"
          x={database}
          y={middle - size.side / 2}
          width={size.side}
          height={size.side}
        />
        {pool.map((connection) => (
          <circle
            class={connection.lamp === 'lit' ? 'line-now' : 'line-lamp'}
            cx={connection.x}
            cy={middle}
            r={size.lamp}
          />
        ))}
      </svg>
      {nodes.map((node) => (
        <>
          {node.lamp === 'down' ? (
            <line class="line-gap" x1={node.hollow} y1={node.y} x2={`${size.join}%`} y2={node.y} />
          ) : (
            <circle class="line-lamp" cx={`${size.node}%`} cy={node.y} r={size.station} />
          )}
          {node.lamp === 'filled' && (
            <circle
              class="line-lamp-lit"
              cx={`${size.node}%`}
              cy={node.y}
              r={size.station + 1}
              data-lit=""
            />
          )}
        </>
      ))}
    </svg>
  ))}
</div>
<p class="band-words">{words}</p>
