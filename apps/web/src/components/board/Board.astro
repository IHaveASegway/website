---
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import type { LabEntry } from '../../lib/lab';
import { labPath } from '../../lib/lab';
import '../../styles/board.css';

interface Props {
  /** The live labs, in the lab's own order (lib/lab.ts, labArea). */
  labs: readonly LabEntry[];
}

// Home's board (ADR 0025): every live lab as a line on one panel, recessed in the page in a bezel.
// A band per lab, in the lab's order, each the lab's title, its line drawn as its mechanism and a
// describer in plain words, and each a link to the lab: its title's link stretches over the band,
// as a row of an index does (ADR 0022). A lab's line is the component in ./lines/ named by its
// slug, so a new lab joins the board by adding its line there and nothing else; a lab without one
// is not drawn, and a board with no line is not drawn at all. The board is the page's only place
// for the labs' lines on Home; the Lab index draws the same components.
const LINES = import.meta.glob<{ default: AstroComponentFactory }>('./lines/*.astro', {
  eager: true,
});
const lineOf = (slug: string) => LINES[`./lines/${slug}.astro`]?.default;
const { labs } = Astro.props;
const bands = labs.flatMap((lab) => {
  const Line = lineOf(lab.slug);
  return Line ? [{ lab, Line }] : [];
});
---

{bands.length > 0 && (
  <div class="board" data-board>
    <h3 class="visually-hidden">Lab</h3>
    <p class="board-intro">
      Every line is a system that runs in your browser. Follow one to break it.
    </p>
    <ul class="board-lines" role="list">
      {bands.map(({ lab, Line }) => (
        <li class="band" data-line={lab.slug}>
          <a class="band-title" href={labPath(lab)}>
            {lab.title}
          </a>
          <Line />
        </li>
      ))}
    </ul>
  </div>
)}
