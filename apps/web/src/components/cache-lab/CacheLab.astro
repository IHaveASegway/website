---
import { DATABASE, NODES, seconds } from '../../lib/cache/core';
import type { Toggle } from '../../lib/cache/sim';
import {
  clockWords,
  mapWords,
  menuWords,
  nodeWords,
  OPENING,
  openingRun,
  outcomeStrip,
  pageState,
  propertyLines,
  readersWords,
  stripWords,
  summary,
  waiting,
} from '../../lib/cache/view';
import { LINES_SHOWN } from '../../lib/lab/event-log';
import '../../styles/cache-lab.css';
import Choice from '../lab/Choice.astro';
import EventLog from '../lab/EventLog.astro';
import NoScript from '../lab/NoScript.astro';
import Said from '../lab/Said.astro';
import Time from '../lab/Time.astro';
import {
  fanPath,
  LANES,
  linkPath,
  pageLamps,
  roomLamps,
  STRIP,
  STRIP_BASES,
  stripEnds,
  stripPaths,
} from './picture';

// The Cache Lab: readers, four cache nodes and the database behind them, drawn at build from the
// opening run (lib/cache/view.ts), so the page is complete without JavaScript. The controls show
// only where script runs (cache-lab.css), and boot.ts loads the simulation; it replays the same
// opening, so it takes over exactly where this stands.
//
// It all sits on the lab's desk (ADR 0027; styles/lab-page.css, .desk), the event log under a
// rule from bezel to bezel.
//
// The panel comes straight after the map and its caption, and its first part is Time and the
// switches against a stampede, so on a phone the map and the buttons that work it share one
// screen: a press and what it does are seen together. There the strip and the checks come
// next, and the other settings last (cache-lab.css); from 64rem the panel stands in the right
// column beside the three, as it always has. Each part of the panel says what its presses did
// (lib/lab/said.ts).
const sim = openingRun();
const buckets = outcomeStrip(sim);
const bars = stripPaths(buckets);
const [stripFrom, stripTo] = stripEnds(buckets, sim.now);
const lines = sim.lines
  .slice(-LINES_SHOWN)
  .map((line) => ({ at: seconds(line.at), text: line.text }));
const nodes = Array.from({ length: NODES }, (_, id) => id);
// How fast virtual time runs (virtual seconds a second), how many readers ask, and how pages are
// placed on the nodes.
const SPEEDS = [
  { value: '0.1', words: 'Slow' },
  { value: '0.5', words: 'Steady' },
  { value: '2', words: 'Quick' },
];
const LOADS = [
  { value: 'calm', words: 'Calm' },
  { value: 'busy', words: 'Busy' },
  { value: 'morning', words: 'Morning rush' },
];
const PLACEMENTS = [
  { value: 'circle', words: 'Hash circle' },
  { value: 'modulo', words: 'Modulo' },
];
// The key to a page's lamp, in the order a page goes through them.
const legend = [
  { state: 'fresh', name: 'fresh' },
  { state: 'stale', name: 'expired' },
  { state: 'missing', name: 'missing' },
  { state: 'fetching', name: 'being fetched' },
];
const mitigations: { toggle: Toggle; name: string }[] = [
  { toggle: 'coalesce', name: 'Coalesce misses' },
  { toggle: 'stale', name: 'Serve stale while refreshing' },
  { toggle: 'early', name: 'Refresh early' },
  { toggle: 'jitter', name: 'Jitter expiry times' },
];
---

<div class="cl desk" id="cache-lab" data-cl-opening={JSON.stringify(OPENING)}>
  <div class="cl-stage">
    <figure class="cl-figure">
      <div class="cl-map" role="img" aria-label={mapWords(sim)} data-cl-map>
        <div class="cl-map-head">
          <p class="cl-readers" data-cl-readers>
            {readersWords(sim)}
          </p>
          <p class="cl-menu-line">
            <span class="cl-lamp cl-menu-lamp" data-cl-menu-lamp data-state={pageState(sim, 0)} />
            <span data-cl-menu>{menuWords(sim)}</span>
          </p>
        </div>
        <svg class="cl-fan" viewBox="0 0 100 400" preserveAspectRatio="none">
          {nodes.map((id) => (
            <g data-cl-fan={id} data-up={String(sim.nodes[id]?.up)}>
              <path class="cl-track" d={fanPath(id)} />
              <path class="cl-gap" d={fanPath(id)} />
            </g>
          ))}
        </svg>
        <ol class="cl-nodes" role="list">
          {nodes.map((id) => (
            <li class="cl-node" data-cl-node={id} data-up={String(sim.nodes[id]?.up)}>
              <div class="cl-box">
                <p class="cl-node-head">
                  <span class="cl-node-name">Node {id + 1}</span>
                  <span class="cl-node-words" data-cl-node-words>
                    {nodeWords(sim, id)}
                  </span>
                </p>
                <div class="cl-room">
                  <p class="cl-pages" data-cl-pages={id} set:html={pageLamps(sim, id)} />
                  <p class="cl-room-pages" aria-hidden="true" set:html={roomLamps()} />
                </div>
              </div>
            </li>
          ))}
        </ol>
        <svg class="cl-links" viewBox="0 0 100 400" preserveAspectRatio="none">
          {nodes.map((id) => (
            <g data-cl-link={id} data-up={String(sim.nodes[id]?.up)}>
              <path class="cl-track" d={linkPath(id)} />
              <path class="cl-gap" d={linkPath(id)} />
            </g>
          ))}
        </svg>
        <div class="cl-db">
          <p class="cl-db-name">Database</p>
          <div class="cl-db-row">
            <p class="cl-conns" data-cl-conns>
              {Array.from({ length: DATABASE.pool }, (_, i) => (
                <span class="cl-lamp cl-conn" data-state={i < sim.running ? 'busy' : 'idle'} />
              ))}
            </p>
            <p class="cl-waiting">
              <span class="cl-count" data-cl-waiting>
                {waiting(sim).toLocaleString('en-US')}
              </span>
              <span>waiting</span>
            </p>
          </div>
        </div>
        <p class="cl-legend">
          <span class="cl-legend-name">A node’s dots are its pages:</span>
          {legend.map((item) => (
            <span class="cl-legend-item">
              <span class="cl-lamp" data-state={item.state} />
              {item.name}
            </span>
          ))}
        </p>
      </div>

      <figcaption class="lab-caption cl-summary" data-cl-summary>
        {summary(sim)}
      </figcaption>
      <NoScript />
    </figure>

    <div class="cl-panel" data-cl-js>
      <div class="cl-deck" data-part>
        <Time short="cl" speeds={SPEEDS} speed="0.5">
          <p class="lab-clock cl-clock" data-cl-clock>
            {clockWords(sim)}
          </p>
        </Time>

        <div
          class="lab-group"
          role="group"
          aria-labelledby="cl-mitigations"
          aria-describedby="cl-mitigations-note"
        >
          <p class="lab-group-name" id="cl-mitigations">
            Against a stampede
          </p>
          <div class="lab-row">
            {mitigations.map((m) => (
              <button
                type="button"
                class="btn"
                data-cl-toggle={m.toggle}
                aria-pressed={sim[m.toggle] ? 'true' : 'false'}
              >
                {m.name}
              </button>
            ))}
          </div>
          <p class="cl-note" id="cl-mitigations-note">
            Coalesce misses: one reader fetches a fresh copy and the rest wait for it. Serve stale
            while refreshing: readers get the old copy while one fetch gets a fresh one. Refresh
            early: a busy page gets fetched before it expires. Jitter expiry times: pages fetched
            together expire apart, which shows after a flush.
          </p>
        </div>
        <Said words="Press a switch against the stampede, and the run starts over under it, before the same expiry." />
      </div>

      <div class="cl-settings" data-part>
        <Choice legend="Load" name="cl-load" options={LOADS} checked={sim.load} />
        <Choice
          legend="Placement"
          name="cl-placement"
          options={PLACEMENTS}
          checked={sim.placement}
        />

        <div class="lab-group" role="group" aria-labelledby="cl-writes">
          <p class="lab-group-name" id="cl-writes">
            Writes
          </p>
          <div class="lab-row">
            <button
              type="button"
              class="btn"
              data-cl-toggle="invalidate"
              aria-pressed={sim.invalidate ? 'true' : 'false'}
            >
              Invalidate on write
            </button>
            <button type="button" class="btn" data-cl-write>
              Write to the menu
            </button>
          </div>
        </div>

        <div class="lab-group" role="group" aria-labelledby="cl-nodes">
          <p class="lab-group-name" id="cl-nodes">
            Nodes
          </p>
          <div class="cl-node-buttons">
            {nodes.map((id) => (
              <button
                type="button"
                class="btn"
                data-cl-lose={id}
                aria-label={`Lose node ${id + 1}, now up, ${nodeWords(sim, id)}`}
              >
                Lose node {id + 1}
              </button>
            ))}
            <button type="button" class="btn cl-flush" data-cl-flush>
              Flush every node
            </button>
          </div>
        </div>
        <Said words="These change the run as it stands." />
      </div>
      <p class="lab-sr" role="status" data-cl-said></p>
    </div>

    <div class="cl-strip" role="img" aria-label={stripWords(sim)} data-cl-strip>
      <ul class="cl-lanes" role="list">
        {LANES.map((lane) => (
          <li>{lane.name}</li>
        ))}
      </ul>
      <svg
        class="cl-bars"
        viewBox={`0 0 ${STRIP.width} ${STRIP.lane * LANES.length}`}
        preserveAspectRatio="none"
      >
        <path class="cl-base" d={STRIP_BASES} />
        {LANES.map(({ outcome }) => (
          <path class="cl-bar" data-cl-lane={outcome} d={bars[outcome]} />
        ))}
        <path class="cl-wait" data-cl-lane="pending" d={bars['pending']} />
      </svg>
      <p class="cl-axis">
        <span data-cl-from>{stripFrom}</span>
        <span data-cl-to>{stripTo}</span>
      </p>
      <p class="cl-strip-key">
        <span class="cl-wait-key"></span>
        Reads still waiting
      </p>
    </div>

    <section class="lab-group cl-checks" aria-labelledby="cl-checks">
      <h2 class="lab-heading" id="cl-checks">
        Checked as the run goes
      </h2>
      <ul class="lab-checks" role="list">
        {propertyLines(sim).map((p) => (
          <li class="lab-check" data-cl-prop={p.id} data-held={String(p.held)}>
            <span class="lab-check-lamp" aria-hidden="true" />
            <span class="lab-check-name">{p.name}</span>
            <span class="lab-check-word" data-cl-prop-words>
              {p.words}
            </span>
          </li>
        ))}
      </ul>
    </section>
  </div>

  <div class="cl-events">
    <EventLog short="cl" lines={lines} />
  </div>
</div>

<script>
  import './boot';
</script>
