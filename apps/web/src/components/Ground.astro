---
import { GROUND_BOX, groundFor, type GroundKind } from '../lib/ground';

interface Props {
  kind: GroundKind;
}

// Page geometry (design-system.md, "Page geometry"): a picture with nothing to say to assistive
// technology, so it is hidden from it, and it takes no pointer. Classes, never style attributes:
// the page policy refuses inline styles (security.md).
const { kind } = Astro.props;
const ground = groundFor(kind);
const classOf = {
  line: 'ground-line',
  index: 'ground-index',
  mark: 'ground-mark',
} as const;
---

<svg
  class="ground"
  data-ground={kind}
  viewBox={`0 0 ${GROUND_BOX.width} ${GROUND_BOX.height}`}
  preserveAspectRatio="xMaxYMin slice"
  aria-hidden="true"
  focusable="false"
>
  {ground.paths.map((path) => (
    <path class={classOf[path.kind]} d={path.d} />
  ))}
</svg>
