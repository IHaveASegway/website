---
import Time from '../lab/Time.astro';
import { PROPERTIES } from '../../lib/raft/check';
import {
  cutFence,
  DIAL_RADIUS,
  eventsWords,
  flightsMarkup,
  logMarkup,
  LOG_LINES,
  logWords,
  NODE_RADIUS,
  openingRun,
  place,
  PROMISES,
  propertyWord,
  ROLE_BASELINE,
  seconds,
  serverState,
  SIZE,
  statusText,
  summary,
  TERM_BASELINE,
  timerShare,
} from '../../lib/raft/view';
import '../../styles/raft-lab.css';

// The Raft Lab (ADR 0020): five servers, the messages between them and each one's log, drawn at
// build from the opening run (lib/raft/view.ts), so the page is complete without JavaScript. The
// controls show only where script runs (raft-lab.css), and boot.ts loads the simulation on the
// visitor's first intent; it replays the same opening, so it takes over exactly where this stands.
// It all sits on the lab's desk (ADR 0025): servers and log entries are lamps in the lab's line, and
// Run is a push-button whose lamp is lit while the run is on (app.ts sets data-lamp). A server's lamp
// says its state by the site's one table of marks (design-system.md, "Lamps: one meaning per mark"):
// hollow while it follows, lit while it stands for election, filled while it leads, and hollow down
// its middle while it is down, which is what the gap over its body draws (raft-lab.css). Its words say
// what a press does, Run or Pause, so it is a plain button, never a toggle: a toggle keeps its name
// and says its state through aria-pressed (WAI-ARIA APG, "Button Pattern").
//
// A log's lamps are its own server's view, as Raft's are: an entry is filled once that server
// knows it is committed. The commit index is volatile state (Raft paper, Figure 2), so a crash
// clears it and a server that is down draws its whole log hollow, though every entry a majority
// holds is still committed. The legend says so, since "hollow" alone would read "not committed",
// and the caption counts from the run's high-water mark (lib/raft/sim.ts, committedCount), which
// no crash takes down.
//
// The controls come straight after the picture, before the logs, so on a phone the picture and the
// buttons that work it, Run, Next event, Start over and the network's, share one screen: a press and
// what it does are seen together. From 64rem the logs and the safety properties stand beside the
// picture, the controls under them, and how to read it all under those (raft-lab.css), since the
// properties are what the lead tells a visitor to watch. Nothing but the controls takes focus, so the
// tab order is the same either way. Time is the one group every lab has (components/lab/Time.astro):
// the clock, Run, Next event, Start over and Speed.
//
// The key names each mark on the wire, in the picture's own classes. Assistive technology skips it,
// as it does the Queue Lab's: the picture is one image, named by its caption, and the marks it holds
// aren't read out, so a key to them would name nothing a listener met.
const sim = openingRun();
const cut = cutFence(sim.groups);
// Every line the app would write for this run, so the run's first election is on the page from its
// first line: the last 12 of them opened on a server winning, with no line saying it stood.
const lines = sim.lines.slice(-LOG_LINES);
const dial = DIAL_RADIUS;

// Virtual seconds a real second runs, by name; Steady is the speed the page opens at.
const SPEEDS = [
  { value: '0.025', words: 'Slow' },
  { value: '0.05', words: 'Steady' },
  { value: '0.1', words: 'Quick' },
];
---

<div class="rf desk" id="raft-lab">
  <figure class="rf-figure">
    <svg
      class="rf-map"
      viewBox={`0 0 ${SIZE} ${SIZE}`}
      role="img"
      aria-labelledby="rf-summary"
      data-rf-map
    >
      <path class="rf-cut" data-rf-cut data-off={cut ? undefined : ''} d={cut ?? 'M0 0'} />
      {sim.servers.map((s) => {
        const { x, y } = place(s.id, sim.servers.length);
        return (
          <g class="rf-node" data-rf-node={s.id} data-role={s.role} data-up={String(s.up)}>
            <circle class="rf-track" cx={x} cy={y} r={dial} />
            <circle
              class="rf-dial"
              cx={x}
              cy={y}
              r={dial}
              pathLength="1"
              stroke-dasharray={`${timerShare(s, sim.now).toFixed(3)} 1`}
              data-rf-dial
            />
            <circle class="rf-body" cx={x} cy={y} r={NODE_RADIUS} />
            <circle class="rf-gap" cx={x} cy={y} r={NODE_RADIUS} />
            <text class="rf-name" x={x} y={y + 7}>
              {s.id + 1}
            </text>
            <text class="rf-role" x={x} y={y + ROLE_BASELINE} data-rf-role>
              {s.up ? s.role : 'down'}
            </text>
            <text class="rf-term" x={x} y={y + TERM_BASELINE} data-rf-term>
              term {s.term}
            </text>
          </g>
        );
      })}
      <g class="rf-flights" data-rf-flights set:html={flightsMarkup(sim, false)} />
    </svg>
    <figcaption class="rf-caption">
      <p class="rf-gloss">A term is a numbered stretch of time with at most one leader.</p>
      <p class="rf-summary" id="rf-summary" data-rf-summary>
        {summary(sim)}
      </p>
    </figcaption>
  </figure>

  <div class="rf-controls" data-rf-js>
    <Time short="rf" speeds={SPEEDS} speed="0.05">
      <p class="lab-clock">
        <span data-rf-clock>Virtual time {seconds(sim.now)}</span>,{' '}
        <span data-rf-events>{eventsWords(sim)}</span>, seed <span data-rf-seed>{sim.seed}</span>
      </p>
    </Time>
    <div class="lab-group" role="group" aria-labelledby="rf-network">
      <p class="lab-group-name" id="rf-network">
        The network
      </p>
      <div class="lab-row">
        <button type="button" class="btn" data-rf-write>
          Send a write
        </button>
        <button type="button" class="btn" data-rf-lone>
          Cut off the leader
        </button>
        <button type="button" class="btn" data-rf-split>
          Split two servers from three
        </button>
        <button type="button" class="btn" data-rf-heal>
          Heal the network
        </button>
        <label class="rf-field">
          <span>Messages lost</span>
          <input type="range" min="0" max="50" step="5" value="0" data-rf-loss />
          <output data-rf-loss-out>0%</output>
        </label>
      </div>
    </div>
    <div class="lab-group" role="group" aria-labelledby="rf-servers">
      <p class="lab-group-name" id="rf-servers">
        Crash or restart a server
      </p>
      <div class="lab-row">
        {sim.servers.map((s) => (
          <button
            type="button"
            class="btn rf-toggle"
            data-rf-toggle={s.id}
            aria-label={`Crash server ${s.id + 1}, now ${serverState(s)}`}
          >
            Crash server {s.id + 1}
          </button>
        ))}
      </div>
    </div>
    <p class="rf-sr" role="status" data-rf-said></p>
  </div>

  <div class="rf-part rf-log-part">
    <h2 class="rf-heading">Logs</h2>
    <ol class="rf-logs" role="list">
      {sim.servers.map((s) => (
        <li class="rf-log">
          <span class="rf-log-name">Server {s.id + 1}</span>
          <ol
            class="rf-cells"
            role="list"
            aria-label={`Server ${s.id + 1}: ${logWords(s)}`}
            data-rf-log={s.id}
            set:html={logMarkup(s)}
          />
        </li>
      ))}
    </ol>
  </div>

  <div class="rf-read">
    <p class="rf-legend">
      Each dot is one entry, with its term under it, as its server knows it. A filled dot is
      committed: a majority holds it, and it can never be lost. A hollow dot is one its server has
      not heard is committed yet. A crash keeps a server’s log but not what it knew was committed,
      which Raft holds only in memory, so a server shows its whole log hollow until a leader tells
      it again. If all five crash, no leader knows either: a new leader can’t count an older term’s
      entries until an entry of its own term commits, so they stay hollow until the next write. The
      caption counts what was ever committed, so its number doesn’t fall.
    </p>
    <ul class="rf-key" role="list" aria-hidden="true">
      <li class="rf-key-wide">
        <svg class="rf-key-mark" viewBox="0 0 20 20">
          <circle class="rf-track" cx="10" cy="10" r="7" />
          <circle class="rf-dial" cx="10" cy="10" r="7" pathLength="1" stroke-dasharray="0.6 1" />
        </svg>
        Election timer: when it closes, the server asks for votes
      </li>
      <li>
        <svg class="rf-key-mark" viewBox="0 0 20 20">
          <circle class="rf-m" data-kind="vote" cx="10" cy="10" r="4.5" />
        </svg>
        Asks for a vote
      </li>
      <li>
        <svg class="rf-key-mark" viewBox="0 0 20 20">
          <circle class="rf-m" data-kind="yes" cx="10" cy="10" r="3.5" />
        </svg>
        Grants a vote
      </li>
      <li>
        <svg class="rf-key-mark" viewBox="0 0 20 20">
          <circle class="rf-m" data-kind="no" cx="10" cy="10" r="3.5" />
        </svg>
        Refuses a vote
      </li>
      <li>
        <svg class="rf-key-mark" viewBox="0 0 20 20">
          <rect class="rf-m" data-kind="entries" x="5.5" y="5.5" width="9" height="9" />
        </svg>
        Carries log entries
      </li>
      <li>
        <svg class="rf-key-mark" viewBox="0 0 20 20">
          <rect class="rf-m" data-kind="beat" x="7" y="7" width="6" height="6" />
        </svg>
        Heartbeat, no entries
      </li>
      <li>
        <svg class="rf-key-mark" viewBox="0 0 20 20">
          <circle class="rf-m" data-kind="ack" cx="10" cy="10" r="2.5" />
        </svg>
        Answers the leader
      </li>
      <li class="rf-key-wide">
        <svg class="rf-key-mark" viewBox="0 0 20 20">
          <path class="rf-cut" d="M0 10H20" />
        </svg>
        Network split: no message crosses it
      </li>
    </ul>
  </div>

  <div class="rf-part rf-props-part">
    <h2 class="rf-heading" id="rf-props">
      Safety properties, from Figure 3 of the Raft paper
    </h2>
    <ul class="rf-props" role="list" aria-labelledby="rf-props">
      {PROPERTIES.map((name) => (
        <li class="rf-prop" data-rf-prop={name} data-held="true">
          <span class="rf-prop-lamp" aria-hidden="true" />
          <span class="rf-prop-name">{name}</span>
          <span class="rf-prop-word" data-rf-prop-word>
            {propertyWord(true)}
          </span>
          <span class="rf-prop-promise">{PROMISES[name]}</span>
        </li>
      ))}
    </ul>
    <p class="rf-status" data-rf-status>
      {statusText(sim)}
    </p>
  </div>

  <div class="rf-events">
    <h2 class="rf-heading" id="rf-events">
      What happened
    </h2>
    <div class="rf-lines" role="log" aria-live="off" aria-labelledby="rf-events" tabindex="0">
      <ol class="rf-list" data-rf-lines>
        {lines.map((line) => (
          <li>
            <span class="rf-at">{seconds(line.at)}</span> {line.text}
          </li>
        ))}
      </ol>
    </div>
  </div>
</div>

<script>
  import './boot';
</script>
