---
interface Props {
  /** The page's one <h1>. */
  heading: string;
  /** A sentence under the heading. */
  lead?: string | undefined;
}

// A page's head: its title and its lead, and no words above the title (ADR 0025: no eyebrows).
// What a page says about itself, a post's kind and day, stands in its own register beside it
// (layouts/Prose.astro), never over the title. A lab's page has a head of its own
// (components/lab/LabHead.astro), with the lab's glyph beside it.
const { heading, lead } = Astro.props;
---

<header class="page-head">
  <h1 id="page-title" class="page-title">
    {heading}
  </h1>
  {lead && <p class="page-lead">{lead}</p>}
  <slot />
</header>
