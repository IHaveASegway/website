---
import { isoDay, KIND_LABELS, postPath, wordDay, type Post } from '../lib/posts';

interface Props {
  posts: readonly Post[];
  /** The heading level of each title: 2 on an index, 3 inside a Home section. */
  level: 2 | 3;
}

const { posts, level } = Astro.props;
const Title = level === 2 ? 'h2' : 'h3';
// The whole row is the title's link (ADR 0022): the link's box is stretched over the row by CSS, so
// a press anywhere on it opens the post, with the title alone as the link's name. Under the title,
// its summary, then its day in words and its kind after it (ADR 0025): "25 October 2026,
// postmortem", never a label over the title.
---

<ol class="post-list" role="list">
  {posts.map((post) => (
    <li>
      <Title class="post-title">
        <a href={postPath(post)}>{post.title}</a>
      </Title>
      <p class="post-summary">{post.summary}</p>
      <p class="post-meta">
        <time datetime={isoDay(post.published)}>{wordDay(post.published)}</time>,{' '}
        {KIND_LABELS[post.kind].toLowerCase()}
      </p>
    </li>
  ))}
</ol>
