---
import { isoDay, KIND_LABELS, minutesWords, postPath, shortDay, type Post } from '../lib/posts';
import '../styles/post-list.css';

interface Props {
  posts: readonly Post[];
  /** The heading level of each title: 2 on an index, 3 inside a Home section. */
  level: 2 | 3;
}

const { posts, level } = Astro.props;
const Title = level === 2 ? 'h2' : 'h3';
// The dated list (docs/design/overhaul.md, "Writing list"; ADR 0027): a row a post, a hairline over
// each, three columns from 48rem: its day in the wide face, its title in the display face with its
// summary under it, and its kind and reading time at the row's end. The whole row is the title's
// link (ADR 0022): the link's box is stretched over the row by CSS, so a press anywhere on it opens
// the post, with the title alone as the link's name. Read aloud, a row is its day, its title, its
// summary, then its kind: the order it is drawn in, left to right.
---

<ol class="post-list" role="list">
  {posts.map((post) => (
    <li class="post-row">
      <p class="post-date">
        <time datetime={isoDay(post.published)}>{shortDay(post.published)}</time>
      </p>
      <div class="post-main">
        <Title class="post-title">
          <a href={postPath(post)}>{post.title}</a>
        </Title>
        <p class="post-summary">{post.summary}</p>
      </div>
      <p class="post-kind">
        <span>{KIND_LABELS[post.kind]}</span> <span>{minutesWords(post.minutes)}</span>
      </p>
    </li>
  ))}
</ol>
