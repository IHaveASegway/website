---
import { isoDay, KIND_LABELS, postPath, type Post } from '../lib/posts';

interface Props {
  posts: readonly Post[];
  /** The heading level of each title: 2 on an index, 3 inside a Home section. */
  level: 2 | 3;
}

const { posts, level } = Astro.props;
const Title = level === 2 ? 'h2' : 'h3';
// The whole row is the title's link (ADR 0022): the link's box is stretched over the row by CSS, so
// a press anywhere on it opens the post, with the title alone as the link's name. The title's words
// rise in a span of their own, because the rise clips what it moves, and would clip the link's box.
---

<ol class="post-list" role="list">
  {posts.map((post) => (
    <li>
      <p class="post-meta">
        <time datetime={isoDay(post.published)}>{isoDay(post.published)}</time> ·{' '}
        {KIND_LABELS[post.kind]}
      </p>
      <Title class="post-title">
        <a href={postPath(post)}>
          <span class="title-words">{post.title}</span>
        </a>
      </Title>
      <p class="post-summary">{post.summary}</p>
    </li>
  ))}
</ol>
