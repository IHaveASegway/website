---
import Choice from '../lab/Choice.astro';
import EventLog from '../lab/EventLog.astro';
import Said from '../lab/Said.astro';
import Time from '../lab/Time.astro';
import { LINES_SHOWN } from '../../lib/lab/event-log';
import { properties } from '../../lib/queue/check';
import { LOADS, MAX_WORKERS } from '../../lib/queue/sim';
import {
  capacityWords,
  eventsWords,
  LAYOUTS,
  mapMarkup,
  OPENING,
  openingRun,
  PREFETCHES,
  propertyWords,
  seconds,
  SPEEDS,
  statusText,
  STRIP,
  strip,
  stripWords,
  summary,
  tenths,
  waitWords,
} from '../../lib/queue/view';
import '../../styles/queue-lab.css';

// The Queue Lab (ADR 0026, after ADR 0020's pattern): a broker, three workers and the bakery's
// orders, drawn at build from the opening run (lib/queue/view.ts), so the page is complete without
// JavaScript. The controls show only where script runs (queue-lab.css), and boot.ts loads the
// simulation; it replays the same opening, so it takes over exactly where this stands. It all sits
// on the lab's desk (ADR 0027; styles/lab-page.css, .desk).
//
// The picture's own controls come right under it, before any words: Time, the idempotency key and
// the workers' Crash and Slow, so a visitor sees what a press does as they press it, on a phone too
// (a 390 by 844 screen holds the picture and all of them). Nothing pins: the picture scrolls with the
// page, and covers nothing. Then what the run says, the caption, the key, the history strip and the
// checks; then the settings a run is tried under, and the event log, each under a rule from bezel to
// bezel. Each part of the controls says what its presses did (lib/lab/said.ts). The key names each
// mark a run can draw that the write-up's key does not, in the picture's own classes: it shows only
// where script runs, since only a run draws those marks, and assistive technology skips it, since
// the caption and the log say the same in words.
const sim = openingRun();
// The opening's crash, under the clock, in words true of every run the page plays, the opening,
// a link's and a run started over, so the script never rewrites them: a run started over stands
// before it, and the line says where to look.
const crashes = OPENING.actions
  .map((a) => `Every run crashes worker ${a.worker + 1} at ${seconds(a.at)}.`)
  .join(' ');
const lines = sim.lines
  .slice(-LINES_SHOWN)
  .map((line) => ({ at: seconds(line.at), text: line.text }));
const history = strip(sim);
const pool = sim.workers.slice(0, sim.size);
const SWITCH = [
  { value: 'off', words: 'Off' },
  { value: 'on', words: 'On' },
];
const ACKS = [
  { value: 'after', words: 'After the work' },
  { value: 'before', words: 'Before the work' },
];
const HANDLINGS = [
  { value: 'requeue', words: 'Requeue it' },
  { value: 'dead-letter', words: 'Dead-letter after four tries' },
];
const LOAD_NAMES = [
  { value: 'calm', words: 'Calm' },
  { value: 'busy', words: 'Busy' },
  { value: 'rush', words: 'Rush' },
];
if (pool.length > MAX_WORKERS) throw new Error('queue lab: more workers than the picture draws');
---

<div class="qu desk" id="queue-lab">
  <div class="qu-stage">
    <div class="qu-picture">
      {(['wide', 'narrow'] as const).map((name) => (
        <svg
          class="qu-map"
          data-qu-map={name}
          viewBox={`0 0 ${LAYOUTS[name].width} ${LAYOUTS[name].height}`}
          role="img"
          aria-labelledby="qu-summary"
          set:html={mapMarkup(sim, LAYOUTS[name])}
        />
      ))}
    </div>

    <div class="qu-controls" data-qu-js data-part>
      <Time
        short="qu"
        speeds={SPEEDS.map((s) => ({ value: String(s.value), words: s.name }))}
        speed="1"
      >
        <p class="lab-clock">
          <span data-qu-clock>Virtual time {seconds(sim.now)}</span>,{' '}
          <span data-qu-events>{eventsWords(sim)}</span>, seed <span data-qu-seed>{sim.seed}</span>
        </p>
        <p class="lab-clock qu-ahead" data-qu-ahead>
          {crashes}
        </p>
      </Time>
      <Choice
        legend="Idempotency key"
        name="qu-key"
        options={SWITCH}
        checked={sim.key ? 'on' : 'off'}
      />
      <div class="lab-group" role="group" aria-labelledby="qu-workers">
        <p class="lab-group-name" id="qu-workers">
          Workers
        </p>
        <div class="lab-row qu-workers">
          {pool.map((w) => (
            <div class="qu-worker" role="group" aria-labelledby={`qu-worker-${w.id}`}>
              <span class="qu-worker-name" id={`qu-worker-${w.id}`}>
                Worker {w.id + 1}
              </span>
              <button
                type="button"
                class="btn qu-toggle"
                data-qu-crash={w.id}
                aria-label={`${w.state === 'up' ? 'Crash' : 'Restart'} worker ${w.id + 1}`}
              >
                {w.state === 'up' ? 'Crash' : 'Restart'}
              </button>
              <button
                type="button"
                class="btn qu-toggle"
                data-qu-slow={w.id}
                aria-label={
                  w.slow ? `Normal speed for worker ${w.id + 1}` : `Slow down worker ${w.id + 1}`
                }
              >
                {w.slow ? 'Normal' : 'Slow'}
              </button>
            </div>
          ))}
        </div>
      </div>
      <Said words="Turn the key on or off, and the run starts over under it, before the same crash." />
      <p class="lab-sr" role="status" data-qu-said></p>
    </div>

    <p class="qu-summary" id="qu-summary" data-qu-summary>
      {summary(sim)}
    </p>
    <ul class="qu-key" role="list" aria-hidden="true" data-qu-js>
      <li>
        <svg class="qu-key-mark" viewBox="0 0 20 20">
          <circle class="qu-order" data-state="ready" cx="10" cy="10" r="6" />
        </svg>
        Waiting
      </li>
      <li>
        <svg class="qu-key-mark" viewBox="0 0 20 20">
          <path
            class="qu-order"
            data-state="retry"
            d="M4 10a6 6 0 1 0 12 0a6 6 0 1 0 -12 0M10 6.4V10h3"
          />
        </svg>
        Waiting to retry
      </li>
      <li>
        <svg class="qu-key-mark" viewBox="0 0 20 20">
          <circle class="qu-slot" data-state="taken" cx="10" cy="10" r="6" />
        </svg>
        Taken, not yet acknowledged
      </li>
      <li>
        <svg class="qu-key-mark" viewBox="0 0 20 20">
          <circle class="qu-slot" data-state="room" cx="10" cy="10" r="1.5" />
        </svg>
        Room for one more
      </li>
      <li>
        <svg class="qu-key-mark" viewBox="0 0 20 20">
          <path class="qu-order" data-poison="" d="M10 4L16 10L10 16L4 10Z" />
        </svg>
        Poison order
      </li>
      <li>
        <svg class="qu-key-mark" viewBox="0 0 20 20">
          <path
            class="qu-ticket"
            data-state="lost"
            d="M5 10a5 5 0 1 0 10 0a5 5 0 1 0 -10 0M5 15l10 -10"
          />
        </svg>
        Lost, never printed
      </li>
    </ul>

    <div class="qu-strip">
      <p class="qu-strip-head">
        <span>Orders waiting in the queue</span>
        <span class="qu-strip-now" data-qu-wait>
          {waitWords(sim)}
        </span>
      </p>
      <div class="qu-strip-body">
        <span class="qu-strip-scale" aria-hidden="true">
          <span data-qu-most>{history.most}</span>
          <span>0</span>
        </span>
        <svg
          class="qu-strip-chart"
          viewBox={`0 0 ${STRIP.width} ${STRIP.height}`}
          preserveAspectRatio="none"
          role="img"
          aria-label={stripWords(sim)}
          data-qu-strip
        >
          <g
            data-qu-crashes
            set:html={history.crashes
              .map((c) => `<path class="qu-strip-crash" d="M${c.x} 0V${STRIP.height}"/>`)
              .join('')}
          />
          <polyline class="qu-strip-line" points={history.points} data-qu-strip-line />
        </svg>
      </div>
      <p class="qu-strip-foot" aria-hidden="true">
        <span data-qu-from>{tenths(history.from)}</span>
        <span>A dashed tick marks a crash</span>
        <span data-qu-to>{tenths(history.to)}</span>
      </p>
    </div>

    <section class="lab-group qu-checks" aria-labelledby="qu-checks">
      <h2 class="lab-heading" id="qu-checks">
        Checked as the run goes
      </h2>
      <ul class="qu-props" role="list">
        {properties(sim).map((p) => (
          <li class="qu-prop" data-qu-prop={p.id} data-held={String(p.held)}>
            <span class="qu-lamp" aria-hidden="true" />
            <span class="qu-prop-name">{p.name}</span>
            <span class="qu-prop-words" data-qu-prop-words>
              {propertyWords(sim, p)}
            </span>
          </li>
        ))}
      </ul>
    </section>
    <p class="qu-status" data-qu-status>
      {statusText(sim)}
    </p>
  </div>

  <div class="qu-settings" data-qu-js data-part>
    <Choice legend="When a worker acknowledges" name="qu-ack" options={ACKS} checked={sim.ack} />
    <Choice
      legend="Prefetch: orders each worker may hold"
      name="qu-prefetch"
      options={PREFETCHES.map((n) => ({
        value: String(n),
        words: String(n),
        long: `${n} ${n === 1 ? 'order' : 'orders'}`,
      }))}
      checked={String(sim.prefetch)}
    />
    <div class="qu-load">
      <Choice legend="Load" name="qu-load" options={LOAD_NAMES} checked={sim.load} />
      <p class="qu-note">
        {LOADS.calm}, {LOADS.busy} and {LOADS.rush} orders a second.{' '}
        <span data-qu-capacity>{capacityWords(sim)}</span>
      </p>
    </div>
    <div class="lab-group" role="group" aria-labelledby="qu-new">
      <p class="lab-group-name" id="qu-new">
        New orders
      </p>
      <div class="lab-row">
        <button type="button" class="btn qu-producer" data-qu-producer>
          Stop taking orders
        </button>
        <button type="button" class="btn" data-qu-poison>
          Publish a poison order
        </button>
      </div>
    </div>
    <Choice
      legend="When an order fails"
      name="qu-handling"
      options={HANDLINGS}
      checked={sim.handling}
    />
    <Said words="These change the run as it stands." />
  </div>

  <div class="qu-events">
    <EventLog short="qu" lines={lines} />
  </div>
</div>

<script>
  import './boot';
</script>
