---
import { pathData } from '../lib/route-lab/legs';
import { basemap, leg, routeData, type Picture } from '../lib/route-lab/picture';
import { vanClass } from '../lib/route-lab/render';
import {
  dayPlaces,
  floorMatrix,
  focusOf,
  mapBounds,
  projector,
  sceneSeconds,
  START,
  windowOf,
} from '../lib/route-lab/scene';
import { simplify } from '../lib/route-lab/space-time';
import { tracks } from '../lib/route-lab/timeline';

interface Props {
  picture: Picture;
  /** The scene's data file (pages/lab/[demo]/scene.json.ts), which the canvas fetches. */
  data: string;
}

// Home's scene (ADR 0024, ADR 0025): the Route Lab's default day as VROOM plans it at build, on the
// map, flat and north up, as the canvas starts from it (lib/route-lab/scene.ts). This picture is
// Home without JavaScript, under a reduced-motion preference and before the canvas has drawn: the
// routes whole, every stop marked. With motion, src/scripts/route-scene.ts takes its place in the
// same box and drives the day; the canvas reads the floor's paths and this picture's own mapping
// to the screen from it, so the page holds one copy of the map and the two never disagree. The
// map's water is the page itself and nothing fades it: its box runs from beside the words to the
// screen's edge (home.css), and the picture covers that box with the map pinned at its west edge,
// the sound, so the words stand on the water and the city runs off the edges of the screen. The
// floor is drawn in the map's own units through one matrix, the routes in the camera's. No style
// attribute (security.md): colour comes from classes. The map is OpenStreetMap's, under the ODbL,
// so its credit is in the words beside it (Hero.astro), as on the lab.
const { picture, data } = Astro.props;
const seconds = sceneSeconds(picture.after.measured.back);
const focus = focusOf(dayPlaces(routeData, picture.after.plan));
const at = projector(focus, seconds, START);
const map = mapBounds(routeData.viewBox);
const bakery = routeData.points[0] ?? { x: 0, y: 0 };
// The framed part of the map, in the camera's units: what the picture's box shows when it is as
// tall as the window, more of the city to the east wherever the box is wider.
const [w0, h0, w1, h1] = windowOf(map, [bakery.x, bakery.y]);
const [u0, v0] = at(w0, h0, 0);
const [u1, v1] = at(w1, h1, 0);
const viewBox = [u0, v0, u1 - u0, v1 - v0].map(Math.round).join(' ');
const matrix = floorMatrix(focus, seconds, START, { scale: 1, x: 0, y: 0 })
  .map((v) => Number(v.toFixed(5)))
  .join(' ');
const screen = (x: number, y: number) => at(x, y, 0).map(Math.round) as [number, number];
const routes = tracks(routeData, leg, picture.after.plan).map((track) => {
  const flat: number[] = [];
  for (let k = 0; k < track.points.length; k += 3)
    flat.push(...screen(track.points[k] ?? 0, track.points[k + 1] ?? 0));
  return {
    van: vanClass(track.van),
    d: pathData(simplify(flat, 1.5).map(Math.round)),
    stops: track.stops.map((s) => screen(s.x, s.y)),
  };
});
const marks = (points: readonly (readonly [number, number])[]) =>
  points.map(([x, y]) => `M${x} ${y}h0`).join('');
const places = routeData.points.slice(1).map((p) => [p.x, p.y] as const);
const [mx, my, mw, mh] = routeData.viewBox;
const [bx, by] = screen(bakery.x, bakery.y);
const { day } = picture;
---

<figure class="scene" data-scene>
  <svg
    class="scene-picture"
    viewBox={viewBox}
    preserveAspectRatio="xMinYMid slice"
    role="img"
    aria-labelledby="scene-name"
  >
    <title id="scene-name">
      Seattle on {day.name.replace(/^A /, 'a ')}: the routes VROOM plans for {routes.length} vans from
      the bakery, {day.orders.length} orders in all.
    </title>
    <g class="scene-floor" transform={`matrix(${matrix})`}>
      <path class="scene-land" d={`M${mx} ${my}h${mw}v${mh}h${-mw}z`} data-floor="land" />
      <path class="scene-water" d={basemap.water} data-floor="water" />
      <path class="scene-road" d={basemap.roads.secondary} data-floor="minor" />
      <path
        class="scene-road scene-road-major"
        d={basemap.roads.motorway + basemap.roads.primary}
        data-floor="major"
      />
      <path class="scene-place" d={marks(places)} />
    </g>
    {routes.map((route) => (
      <path class={`scene-route scene-van-${route.van}`} d={route.d} />
    ))}
    {routes.map((route) => (
      <path class={`scene-stop scene-van-${route.van}`} d={marks(route.stops)} />
    ))}
    <path class="scene-depot" d={`M${bx} ${by}h0`} />
  </svg>
  <canvas class="scene-live" data-scene-live={data} aria-hidden="true"></canvas>
</figure>
