---
import { pathData } from '../lib/route-lab/legs';
import { basemap, leg, routeData, type Picture } from '../lib/route-lab/picture';
import { formatDuration } from '../lib/route-lab/plan';
import { vanClass } from '../lib/route-lab/render';
import {
  dayPlaces,
  EDGE,
  extent,
  floorMatrix,
  focusOf,
  projector,
  sceneSeconds,
  START,
} from '../lib/route-lab/scene';
import { simplify } from '../lib/route-lab/space-time';
import { tracks } from '../lib/route-lab/timeline';

interface Props {
  picture: Picture;
  /** The Route Lab's page, which the caption opens. */
  href: string;
  /** The scene's data file (pages/lab/[demo]/scene.json.ts), which the canvas fetches. */
  data: string;
}

// Home's scene (ADR 0024): the Route Lab's default day as VROOM plans it at build, on the map, seen
// from the camera the canvas starts from (lib/route-lab/scene.ts). This picture is Home without
// JavaScript, under a reduced-motion preference and before the canvas has drawn: the routes whole,
// every stop marked. With motion, src/scripts/route-scene.ts takes its place in the same box at the
// same angle and drives the day; the canvas reads the floor's paths from this picture, so the page
// holds one copy of the map. The floor is drawn in the map's own units through one matrix, the
// routes in screen units. No style attribute (security.md): color comes from classes. The map is
// OpenStreetMap's, under the ODbL, so wherever it shows, its credit shows with it, as on the lab.
const { picture, href, data } = Astro.props;
const seconds = sceneSeconds(picture.after.measured.back);
// The camera holds the part of the map the day happens in; the rest of the map runs on past the
// picture's box to the stage's edges.
const focus = focusOf(dayPlaces(routeData, picture.after.plan));
const box = extent(focus, seconds, START);
const pad = 0.03 * Math.max(box.width, box.height);
const viewBox = [box.x - pad, box.y - pad, box.width + 2 * pad, box.height + 2 * pad]
  .map(Math.round)
  .join(' ');
const matrix = floorMatrix(focus, seconds, START, { scale: 1, x: 0, y: 0 })
  .map((v) => Number(v.toFixed(5)))
  .join(' ');
const at = projector(focus, seconds, START);
const screen = (x: number, y: number) => at(x, y, 0).map(Math.round) as [number, number];
const routes = tracks(routeData, leg, picture.after.plan).map((track) => {
  const flat: number[] = [];
  for (let k = 0; k < track.points.length; k += 3)
    flat.push(...screen(track.points[k] ?? 0, track.points[k + 1] ?? 0));
  return {
    van: vanClass(track.van),
    d: pathData(simplify(flat, 1.5).map(Math.round)),
    stops: track.stops.map((s) => screen(s.x, s.y)),
  };
});
const marks = (points: readonly (readonly [number, number])[]) =>
  points.map(([x, y]) => `M${x} ${y}h0`).join('');
const places = routeData.points.slice(1).map((p) => [p.x, p.y] as const);
// The map's rectangle, which its floor fades in from (EDGE), along x and then along y: two alpha
// masks in the map's own units, one inside the other, so their fades multiply as the canvas's do.
const [mx, my, mw, mh] = routeData.viewBox;
const edges = [
  { id: 'scene-edge-x', x2: mx + mw, y2: my },
  { id: 'scene-edge-y', x2: mx, y2: my + mh },
];
const bakery = routeData.points[0] ?? { x: 0, y: 0 };
const [bx, by] = screen(bakery.x, bakery.y);
const { day } = picture;
const { before, after } = picture;
const done = `All ${day.orders.length} delivered · last van back after ${formatDuration(after.measured.back)}`;
---

<figure class="scene" data-scene>
  <svg
    class="scene-picture"
    viewBox={viewBox}
    preserveAspectRatio="xMidYMid meet"
    role="img"
    aria-labelledby="scene-name"
  >
    <title id="scene-name">
      Seattle on {day.name.replace(/^A /, 'a ')}: the routes VROOM plans for {routes.length} vans from
      the bakery, {day.orders.length} orders in all.
    </title>
    <defs>
      {edges.map((edge) => (
        <>
          <linearGradient
            id={`${edge.id}-fade`}
            gradientUnits="userSpaceOnUse"
            x1={mx}
            y1={my}
            x2={edge.x2}
            y2={edge.y2}
          >
            <stop offset="0" stop-opacity="0" />
            <stop offset={EDGE} />
            <stop offset={1 - EDGE} />
            <stop offset="1" stop-opacity="0" />
          </linearGradient>
          <mask
            id={edge.id}
            class="scene-edge"
            maskUnits="userSpaceOnUse"
            x={mx}
            y={my}
            width={mw}
            height={mh}
          >
            <rect x={mx} y={my} width={mw} height={mh} fill={`url(#${edge.id}-fade)`} />
          </mask>
        </>
      ))}
    </defs>
    <g class="scene-floor" transform={`matrix(${matrix})`}>
      <g mask="url(#scene-edge-x)">
        <g mask="url(#scene-edge-y)">
          <path class="scene-water" d={basemap.water} data-floor="water" />
          <path class="scene-road" d={basemap.roads.secondary} data-floor="minor" />
          <path
            class="scene-road scene-road-major"
            d={basemap.roads.motorway + basemap.roads.primary}
            data-floor="major"
          />
          <path class="scene-place" d={marks(places)} />
        </g>
      </g>
    </g>
    {routes.map((route) => (
      <path class={`scene-route scene-van-${route.van}`} d={route.d} />
    ))}
    {routes.map((route) => (
      <path class={`scene-stop scene-van-${route.van}`} d={marks(route.stops)} />
    ))}
    <path class="scene-depot" d={`M${bx} ${by}h0`} />
  </svg>
  <canvas class="scene-live" data-scene-live={data} aria-hidden="true"></canvas>
  <figcaption class="scene-hud">
    <a class="scene-hud-title label" href={href}>
      <span class="scene-dot" aria-hidden="true"></span>
      Route Lab · {day.name}
    </a>
    <p class="scene-hud-row label">
      {day.orders.length} orders · {routes.length} vans · planned by VROOM
    </p>
    <p class="scene-hud-row label">
      {formatDuration(after.measured.drive)} of driving, not {formatDuration(before.measured.drive)}
    </p>
    <p class="scene-hud-clock label">
      <span class="scene-hud-done">{done}</span>
      <span class="scene-hud-live" data-scene-clock aria-hidden="true"></span>
    </p>
    <p class="scene-credit">
      Map data © <a href={routeData.copyright}>OpenStreetMap contributors</a>
    </p>
  </figcaption>
</figure>
