---
import { navAll } from '../lib/nav';
import { checkedProfiles, type Profile } from '../lib/profile';
import { CONTACT_EMAIL } from '../lib/site';
import { THEME_STATES } from '../lib/theme';

interface Props {
  profile: Profile;
  /** URLs content adds to this build (lib/posts.ts, areaRoutes; lib/lab.ts, labRoutes). */
  generated: readonly string[];
  /** Every live demo and every published post, each a page this build writes (Base.astro). */
  demos: readonly Found[];
  posts: readonly Found[];
  /** The page has a Print button ([data-print]), which the menu's Print row presses. */
  print?: boolean;
}

interface Found {
  readonly title: string;
  readonly summary: string;
  readonly href: string;
}

const { profile, generated, demos, posts, print = false } = Astro.props;

// The command menu (design-system.md, "The command menu"), written into every page and opened by
// src/scripts/palette.js. Its rows, in five groups: Go to, Home and the manifest's pages this
// build writes, as the header and the footer list them (lib/nav.ts; a feed is a file, not a page);
// Lab and Writing, every demo and every post, found by their titles, and by their summaries where
// the query stands in one whole, so the rail's search finds what the rail has no room to list
// (ADR 0022);
// Actions, copying the address, the theme, whose entry shows the toggle's names, and Print, on a
// page with a Print button (/about/), which the entry presses; and Links, the
// profiles whose readiness check is recorded, as the footer lists them. Every row also exists
// elsewhere on the page, in the nav, the toggle or the footer: the menu is a shortcut, never the
// only way in (content.md, "Sitemap and phases"). The page's own text is all it shows: what a
// visitor types narrows the rows and is never written back (security.md, "Threat model").
const KEYWORDS: Readonly<Record<string, string>> = {
  home: 'start',
  lab: 'demos',
  writing: 'posts articles',
  about: 'bio resume cv experience',
  colophon: 'decisions',
};
const pages = [
  { id: 'home', label: 'Home', href: '/' },
  ...navAll(generated).filter((item) => item.href.endsWith('/')),
];
const profiles = checkedProfiles(profile);
// A row's id from its page's path, which is unique: /lab/raft/ is palette-lab-raft.
const idOf = (href: string) => `palette${href.replace(/\/$/, '').replaceAll('/', '-')}`;
const found = [
  { id: 'palette-demos', label: 'Lab', rows: demos },
  { id: 'palette-posts', label: 'Writing', rows: posts },
].filter((group) => group.rows.length > 0);
---

<dialog class="palette" data-palette aria-label="Command menu">
  <input
    class="palette-input"
    type="text"
    role="combobox"
    aria-label="Find a page or an action"
    aria-expanded="true"
    aria-controls="palette-list"
    aria-autocomplete="list"
    autocomplete="off"
    spellcheck="false"
    autocapitalize="none"
    enterkeyhint="go"
    placeholder="Find a page or an action"
  />
  <div
    class="palette-list"
    id="palette-list"
    role="listbox"
    aria-label="Command menu"
    tabindex="-1"
  >
    <ul class="palette-group" role="group" aria-labelledby="palette-go">
      <li class="label palette-heading" id="palette-go" role="presentation">
        Go to
      </li>
      {pages.map((page) => (
        <li
          class="palette-option"
          role="option"
          id={`palette-${page.id}`}
          data-href={page.href}
          data-keys={KEYWORDS[page.id]}
        >
          {page.label}
        </li>
      ))}
    </ul>
    {found.map((group) => (
      <ul class="palette-group" role="group" aria-labelledby={group.id}>
        <li class="label palette-heading" id={group.id} role="presentation">
          {group.label}
        </li>
        {group.rows.map((row) => (
          <li
            class="palette-option"
            role="option"
            id={idOf(row.href)}
            data-href={row.href}
            data-find={row.summary}
          >
            {row.title}
          </li>
        ))}
      </ul>
    ))}
    <ul class="palette-group" role="group" aria-labelledby="palette-actions">
      <li class="label palette-heading" id="palette-actions" role="presentation">
        Actions
      </li>
      <li
        class="palette-option"
        role="option"
        id="palette-copy"
        data-act="copy"
        data-copy={CONTACT_EMAIL}
        data-keys="mail contact"
      >
        {'Copy email address '}
        <span class="palette-value">{CONTACT_EMAIL}</span>
      </li>
      <li
        class="palette-option"
        role="option"
        id="palette-theme"
        data-act="theme"
        data-keys="light dark mode"
      >
        {THEME_STATES.map(({ theme, name }) => (
          <span class="palette-theme" data-for={theme}>
            {name}
          </span>
        ))}
      </li>
      {print && (
        <li
          class="palette-option"
          role="option"
          id="palette-print"
          data-act="print"
          data-keys="pdf save download resume cv"
        >
          Print or save as PDF
        </li>
      )}
    </ul>
    {profiles.length > 0 && (
      <ul class="palette-group" role="group" aria-labelledby="palette-links">
        <li class="label palette-heading" id="palette-links" role="presentation">
          Links
        </li>
        {profiles.map((p) => (
          <li
            class="palette-option"
            role="option"
            id={`palette-${p.network.toLowerCase()}`}
            data-href={p.url}
            data-keys="profile"
          >
            {p.network}
          </li>
        ))}
      </ul>
    )}
  </div>
  <p class="palette-empty" data-palette-empty hidden>
    No matches
  </p>
  <p class="palette-note" data-palette-note></p>
  <p class="palette-say" role="status" data-palette-say></p>
  <p class="palette-help">↑/↓ move · enter open · esc close</p>
</dialog>

<script>
  import '../scripts/palette.js';
</script>
