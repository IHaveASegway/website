---
import { CONTACT_EMAIL } from '../../lib/site';
import '../../styles/contact.css';

// How a page closes (docs/design/home.md, "Contact"; /about/ and Home): where to reach Joseph, under
// a title. A mailto link opens nothing on a computer with no mail app set up, so the address is
// there to read and to copy as well as to press (scripts/copy.js).

interface Props {
  /** The title over it: the bio's closing section's, where the build holds the bio. */
  heading?: string | undefined;
  /** That section's words, each a paragraph. */
  words?: readonly string[] | undefined;
  /** LinkedIn, when the profile's link to it is checked (lib/profile.ts). */
  linkedIn?: { readonly url: string; readonly network: string } | undefined;
}

const { heading = 'Contact', words = [], linkedIn } = Astro.props;
// The address may break after its "@", and only there.
const [mailbox, domain] = CONTACT_EMAIL.split('@');
---

<section class="section contact" id="contact" aria-labelledby="contact-title">
  <h2 class="section-title" id="contact-title">
    {heading}
  </h2>
  {words.map((paragraph) => (
    <p class="contact-words">{paragraph}</p>
  ))}
  {words.length === 0 && (
    <p class="contact-line">
      {/* A phone breaks the address after its @, never inside a word (a <wbr>, unseen and unread). */}
      <a class="contact-address" href={`mailto:${CONTACT_EMAIL}`}>
        {mailbox}@<wbr />
        {domain}
      </a>
    </p>
  )}
  <div class="contact-actions">
    {words.length === 0 && (
      <button class="btn btn-copy" type="button" data-copy-address={CONTACT_EMAIL}>
        <span class="copy-label" aria-live="polite">
          Copy email address
        </span>
      </button>
    )}
    {linkedIn && (
      <a class:list={['btn', { 'btn-primary': words.length > 0 }]} href={linkedIn.url}>
        {linkedIn.network}
      </a>
    )}
  </div>
</section>

{words.length === 0 && <script>
  import '../../scripts/copy.js';
</script>}
