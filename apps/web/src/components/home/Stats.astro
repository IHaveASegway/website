---
import { figure } from '../../lib/home';

interface Props {
  /** Each figure and what it counts, every one worked out at build (index.astro). */
  stats: readonly { readonly value: number; readonly caption: string }[];
}

const { stats } = Astro.props;
// The stats row (docs/design/overhaul.md, "Stats row"): a list of figures on the ground band, each
// in the display face at a title's size over its caption in the wide face, hairlines between the
// cells, four abreast from 48rem and two below. In the markup the caption is the term and the
// figure its value, so a screen reader says what is counted before the count; the stylesheet
// stands the figure on top. A figure of nothing is left out rather than shown as a zero.
const shown = stats.filter((stat) => stat.value > 0);
---

{shown.length > 0 && (
  <dl class="stats">
    {shown.map((stat) => (
      <div class="stat">
        <dt class="stat-caption">{stat.caption}</dt>
        <dd class="stat-figure">
          <data value={stat.value}>{figure(stat.value)}</data>
        </dd>
      </div>
    ))}
  </dl>
)}
