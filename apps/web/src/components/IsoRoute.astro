---
import { routePicture, VAN_R } from '../lib/iso';

// The Route Lab's card picture, drawn in isometric at build (lib/iso.ts; ADR 0023): the bakery,
// the bands its vans reach in so many minutes, as the lab's map shades them, and one van's round
// of five stops, which the van drives while the card is pointed at or focused: a copy of the van
// per leg, each crossing its own leg's frame in its turn (global.css). A picture, so screen
// readers skip it: the card's own words say what the lab does.
const scene = routePicture();
---

<svg class="iso iso-route iso-card" viewBox={scene.viewBox} aria-hidden="true" focusable="false">
  <g class="iso-platform">
    <polygon class="iso-face-left" points={scene.platform.left} />
    <polygon class="iso-face-right" points={scene.platform.right} />
    <polygon class="iso-face-top" points={scene.platform.top} />
  </g>
  {[...scene.bands].reverse().map((band) => (
    <ellipse class="iso-band" cx={band.cx} cy={band.cy} rx={band.rx} ry={band.ry} />
  ))}
  <path class="iso-route-line" d={scene.route} />
  {scene.stops.map((stop) => (
    <circle class="iso-stop" cx={stop.x} cy={stop.y} r="3.5" />
  ))}
  <g class="iso-server">
    <polygon class="iso-face-left" points={scene.depot.left} />
    <polygon class="iso-face-right" points={scene.depot.right} />
    <polygon class="iso-face-top" points={scene.depot.top} />
  </g>
  <circle class="iso-van iso-van-home" cx={scene.home.x} cy={scene.home.y} r={VAN_R} />
  {scene.legs.map((leg, i) => (
    <g transform={leg.transform}>
      <ellipse class="iso-van iso-van-leg" data-leg={i + 1} rx={leg.rx} ry={VAN_R} />
    </g>
  ))}
</svg>
