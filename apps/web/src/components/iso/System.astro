---
import { system, type Counts, type Lab } from '../../lib/iso/system';

interface Props {
  /** What the drawing counts from each lab's own opening run (index.astro). */
  counts: Counts;
  /** Each lab this build writes: its page and its title. A part whose lab is not built is drawn
   *  without a link. */
  labs: Partial<Record<Lab, { readonly href: string; readonly title: string }>>;
}

const { counts, labs } = Astro.props;
const model = system(counts);
// Home's drawing (docs/design/overhaul.md, "The isometric drawing"; ADR 0027): the five labs as
// one system, the geometry worked out in lib/iso/system.ts. Back to front: the ground plane and its
// lattice, the wires along it, what travels them, each part's footprint, then the parts, each its
// lab's link, named by its label's words, which a sighted visitor reads there (SC 2.5.3); the
// caption under the drawing says each part opens its lab. Pointing at a part, or focusing it,
// lights its lab's wires in the lab's own colour (home.css), a state with no movement.
//
// What moves, and only with no reduced-motion preference (home.css): requests along the wires,
// the vans round the road, the leader's heartbeats, and every eight seconds a stampede of reads
// that hits the cache at once, which coalescing answers with one fetch from the database; those
// run once the motion module has marked the page (scripts/motion.js), and the top bar's button
// pauses them (SC 2.2.2). As the page scrolls up, the parts lift off the plane into an exploded
// view, leaving their footprints behind. Under a reduced-motion preference it is a still drawing,
// assembled, with the requests where they stand.
const parts = model.parts.map((part) => ({ ...part, link: labs[part.lab] }));
---

<figure class="iso" data-iso>
  <svg
    class="iso-svg"
    viewBox={`0 0 ${model.width} ${model.height}`}
    role="group"
    aria-labelledby="iso-caption"
  >
    <g class="iso-ground" aria-hidden="true">
      <path class="iso-plane" d={model.plane} />
      <path class="iso-grid" d={model.lattice} />
      <path class="iso-inlet" d={model.inlets} />
      {model.sources.map((source) => (
        <text class="iso-source" x={source.x} y={source.y} text-anchor="end">
          {source.words}
        </text>
      ))}
      <path class="iso-road" d={model.road} />
      {model.wires.map((wire) => (
        <path
          class={wire.nightly ? 'iso-wire iso-wire-nightly' : 'iso-wire'}
          data-line={wire.lab}
          d={wire.d}
        />
      ))}
      {model.wires
        .filter((wire) => wire.flow)
        .map((wire) => (
          <path class="iso-flow" data-line={wire.lab} d={wire.d} />
        ))}
      <path class="iso-vans" d={model.road} pathLength="100" stroke-dasharray={model.vans} />
      {model.burst.map((d) => (
        <path class="iso-burst" d={d} />
      ))}
      <path class="iso-pulse iso-fetch" d={model.fetch} pathLength="100" />
      {model.heartbeats.map((d) => (
        <path class="iso-pulse iso-beat" d={d} pathLength="100" />
      ))}
      <path class="iso-pulse iso-night" d={model.nightly} pathLength="100" />
      {parts.flatMap((part) =>
        part.solids.map((s) => <path class="iso-footprint" data-line={part.lab} d={s.footprint} />),
      )}
    </g>
    {parts.map((part) => {
      const Tag = part.link ? 'a' : 'g';
      return (
        <Tag class="iso-node" data-line={part.lab} href={part.link?.href}>
          <g class={`iso-lift iso-lift-${part.lab}`}>
            {part.solids.map((s) => (
              <path class="iso-drop" d={s.drop} />
            ))}
            {part.solids.map((s) => (
              <g class={s.role ? `iso-solid iso-${s.role}` : 'iso-solid'}>
                {s.kind === 'box' ? (
                  <>
                    <path class="iso-face-left" d={s.left} />
                    <path class="iso-face-right" d={s.right} />
                    <path class="iso-face-top" d={s.top} />
                  </>
                ) : (
                  <>
                    <path class="iso-face-left" d={s.left} />
                    <path class="iso-band" d={s.bands} />
                    <path class="iso-face-top" d={s.top} />
                  </>
                )}
              </g>
            ))}
            <path class="iso-pointer" d={part.pointer} />
            <text
              class="iso-label"
              x={part.label.x}
              y={part.label.y}
              text-anchor={part.label.anchor}
            >
              <tspan class="iso-name">{part.name}</tspan>{' '}
              <tspan class="iso-caption" x={part.label.x} dy="1.35em">
                {part.caption}
              </tspan>
            </text>
          </g>
        </Tag>
      );
    })}
  </svg>
  <figcaption class="iso-key" id="iso-caption">
    The five labs as one system. Each part opens the lab that runs it.
  </figcaption>
</figure>
