# Response headers for every static asset (security.md, "Headers and Content Security Policy").
# The page policy is not here: the build writes it into dist/_headers, on this "/*" rule, with a
# hash for each inline script and style the pages hold (src/lib/csp.mjs, ADR 0018). It refuses
# to run if this rule already sends one. Strict-Transport-Security is the zone's alone and never
# appears here (ADR 0011).
# Vary tells a cache between here and the reader that a response compressed for one client is not
# the bytes for another; the asset server compresses by Accept-Encoding without saying so
# (delivery.md, "Config as code").
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Vary: Accept-Encoding

# RFC 9116, section 3: security.txt is served as text/plain with charset=utf-8. Production's asset
# server sends text types without a charset (wrangler dev adds one), so this rule sets it.
/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8

# llms.txt is built from the profile, whose location line holds a "·": without a charset a client
# may read its UTF-8 as another encoding, so it gets the same rule (content.md, "Files for crawlers").
/llms.txt
  Content-Type: text/plain; charset=utf-8

# Bundles named by content hash never change at their URL, so a year and immutable are safe.
# HTML keeps Cloudflare's default, so a promoted version is what the next page view gets. A bundle
# is a script, a stylesheet or a font a page loads, never a document or a worker, so the policies
# that only those obey are detached here: the page policy (the worker comes from the solver's
# folder, below), Permissions-Policy and Cross-Origin-Opener-Policy. On every page they cost about
# 570 B of header per bundle, which Lighthouse counts in a page's transfer (design-system.md).
/_astro/*
  ! Content-Security-Policy
  ! Permissions-Policy
  ! Cross-Origin-Opener-Policy
  Cache-Control: public, max-age=31536000, immutable

# The Route Lab's solver (ADR 0016): VROOM compiled to WebAssembly, run in a module Web Worker. A
# worker takes its policy from its own response, never from the page that starts it, and compiling
# WebAssembly needs 'wasm-unsafe-eval', the one place that keyword appears. The page's policy, which
# the build writes on "/*", has none, so this rule detaches it first ("!"): two policies would both
# be enforced, and the page's would refuse the compile. connect-src lets the glue fetch vroom.wasm
# beside it; nothing else is allowed. base-uri, form-action and frame-ancestors do not fall back to
# default-src, so they are named: a worker ignores them, and the 404 page a missing file here gets
# stays as unframeable as every other response. The folder is named for the solver's version and a
# hash of its code, so a year is safe.
/lab/routes/solver/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Cache-Control: public, max-age=31536000, immutable
