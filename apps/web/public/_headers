# Response headers for every static asset (security.md, "Headers and Content Security Policy").
# The page policy (default-src, script-src, style-src and the rest) is Astro's <meta> tag, built
# from astro.config.mjs. A <meta> policy cannot carry frame-ancestors, so this file sends it.
# Strict-Transport-Security is the zone's alone and never appears here (ADR 0011).
/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

# RFC 9116, section 3: security.txt is served as text/plain with charset=utf-8. Production's asset
# server sends text types without a charset (wrangler dev adds one), so this rule sets it.
/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8

# llms.txt is built from the profile, whose location line holds a "·": without a charset a client
# may read its UTF-8 as another encoding, so it gets the same rule (content.md, "Files for crawlers").
/llms.txt
  Content-Type: text/plain; charset=utf-8

# Bundles named by content hash never change at their URL, so a year and immutable are safe.
# HTML keeps Cloudflare's default, so a promoted version is what the next page view gets.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The Route Lab's solver (ADR 0016): VROOM compiled to WebAssembly, run in a module Web Worker. A
# worker takes its policy from its own response, never from the page that starts it, and compiling
# WebAssembly needs 'wasm-unsafe-eval', so this is the one rule on the site that sends a script-src,
# and the one place that keyword appears. The page itself keeps Astro's policy, which has no
# 'wasm-unsafe-eval'. connect-src lets the glue fetch vroom.wasm beside it; nothing else is allowed.
# The folder is named for the solver's version and a hash of its code, so a year is safe.
/lab/routes/solver/*
  Content-Security-Policy: default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self'
  Cache-Control: public, max-age=31536000, immutable
